<file path="lib/requisicoesStore.ts">
"use client";



import {

  requisicoesTecnicasMock,

  RequisicaoTecnica,

} from "@/lib/requisicoesTecnicas";



import { gerarRetornoDaRequisicao } from "@/lib/retornosStore";
import { registrarAceiteEstoqueTecnico } from "@/lib/estoqueTecnicoStore";



/* =========================================================

   STATUS DA REQUISIÇÃO

========================================================= */



export type StatusRequisicao =

  | "PENDENTE"

  | "EM_SEPARACAO"

  | "SEPARADA"

  | "EM_CONFERENCIA"

  | "CONFERIDA"

  | "EMBARCADA"

  | "EM_TRANSITO"

  | "ACEITE_PENDENTE"

  | "RECEBIDA_TECNICO"

  | "RECUSA_PARCIAL"

  | "RECUSA_TOTAL";



/* =========================================================

   SEPARAÇÃO

========================================================= */



export type ItemSeparacao = {

  itemId: number;

  quantidadeSeparada: number;

  seriais: string[];

};



/* =========================================================

   CONFERÊNCIA

========================================================= */



export type ItemConferencia = {

  itemId: number;

  quantidadeConferida: number;

  seriais: string[];

};



/* =========================================================

   VOLUMES

========================================================= */



export type StatusVolume =

  | "ABERTO"

  | "FECHADO"

  | "EMBARCADO"

  | "EM_TRANSITO"

  | "RECEBIDO";



export type ItemVolume = {

  itemId: number;

  quantidade: number;

  seriais: string[];

};



export type VolumeRequisicao = {

  id: number;



  codigo: string;



  status: StatusVolume;



  itens: Record<number, ItemVolume>;



  criadoEm: string;



  fechadoEm?: string;



  embarcadoEm?: string;



  recebidoEm?: string;

};



export type TipoDivergenciaRecebimento = "FALTANTE" | "QUANTIDADE_DIVERGENTE" | "AVARIADO" | "PRODUTO_ERRADO" | "SERIAL_DIVERGENTE";

export type SituacaoItemRecebimento = "OK" | "DIVERGENCIA";

export type DecisaoRecebimento = "ACEITE_TOTAL" | "ACEITE_PARCIAL" | "RECUSA_ITEM" | "RECUSA_VOLUME";

export type ConferenciaItemRecebimento = { volumeId:number; itemId:number; situacao:SituacaoItemRecebimento; decisao:DecisaoRecebimento; quantidadeEsperada:number; quantidadeRecebida:number; quantidadeAceita:number; quantidadeRecusada:number; tipoDivergencia?:TipoDivergenciaRecebimento; observacao?:string; seriaisEsperados:string[]; seriaisRecebidos:string[]; seriaisAceitos:string[]; seriaisRecusados:string[]; conferidoEm:string; };



/* =========================================================

   ESTADO COMPLETO DA REQUISIÇÃO

========================================================= */



export type EstadoRequisicao = {

  requisicaoId: number;



  status: StatusRequisicao;



  itens: Record<number, ItemSeparacao>;



  conferencia: Record<number, ItemConferencia>;



  volumes: VolumeRequisicao[];



  iniciadoEm?: string;



  separadoEm?: string;



  conferenciaIniciadaEm?: string;



  conferidoEm?: string;



  embarcadoEm?: string;



  transitoEm?: string;



  recebidoTecnicoEm?: string;

  recebimentoTecnico?: {

    iniciadoEm?: string;

    finalizadoEm?: string;

    volumesLidos: Record<number, string>;

    itensConferidos: Record<string, ConferenciaItemRecebimento>;

  };

};



/* =========================================================

   STORAGE

========================================================= */



const STORAGE_KEY =

  "wms-expert-requisicoes";



const EVENTO_ATUALIZACAO =

  "wms-requisicoes-update";



/* =========================================================

   HELPERS

========================================================= */



function podeUsarStorage() {

  return typeof window !== "undefined";

}



function criarEstadoInicial(

  requisicao: RequisicaoTecnica

): EstadoRequisicao {

  return {

    requisicaoId: requisicao.id,



    status:

      (requisicao.status as StatusRequisicao) ||

      "PENDENTE",



    itens: {},



    conferencia: {},



    volumes: [],

  };

}



function normalizarEstado(

  estado: EstadoRequisicao

): EstadoRequisicao {

  return {

    ...estado,



    itens:

      estado.itens ?? {},



    conferencia:

      estado.conferencia ?? {},



    volumes:

      estado.volumes ?? [],

    recebimentoTecnico: {

      ...(estado.recebimentoTecnico ?? {}),

      volumesLidos: estado.recebimentoTecnico?.volumesLidos ?? {},
      itensConferidos: estado.recebimentoTecnico?.itensConferidos ?? {},

    },

  };

}



/* =========================================================

   CARREGAR ESTADOS

========================================================= */



export function carregarEstados(): Record<

  number,

  EstadoRequisicao

> {

  if (!podeUsarStorage()) {

    return {};

  }



  try {

    const valor =

      localStorage.getItem(

        STORAGE_KEY

      );



    if (!valor) {

      return {};

    }



    const dados =

      JSON.parse(valor) as Record<

        number,

        EstadoRequisicao

      >;



    const normalizados: Record<

      number,

      EstadoRequisicao

    > = {};



    Object.entries(dados).forEach(

      ([id, estado]) => {

        normalizados[

          Number(id)

        ] = normalizarEstado(

          estado

        );

      }

    );



    return normalizados;

  } catch (error) {

    console.error(

      "Erro ao carregar estado das requisições:",

      error

    );



    return {};

  }

}



/* =========================================================

   SALVAR ESTADOS

========================================================= */



function salvarEstados(

  estados: Record<

    number,

    EstadoRequisicao

  >

) {

  if (!podeUsarStorage()) {

    return;

  }



  localStorage.setItem(

    STORAGE_KEY,

    JSON.stringify(estados)

  );



  window.dispatchEvent(

    new CustomEvent(

      EVENTO_ATUALIZACAO

    )

  );

}



/* =========================================================

   OBTER ESTADO

========================================================= */



export function obterEstado(

  requisicao: RequisicaoTecnica

): EstadoRequisicao {

  const estados =

    carregarEstados();



  const estado =

    estados[requisicao.id];



  if (estado) {

    return normalizarEstado(

      estado

    );

  }



  return criarEstadoInicial(

    requisicao

  );

}



/* =========================================================

   SEPARAÇÃO

========================================================= */



export function iniciarSeparacao(

  requisicao: RequisicaoTecnica

) {

  const estados =

    carregarEstados();



  const atual =

    estados[requisicao.id] ??

    criarEstadoInicial(

      requisicao

    );



  /*

   * Não deixa uma requisição já avançada

   * voltar para EM_SEPARACAO.

   */

  if (

    [

      "SEPARADA",

      "EM_CONFERENCIA",

      "CONFERIDA",

      "EMBARCADA",

      "EM_TRANSITO",

      "ACEITE_PENDENTE",

      "RECEBIDA_TECNICO",

    ].includes(atual.status)

  ) {

    return normalizarEstado(

      atual

    );

  }



  const novo: EstadoRequisicao =

    {

      ...normalizarEstado(

        atual

      ),



      status:

        "EM_SEPARACAO",



      iniciadoEm:

        atual.iniciadoEm ??

        new Date().toISOString(),

    };



  estados[requisicao.id] =

    novo;



  salvarEstados(estados);



  return novo;

}



/* =========================================================

   REGISTRAR ITEM DA SEPARAÇÃO

========================================================= */



export function registrarSeparacaoItem(

  requisicao: RequisicaoTecnica,

  itemId: number,

  quantidade: number,

  seriais: string[] = []

) {

  const estados =

    carregarEstados();



  const atual =

    normalizarEstado(

      estados[

        requisicao.id

      ] ??

        criarEstadoInicial(

          requisicao

        )

    );



  atual.itens[itemId] = {

    itemId,



    quantidadeSeparada:

      quantidade,



    seriais: [

      ...seriais,

    ],

  };



  if (

    atual.status ===

      "PENDENTE" ||

    atual.status ===

      "EM_SEPARACAO"

  ) {

    atual.status =

      "EM_SEPARACAO";

  }



  atual.iniciadoEm =

    atual.iniciadoEm ??

    new Date().toISOString();



  estados[requisicao.id] =

    atual;



  salvarEstados(estados);



  return atual;

}



/* =========================================================

   ITEM ESTÁ SEPARADO?

========================================================= */



export function itemEstaSeparado(

  requisicao: RequisicaoTecnica,

  itemId: number

) {

  const estado =

    obterEstado(requisicao);



  const original =

    requisicao.itens.find(

      (item) =>

        item.id === itemId

    );



  const separado =

    estado.itens[itemId];



  if (

    !original ||

    !separado

  ) {

    return false;

  }



  return (

    separado.quantidadeSeparada >=

    original.solicitado

  );

}



/* =========================================================

   TODOS SEPARADOS?

========================================================= */



export function todosItensSeparados(

  requisicao: RequisicaoTecnica

) {

  return requisicao.itens.every(

    (item) =>

      itemEstaSeparado(

        requisicao,

        item.id

      )

  );

}



/* =========================================================

   FINALIZAR SEPARAÇÃO

========================================================= */



export function finalizarSeparacao(

  requisicao: RequisicaoTecnica

) {

  if (

    !todosItensSeparados(

      requisicao

    )

  ) {

    throw new Error(

      "Todos os itens precisam estar separados antes da finalização."

    );

  }



  const estados =

    carregarEstados();



  const atual =

    normalizarEstado(

      estados[

        requisicao.id

      ] ??

        criarEstadoInicial(

          requisicao

        )

    );



  atual.status =

    "SEPARADA";



  atual.separadoEm =

    atual.separadoEm ??

    new Date().toISOString();



  estados[requisicao.id] =

    atual;



  salvarEstados(estados);



  return atual;

}



/* =========================================================

   CONFERÊNCIA

========================================================= */



export function iniciarConferencia(

  requisicao: RequisicaoTecnica

) {

  const estados =

    carregarEstados();



  const atual =

    normalizarEstado(

      estados[

        requisicao.id

      ] ??

        criarEstadoInicial(

          requisicao

        )

    );



  if (

    [

      "CONFERIDA",

      "EMBARCADA",

      "EM_TRANSITO",

      "ACEITE_PENDENTE",

      "RECEBIDA_TECNICO",

    ].includes(atual.status)

  ) {

    return atual;

  }



  if (

    atual.status !==

      "SEPARADA" &&

    atual.status !==

      "EM_CONFERENCIA"

  ) {

    throw new Error(

      "A requisição precisa estar separada antes de iniciar a conferência."

    );

  }



  atual.status =

    "EM_CONFERENCIA";



  atual.conferenciaIniciadaEm =

    atual.conferenciaIniciadaEm ??

    new Date().toISOString();



  estados[requisicao.id] =

    atual;



  salvarEstados(estados);



  return atual;

}



/* =========================================================

   REGISTRAR ITEM DA CONFERÊNCIA

========================================================= */



export function registrarConferenciaItem(

  requisicao: RequisicaoTecnica,

  itemId: number,

  quantidade: number,

  seriais: string[] = []

) {

  const estados =

    carregarEstados();



  const atual =

    normalizarEstado(

      estados[

        requisicao.id

      ] ??

        criarEstadoInicial(

          requisicao

        )

    );



  const separado =

    atual.itens[itemId];



  if (!separado) {

    throw new Error(

      "O produto não possui separação registrada."

    );

  }



  if (

    quantidade >

    separado.quantidadeSeparada

  ) {

    throw new Error(

      "A quantidade conferida não pode ser maior que a quantidade separada."

    );

  }



  atual.conferencia[

    itemId

  ] = {

    itemId,



    quantidadeConferida:

      quantidade,



    seriais: [

      ...seriais,

    ],

  };



  if (

    atual.status ===

      "SEPARADA" ||

    atual.status ===

      "EM_CONFERENCIA"

  ) {

    atual.status =

      "EM_CONFERENCIA";

  }



  atual.conferenciaIniciadaEm =

    atual.conferenciaIniciadaEm ??

    new Date().toISOString();



  estados[requisicao.id] =

    atual;



  salvarEstados(estados);



  return atual;

}



/* =========================================================

   ITEM ESTÁ CONFERIDO?

========================================================= */



export function itemEstaConferido(

  requisicao: RequisicaoTecnica,

  itemId: number

) {

  const estado =

    obterEstado(requisicao);



  const separado =

    estado.itens[itemId];



  const conferido =

    estado.conferencia[

      itemId

    ];



  if (

    !separado ||

    !conferido

  ) {

    return false;

  }



  return (

    conferido.quantidadeConferida >=

    separado.quantidadeSeparada

  );

}



/* =========================================================

   TODOS CONFERIDOS?

========================================================= */



export function todosItensConferidos(

  requisicao: RequisicaoTecnica

) {

  return requisicao.itens.every(

    (item) =>

      itemEstaConferido(

        requisicao,

        item.id

      )

  );

}



/* =========================================================

   VOLUME - HELPERS

========================================================= */



function numeroRequisicao(

  requisicao: RequisicaoTecnica

) {

  return requisicao.codigo.replace(

    /^REQ-/i,

    ""

  );

}



function gerarCodigoVolume(

  requisicao: RequisicaoTecnica,

  sequencia: number

) {

  return `VOL-${numeroRequisicao(

    requisicao

  )}-${String(

    sequencia

  ).padStart(3, "0")}`;

}



function proximoIdVolume(

  estado: EstadoRequisicao

) {

  if (

    estado.volumes.length ===

    0

  ) {

    return 1;

  }



  return (

    Math.max(

      ...estado.volumes.map(

        (volume) =>

          volume.id

      )

    ) + 1

  );

}



