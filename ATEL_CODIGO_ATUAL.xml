        .ret-table thead {
          background: #edf2f5;
        }

        .ret-table th {
          padding: 10px 8px;

          border-top: 1px solid #dce4e8;
          border-bottom: 1px solid #dce4e8;

          color: #596773;

          font-size: 8px;
          font-weight: 900;

          text-align: left;
          white-space: nowrap;
