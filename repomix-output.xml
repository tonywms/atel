"use client";

import React, { useEffect, useMemo, useState } from "react";
import { useRouter } from "next/navigation";
import {
  carregarEstoqueTecnico,
  devolverEstoqueTecnicoAoCD,
  ouvirEstoqueTecnico,
  type EstoqueTecnico,
} from "@/lib/estoqueTecnicoStore";

export default function Page() {
  const router = useRouter();
  const [estoque, setEstoque] = useState<EstoqueTecnico[]>([]);
  const [busca, setBusca] = useState("");
  const [selecionado, setSelecionado] = useState<EstoqueTecnico | null>(null);
  const [quantidade, setQuantidade] = useState("1");
  const [seriais, setSeriais] = useState<string[]>([]);
  const [motivo, setMotivo] = useState("DEVOLUÇÃO DO TÉCNICO");
  const [observacao, setObservacao] = useState("");
  const [mensagem, setMensagem] = useState("");
  const [confirmando, setConfirmando] = useState(false);

  function carregar() {
    setEstoque(carregarEstoqueTecnico());
  }

  useEffect(() => {
    carregar();
    return ouvirEstoqueTecnico(carregar);
  }, []);

  const grupos = useMemo(() => {
    const termo = busca.trim().toLowerCase();
    const mapa = new Map<string, EstoqueTecnico[]>();

    estoque
      .filter((item) => item.quantidade > 0)
      .filter((item) => {
        if (!termo) return true;
        return [
          item.tecnico,
          item.codigoTecnico,
          item.base,
          item.codigoProduto,
          item.produto,
          ...item.seriais,
        ].some((valor) => valor.toLowerCase().includes(termo));
      })
      .forEach((item) => {
        mapa.set(item.codigoTecnico, [...(mapa.get(item.codigoTecnico) ?? []), item]);
      });

    return [...mapa.entries()];
  }, [estoque, busca]);

  const saldoTotal = estoque.reduce((total, item) => total + item.quantidade, 0);

  function abrirDevolucao(item: EstoqueTecnico) {
    setSelecionado(item);
    setQuantidade(item.seriais.length > 0 ? "1" : "1");
    setSeriais([]);
    setMotivo("DEVOLUÇÃO DO TÉCNICO");
    setObservacao("");
    setMensagem("");
    setConfirmando(false);
  }

  function alternarSerial(serial: string) {
    if (!selecionado) return;
    const atual = seriais.includes(serial);
    const novaLista = atual
      ? seriais.filter((item) => item !== serial)
      : [...seriais, serial];
    setSeriais(novaLista);
    setQuantidade(String(novaLista.length));
  }

  function prepararDevolucao() {
    if (!selecionado) return;
    const qtd = Number(quantidade);
    if (!Number.isFinite(qtd) || qtd <= 0) {
      setMensagem("Informe uma quantidade válida.");
      return;
    }
    if (qtd > selecionado.quantidade) {
      setMensagem("Quantidade maior que o saldo disponível.");
      return;
    }
    if (selecionado.seriais.length > 0 && seriais.length !== qtd) {
      setMensagem(`Selecione ${qtd} serial(is).`);
      return;
    }
    setMensagem("");
    setConfirmando(true);
  }

  function confirmarDevolucao() {
    if (!selecionado) return;
    try {
      const resultado = devolverEstoqueTecnicoAoCD({
        codigoTecnico: selecionado.codigoTecnico,
        codigoProduto: selecionado.codigoProduto,
        quantidade: Number(quantidade),
        seriais,
        motivo,
        observacao,
      });
      setConfirmando(false);
      setSelecionado(null);
      carregar();
      setMensagem(`${resultado.documento} enviado ao CD. Retorno ${resultado.retorno.codigo} criado.`);
    } catch (error) {
      setConfirmando(false);
      setMensagem(error instanceof Error ? error.message : "Não foi possível gerar a devolução.");
    }
  }

  return (
    <div className="collector-screen">
      <div className="collector-phone">
        <div style={{ height: 40, background: "#000", flex: "0 0 auto" }} />
        <div className="collector-header">
          <div className="collector-header-title">
            <button type="button" className="collector-back-button" onClick={() => router.push("/coletor/consulta")}>‹</button>
            <strong>Estoque Técnico</strong>
          </div>
        </div>
        <div className="collector-search-area">
          <div className="collector-search-box"><span>⌕</span><input value={busca} onChange={(e) => setBusca(e.target.value)} placeholder="Técnico, produto ou serial..." /></div>
        </div>
        {mensagem && !selecionado && <div style={{margin:"0 14px 8px",padding:"9px 11px",borderRadius:8,background:"#e6f5fb",color:"#076a91",fontSize:11,fontWeight:700}}>{mensagem}</div>}
        <div className="collector-request-list" style={{overflowY:"auto",flex:1,paddingBottom:12}}>
          {grupos.flatMap(([codigoTecnico, itens]) => itens.map((item, index) => (
            <div key={item.id} className="collector-request-card" style={{borderColor:"#1597bd",minHeight:190}}>
              <div className="collector-card-strip" style={{background:"#1597bd"}} />
              <div className="collector-card-content">
                <div className="collector-card-header"><strong>{item.codigoProduto}</strong><strong>{item.quantidade} {item.unidade}</strong></div>
                <div className="collector-technician">{item.produto}</div>
                <div className="collector-card-row"><span>Técnico: </span>{codigoTecnico} - {itens[0].tecnico}</div>
                <div className="collector-card-row"><span>Base: </span>{itens[0].base}</div>
                {item.seriais.length > 0 && <div className="collector-card-row"><span>Serial: </span>{item.seriais.join(" • ")}</div>}
                <div className="collector-card-footer">
                  <button type="button" onClick={() => abrirDevolucao(item)} style={{height:34,padding:"0 13px",border:"1px solid #1687b0",borderRadius:6,background:"#fff",color:"#087fab",fontSize:10,fontWeight:800}}>DEVOLVER AO CD</button>
                  <span className="collector-arrow">›</span>
                </div>
              </div>
            </div>
          )))}
          {!grupos.length && <div style={{padding:35,textAlign:"center",color:"#819098"}}>Nenhum estoque móvel encontrado.</div>}
        </div>
        <div className="collector-bottom-info" style={{marginTop:0,padding:8}}>{grupos.length} técnicos • saldo total {saldoTotal}</div>
        <div style={{ height: 36, background: "#000", flex: "0 0 auto" }} />
      {selecionado && (
        <div style={S.overlay}>
          <div style={S.modal}>
            <div style={S.modalTitle}>Devolução ao CD</div>
            <div style={S.infoBand}>
              {selecionado.codigoTecnico} • {selecionado.tecnico}<br />
              {selecionado.codigoProduto} • {selecionado.produto}
            </div>

            <div style={S.balance}>SALDO DISPONÍVEL <strong>{selecionado.quantidade} {selecionado.unidade}</strong></div>

            {selecionado.seriais.length === 0 ? (
              <label style={S.label}>QUANTIDADE
                <input
                  type="number"
                  min={1}
                  max={selecionado.quantidade}
                  value={quantidade}
                  onChange={(event) => setQuantidade(event.target.value)}
                  style={S.input}
                />
              </label>
            ) : (
              <div>
                <div style={S.label}>SERIAIS PARA DEVOLUÇÃO</div>
                {selecionado.seriais.map((serial) => (
                  <button
                    key={serial}
                    type="button"
                    onClick={() => alternarSerial(serial)}
                    style={{ ...S.serialButton, ...(seriais.includes(serial) ? S.serialSelected : {}) }}
                  >
                    <span>{seriais.includes(serial) ? "✓" : "○"}</span>
                    <strong>{serial}</strong>
                  </button>
                ))}
              </div>
            )}

            <label style={S.label}>MOTIVO
              <select value={motivo} onChange={(event) => setMotivo(event.target.value)} style={S.input}>
                <option>DEVOLUÇÃO DO TÉCNICO</option>
                <option>SOBRA DE MATERIAL</option>
                <option>TROCA DE TÉCNICO</option>
                <option>AVARIA</option>
                <option>OUTRO</option>
              </select>
            </label>

            <label style={S.label}>OBSERVAÇÃO
              <textarea value={observacao} onChange={(event) => setObservacao(event.target.value)} style={S.textarea} placeholder="Observação opcional" />
            </label>

            {mensagem && <div style={S.modalMessage}>{mensagem}</div>}

            <div style={S.actions}>
              <button type="button" style={S.cancel} onClick={() => setSelecionado(null)}>CANCELAR</button>
              <button type="button" style={S.confirm} onClick={prepararDevolucao}>GERAR DEVOLUÇÃO</button>
            </div>
          </div>
        </div>
      )}

      {selecionado && confirmando && (
        <div style={S.overlayTop}>
          <div style={S.confirmModal}>
            <div style={S.confirmIcon}>!</div>
            <div style={S.confirmTitle}>Confirmar Devolução</div>
            <p style={S.confirmText}>
              Confirma a saída de <b>{quantidade} {selecionado.unidade}</b> de <b>{selecionado.codigoProduto}</b> do estoque móvel de {selecionado.tecnico}?
            </p>
            <div style={S.warning}>O material ficará EM TRÂNSITO e só entrará no estoque do CD após a conferência do retorno.</div>
            <div style={S.actions}>
              <button type="button" style={S.cancel} onClick={() => setConfirmando(false)}>VOLTAR</button>
              <button type="button" style={S.confirm} onClick={confirmarDevolucao}>CONFIRMAR</button>
            </div>
          </div>
        </div>
      )}
      </div>
    </div>
  );
}

const S: Record<string, React.CSSProperties> = {
  phone: { width: "min(420px,100vw)", height: "100dvh", margin: "0 auto", background: "#eef2f4", display: "grid", gridTemplateRows: "40px 58px minmax(0,1fr) 36px", overflow: "hidden", position: "relative" },
  black: { background: "#050505" },
  header: { background: "#0796bc", color: "#fff", display: "flex", alignItems: "center", justifyContent: "space-between", padding: "0 12px", fontSize: 14 },
  back: { width: 34, height: 34, border: 0, background: "transparent", color: "#fff", fontSize: 30, cursor: "pointer" },
  content: { minHeight: 0, overflowY: "auto", padding: 12 },
  search: { width: "100%", height: 42, boxSizing: "border-box", border: "1px solid #c9d4da", borderRadius: 7, padding: "0 11px", background: "#fff" },
  summary: { display: "grid", gridTemplateColumns: "1fr 1fr", gap: 8, margin: "10px 0", fontSize: 9, color: "#72818a" },
  message: { padding: 10, marginBottom: 10, borderRadius: 7, background: "#e8f7ef", color: "#067647", fontSize: 10, fontWeight: 700 },
  card: { background: "#fff", border: "1px solid #d7e0e4", borderRadius: 9, marginBottom: 10, overflow: "hidden" },
  tech: { padding: 11, display: "flex", justifyContent: "space-between", background: "#f7f9fa", fontSize: 12 },
  block: { display: "block", marginTop: 2, fontSize: 9, color: "#72818a" },
  rowWrap: { borderTop: "1px solid #edf1f3", paddingBottom: 9 },
  row: { padding: 11, display: "grid", gridTemplateColumns: "1fr 65px", gap: 8, fontSize: 11 },
  serial: { display: "block", marginTop: 5, color: "#087da7", fontSize: 9, fontStyle: "normal", fontWeight: 700 },
  qty: { textAlign: "right", fontSize: 15 },
  returnButton: { width: "calc(100% - 22px)", minHeight: 34, margin: "0 11px", border: "1px solid #168bb2", borderRadius: 6, background: "#fff", color: "#087da7", fontSize: 9, fontWeight: 900, cursor: "pointer" },
  empty: { padding: 35, textAlign: "center", color: "#819098" },
  overlay: { position: "absolute", inset: 0, zIndex: 50, background: "rgba(0,0,0,.48)", display: "flex", alignItems: "flex-end" },
  overlayTop: { position: "absolute", inset: 0, zIndex: 80, background: "rgba(0,0,0,.58)", display: "flex", alignItems: "center", justifyContent: "center", padding: 18 },
  modal: { width: "100%", maxHeight: "82%", overflowY: "auto", background: "#fff", borderRadius: "18px 18px 0 0", padding: 16 },
  modalTitle: { color: "#087da7", fontSize: 16, fontWeight: 900, marginBottom: 10 },
  infoBand: { padding: 10, borderRadius: 7, background: "#edf8fc", color: "#087da7", fontSize: 10, fontWeight: 800, lineHeight: 1.5 },
  balance: { display: "flex", justifyContent: "space-between", margin: "12px 0", padding: 10, border: "1px solid #d8e2e8", borderRadius: 7, fontSize: 9, color: "#667085" },
  label: { display: "block", marginTop: 11, color: "#344054", fontSize: 9, fontWeight: 900 },
  input: { width: "100%", height: 40, boxSizing: "border-box", marginTop: 5, border: "1px solid #cbd5e1", borderRadius: 6, padding: "0 9px", background: "#fff" },
  textarea: { width: "100%", minHeight: 70, boxSizing: "border-box", marginTop: 5, border: "1px solid #cbd5e1", borderRadius: 6, padding: 9, resize: "vertical" },
  serialButton: { width: "100%", minHeight: 38, marginTop: 6, padding: "0 10px", display: "flex", alignItems: "center", gap: 8, border: "1px solid #d8e2e8", borderRadius: 6, background: "#fff", color: "#344054", cursor: "pointer" },
  serialSelected: { border: "1px solid #168bb2", background: "#edf8fc", color: "#087da7" },
