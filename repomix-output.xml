                                      menuWidth -
                                      gap
                                  );

                            const top =
                              Math.max(
                                12,
                                Math.min(
                                  rect.top,
                                  window.innerHeight -
                                    menuHeight -
                                    12
                                )
                              );

                            setMenuCardId(req.id);
                            setMenuCardPos({
                              top,
                              left,
                            });
