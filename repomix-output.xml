"use client";

import {
  useEffect,
  useMemo,
  useState,
  type CSSProperties,
} from "react";

import { useRouter } from "next/navigation";

import {
  carregarOrdensServico,
  ouvirOrdensServico,
  type OrdemServico,
} from "@/lib/ordensServicoStore";

/* =========================================================
   HELPERS
========================================================= */

function prioridadeOrdem(ordem: OrdemServico) {
  if (ordem.id === 2600002) return "ALTA";
  return "NORMAL";
}

function prioridadeClass(prioridade: string) {
  if (prioridade === "URGENTE") return "collector-priority urgent";
  if (prioridade === "ALTA") return "collector-priority high";
  return "collector-priority normal";
}

function tipoNome(tipo: string) {
  if (tipo === "INSTALACAO") return "INSTALAÇÃO";
  if (tipo === "MANUTENCAO") return "MANUTENÇÃO";
  if (tipo === "TROCA") return "TROCA";
  if (tipo === "RETIRADA") return "RETIRADA";
  return tipo;
}

function statusNome(status: string) {
  if (status === "PENDENTE") return "Pendente";
  if (status === "EM_ATENDIMENTO") return "Em Atendimento";
  if (status === "FINALIZADA") return "Finalizada";
  if (status === "CANCELADA") return "Cancelada";
  return status.replaceAll("_", " ");
}

function statusClass(status: string) {
  if (status === "PENDENTE") return "collector-status pending";
  return "collector-status separating";
}

/* =========================================================
   ESTILOS

   EXATAMENTE A MESMA ESTRUTURA DA TELA /coletor/separacao:
   - collector-screen
   - collector-phone
   - collector-header
   - collector-search-area
   - collector-request-list
   - collector-request-card
   - collector-card-strip
   - collector-card-content
   - collector-card-header
   - collector-technician
   - collector-card-row
   - collector-card-numbers
   - collector-card-footer
========================================================= */

const phoneStyle: CSSProperties = {
  height: "100%",
  minHeight: 0,
  display: "flex",
  flexDirection: "column",
  overflow: "hidden",
};

const headerStyle: CSSProperties = {
  flex: "0 0 auto",
};

const searchAreaStyle: CSSProperties = {
  flex: "0 0 auto",
};

const listStyle: CSSProperties = {
  flex: "1 1 auto",
  minHeight: 0,
  overflowY: "auto",
  overflowX: "hidden",
  WebkitOverflowScrolling: "touch",
  overscrollBehavior: "contain",
  paddingBottom: 24,
  scrollbarGutter: "stable",
};

const bottomInfoStyle: CSSProperties = {
  flex: "0 0 auto",
};

/* =========================================================
   COMPONENTE
========================================================= */

export default function OrdensServicoPage() {
  const router = useRouter();

  const [busca, setBusca] = useState("");
  const [ordens, setOrdens] = useState<OrdemServico[]>([]);

  /* =======================================================
     CARREGAR ORDENS
  ======================================================= */

  function carregar() {
    setOrdens(carregarOrdensServico());
  }

  useEffect(() => {
    carregar();
    return ouvirOrdensServico(carregar);
  }, []);

  /* =======================================================
     FILTRO
  ======================================================= */

  const filtradas = useMemo(() => {
    const termo = busca.trim().toLowerCase();

    const ativas = ordens.filter(
      (ordem) =>
        ordem.status === "PENDENTE" ||
        ordem.status === "EM_ATENDIMENTO"
    );

    if (!termo) return ativas;

    return ativas.filter((ordem) => {
      const campos = [
        ordem.codigo,
        ordem.cliente,
        ordem.codigoCliente,
        ordem.tecnico,
        ordem.codigoTecnico,
        ordem.base,
        ordem.tipo,
        ordem.status,
        ordem.cidade,
      ];

      return campos.some((campo) =>
        String(campo ?? "").toLowerCase().includes(termo)
      );
    });
  }, [ordens, busca]);

  /* =======================================================
     TOTAIS
  ======================================================= */

  function totalItens(ordem: OrdemServico) {
    return ordem.itens.reduce(
      (total, item) => total + item.quantidade,
      0
    );
  }

  /* =======================================================
     ABRIR ORDEM
  ======================================================= */

  function abrirOrdem(ordem: OrdemServico) {
    router.push(`/coletor/ordens-servico/${ordem.id}`);
  }

  /* =======================================================
     RENDER
  ======================================================= */

  return (
    <div className="collector-screen">
      <div
        className="collector-phone"
        style={phoneStyle}
      >
        {/* =================================================
            CABEÇALHO
        ================================================= */}

        <div
          className="collector-header"
          style={headerStyle}
        >
          <div className="collector-header-title">
            <button
              type="button"
              className="collector-back-button"
              onClick={() => router.push("/coletor/expedicoes")}
              aria-label="Voltar"
            >
              ‹
            </button>

            <strong>
              Ordens de Serviço
            </strong>
          </div>
        </div>

        {/* =================================================
            PESQUISA
        ================================================= */}

        <div
          className="collector-search-area"
          style={searchAreaStyle}
        >
          <div className="collector-search-box">
            <span>⌕</span>

            <input
              value={busca}
              onChange={(e) => setBusca(e.target.value)}
              placeholder="Parâmetro de busca"
            />
          </div>
        </div>

        {/* =================================================
            LISTA COM SCROLL
        ================================================= */}

        <div
          className="collector-request-list"
          style={listStyle}
        >
          {filtradas.length === 0 && (
            <div
              style={{
                padding: "32px 16px",
                textAlign: "center",
                color: "#7b8794",
                fontSize: 13,
                fontWeight: 600,
              }}
            >
              Nenhuma ordem de serviço encontrada.
            </div>
          )}

          {filtradas.map((ordem) => {
            const prioridade = prioridadeOrdem(ordem);

            return (
              <button
                type="button"
                key={ordem.id}
                className="collector-request-card"
                onClick={() => abrirOrdem(ordem)}
              >
                <div className="collector-card-strip" />

                <div className="collector-card-content">
                  {/* =========================================
                      CABEÇALHO DO CARD
                  ========================================= */}

                  <div className="collector-card-header">
                    <strong>
                      {ordem.codigo}
                    </strong>

                    <span
                      className={prioridadeClass(prioridade)}
                    >
                      {prioridade}
                    </span>
                  </div>

                  {/* =========================================
                      CLIENTE

                      Usa a MESMA classe que a separação usa
                      para o nome do técnico. Assim tamanho,
                      cor e espaçamento ficam idênticos.
                  ========================================= */}

                  <div className="collector-technician">
                    {ordem.cliente}
                  </div>

                  {/* =========================================
                      DADOS
                  ========================================= */}

                  <div className="collector-card-row">
                    <span>
                      Técnico:
                    </span>

                    <b>
                      {ordem.tecnico}
                    </b>
                  </div>

                  <div className="collector-card-row">
                    <span>
                      Código:
                    </span>

                    <b>
                      {ordem.codigoTecnico}
                    </b>
                  </div>

                  <div className="collector-card-row">
                    <span>
                      Base:
                    </span>

                    <b>
                      {ordem.base}
                    </b>
                  </div>

                  <div className="collector-card-row">
                    <span>
                      Tipo:
                    </span>

                    <b>
                      {tipoNome(ordem.tipo)}
                    </b>
                  </div>

                  {/* =========================================
                      QUANTIDADES
                  ========================================= */}

                  <div className="collector-card-numbers">
                    <div>
                      <span>
                        Itens:
                      </span>

                      <strong>
                        {totalItens(ordem)}
                      </strong>
                    </div>

                    <div>
                      <span>
                        SKUs:
                      </span>

                      <strong>
                        {ordem.itens.length}
                      </strong>
                    </div>
                  </div>

                  {/* =========================================
                      STATUS
                  ========================================= */}

                  <div className="collector-card-footer">
                    <span
                      className={statusClass(ordem.status)}
                    >
                      {statusNome(ordem.status)}
                    </span>

                    <span className="collector-arrow">
                      ›
                    </span>
                  </div>
                </div>
              </button>
            );
          })}

          {/*
           * Mesma folga extra da tela de Separação para
           * o último card não ficar escondido no scroll.
           */}
          <div
            aria-hidden="true"
            style={{
              height: 12,
              flexShrink: 0,
            }}
          />
        </div>

        {/* =================================================
            RODAPÉ
        ================================================= */}

        <div
          className="collector-bottom-info"
          style={bottomInfoStyle}
        >
          {filtradas.length}{" "}
          {filtradas.length === 1
            ? "ordem disponível"
            : "ordens disponíveis"}
        </div>
      </div>
    </div>
  );
}
