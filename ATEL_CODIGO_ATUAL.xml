              className="collector-back-button"
              onClick={() =>
                router.push("/coletor/expedicoes")
              }
              aria-label="Voltar"
            ><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.3" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg></button>

            <strong>
              Ordens de Serviço
            </strong>
          </div>
        </div>

        {/* =================================================
            PESQUISA
        ================================================= */}

        <div
          className="collector-search-area"
          style={searchAreaStyle}
        >
          <div style={searchBoxStyle}>
            <span style={searchIconStyle}><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg></span>

            <input
              value={busca}
              onChange={(event) =>
                setBusca(event.target.value)
              }
              placeholder="Buscar OS, cliente ou técnico"
              style={searchInputStyle}
            />
          </div>
        </div>

        {/* =================================================
            LISTA
        ================================================= */}

        <div
          className="collector-request-list"
          style={listStyle}
        >
          {filtradas.length === 0 && (
            <div style={emptyStyle}>
              Nenhuma ordem de serviço encontrada.
            </div>
          )}

          {filtradas.map((ordem) => {
            const prioridade =
              prioridadeOrdem(ordem);

            const itens =
              totalItens(ordem);

            const skus =
              totalSkus(ordem);

            const previstos =
              totalPrevistos(ordem);

            return (
              <button
                type="button"
                key={ordem.id}
                onClick={() =>
                  abrirOrdem(ordem)
                }
                style={cardStyle}
              >
                <div style={cardInnerStyle}>
                  {/* =======================================
                      OS + PRIORIDADE
                  ======================================= */}

                  <div style={cardTopStyle}>
                    <div style={ordemAreaStyle}>
                      <div style={miniLabelStyle}>
                        ORDEM DE SERVIÇO
                      </div>

                      <strong style={codigoStyle}>
                        {ordem.codigo}
                      </strong>
                    </div>

                    <span
                      style={prioridadeStyle(
                        prioridade
                      )}
                    >
                      {prioridade}
                    </span>
                  </div>

                  {/* =======================================
                      CLIENTE
                  ======================================= */}

                  <div style={clienteStyle}>
                    {ordem.cliente}
                  </div>

                  <div
                    style={codigoClienteTipoStyle}
                  >
                    <span>
                      {ordem.codigoCliente}
                    </span>

                    <span style={separatorStyle}>
                      •
                    </span>

                    <span>
                      {tipoNome(ordem.tipo)}
                    </span>
                  </div>

                  <div style={dividerStyle} />

                  {/* =======================================
                      TÉCNICO / BASE
                  ======================================= */}

                  <div style={infoGridStyle}>
                    <div style={infoItemStyle}>
                      <span style={infoLabelStyle}>
                        TÉCNICO
                      </span>

                      <span style={infoValueStyle}>
                        {ordem.tecnico}
                      </span>
                    </div>

                    <div style={infoItemStyle}>
                      <span style={infoLabelStyle}>
                        CÓDIGO
                      </span>

                      <span style={infoValueStyle}>
                        {ordem.codigoTecnico}
                      </span>
                    </div>

                    <div style={infoItemStyle}>
                      <span style={infoLabelStyle}>
                        BASE
                      </span>

                      <span style={infoValueStyle}>
                        {ordem.base}
                      </span>
                    </div>

                    <div style={infoItemStyle}>
                      <span style={infoLabelStyle}>
                        CIDADE
                      </span>

                      <span style={infoValueStyle}>
                        {ordem.cidade}
                      </span>
                    </div>
                  </div>

                  {/* =======================================
                      STATUS / QUANTIDADES
                  ======================================= */}

                  <div style={cardFooterStyle}>
                    <div style={footerLeftStyle}>
                      <span
                        style={statusStyle(
                          ordem.status
                        )}
                      >
                        <span
                          style={statusDotStyle}
                        />

                        {statusNome(
                          ordem.status
                        )}
                      </span>
                    </div>

                    <div
                      style={{
                        display: "flex",
                        alignItems: "center",
                        gap: 7,
                      }}
                    >
                      <div style={countersStyle}>
                        {itens > 0 ? (
                          <>
                            <span>
                              ITENS{" "}
                              <strong
                                style={
                                  counterStrongStyle
                                }
                              >
                                {itens}
                              </strong>
                            </span>

                            <span>
                              •
                            </span>
                          </>
                        ) : null}

                        <span>
                          SKUs{" "}
                          <strong
                            style={
                              counterStrongStyle
                            }
                          >
                            {skus}
                          </strong>
                        </span>

                        {previstos > 0 &&
                          ordem.itens.length === 0 && (
                            <>
                              <span>
                                •
                              </span>

                              <span
                                style={{
                                  color:
                                    "#087da7",
                                }}
                              >
                                PREVISTOS
                              </span>
                            </>
                          )}
                      </div>

                      <span style={arrowStyle}>
                        ›
                      </span>
                    </div>
                  </div>
                </div>
              </button>
            );
          })}

          <div
            aria-hidden="true"
            style={{
              height: 12,
              flexShrink: 0,
            }}
          />
        </div>

        {/* =================================================
            RODAPÉ
        ================================================= */}

        <div
          className="collector-bottom-info"
          style={bottomInfoStyle}
