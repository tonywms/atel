        }

        .ret-card-arrow {
          color: #008ec3;
          font-size: 22px;
          font-weight: 700;
        }

        /* ===================================================
           EMPTY DETAIL
        =================================================== */

        .ret-empty-detail {
          height: 100%;

          display: flex;
          flex-direction: column;
          align-items: center;
          justify-content: center;

          color: #667085;
        }

        .ret-empty-icon {
          margin-bottom: 8px;

          color: #1593b7;
          font-size: 35px;
        }

        .ret-empty-detail strong {
          color: #344054;
          font-size: 16px;
        }

        .ret-empty-detail span {
          margin-top: 4px;
          font-size: 11px;
        }

        /* ===================================================
           DETAIL HEADER
        =================================================== */

        .ret-detail-header {
          min-height: 88px;
          padding: 14px 16px;

          border-bottom: 1px solid #dce4e8;

          display: flex;
          align-items: flex-start;
          justify-content: space-between;
          gap: 20px;
        }

        .ret-detail-documents {
          display: flex;
          align-items: center;
          gap: 22px;
        }

        .ret-detail-main-document {
          display: flex;
          flex-direction: column;

          padding-right: 22px;
          border-right: 1px solid #dce4e8;
        }

        .ret-detail-main-document > span {
          color: #82909c;
          font-size: 8px;
          font-weight: 900;
          letter-spacing: 0.35px;
        }

        .ret-detail-main-document > strong {
          margin-top: 2px;

          color: #007cae;
          font-size: 21px;
          font-weight: 900;
        }

        .ret-detail-main-document > small {
          margin-top: 3px;

          color: #667085;
          font-size: 10px;
          font-weight: 700;
        }

        .ret-document-link {
          display: flex;
          align-items: center;
          gap: 9px;
        }

        .ret-document-link-arrow {
          color: #7a9eae;
          font-size: 23px;
          font-weight: 900;
        }

        .ret-document-link > div {
          display: flex;
          flex-direction: column;
        }

        .ret-document-link span:not(.ret-document-link-arrow) {
          color: #82909c;
          font-size: 8px;
          font-weight: 900;
          letter-spacing: 0.35px;
        }

        .ret-document-link strong {
          margin-top: 2px;

          color: #344054;
          font-size: 14px;
          font-weight: 900;
        }

        /* ===================================================
           INFO
        =================================================== */

        .ret-info-grid {
          display: grid;
          grid-template-columns: 2fr 1fr 2fr 2fr;
          gap: 12px;

          margin: 12px 16px;
          padding: 12px;

          background: #f5f8fa;
          border-radius: 7px;
        }

        /* ===================================================
           RELAÇÃO RET / REQ
        =================================================== */

        .ret-relation {
          margin: 0 16px 12px;
          padding: 9px 12px;

          border: 1px solid #c9e6f0;
          border-radius: 7px;

          background: #f1fbfe;

          display: flex;
          align-items: center;
          gap: 10px;
