"use client";

import React, { useEffect, useMemo, useState } from "react";
import { useRouter } from "next/navigation";

import {
  carregarEstoqueTecnico,
  devolverEstoqueTecnicoAoCD,
  ouvirEstoqueTecnico,
  type EstoqueTecnico,
} from "@/lib/estoqueTecnicoStore";

export default function Page() {
  const router = useRouter();

  const [estoque, setEstoque] = useState<EstoqueTecnico[]>([]);
  const [busca, setBusca] = useState("");
  const [selecionado, setSelecionado] =
    useState<EstoqueTecnico | null>(null);

  const [quantidade, setQuantidade] = useState("1");
  const [seriais, setSeriais] = useState<string[]>([]);
  const [motivo, setMotivo] = useState("DEVOLUÇÃO DO TÉCNICO");
  const [observacao, setObservacao] = useState("");
  const [mensagem, setMensagem] = useState("");
  const [confirmando, setConfirmando] = useState(false);

  function carregar() {
    setEstoque(carregarEstoqueTecnico());
  }

  useEffect(() => {
    carregar();

    return ouvirEstoqueTecnico(carregar);
  }, []);

  const grupos = useMemo(() => {
    const termo = busca.trim().toLowerCase();

    const mapa = new Map<string, EstoqueTecnico[]>();

    estoque
      .filter((item) => item.quantidade > 0)
      .filter((item) => {
        if (!termo) return true;

        return [
          item.tecnico,
          item.codigoTecnico,
          item.base,
          item.codigoProduto,
          item.produto,
          ...item.seriais,
        ].some((valor) =>
          valor.toLowerCase().includes(termo)
        );
      })
      .forEach((item) => {
        mapa.set(
          item.codigoTecnico,
          [
            ...(mapa.get(item.codigoTecnico) ?? []),
            item,
          ]
        );
      });

    return [...mapa.entries()];
  }, [estoque, busca]);

  const saldoTotal = estoque.reduce(
    (total, item) => total + item.quantidade,
    0
  );

  function abrirDevolucao(item: EstoqueTecnico) {
    setSelecionado(item);

    setQuantidade(
      item.seriais.length > 0
        ? "1"
        : "1"
    );

    setSeriais([]);
    setMotivo("DEVOLUÇÃO DO TÉCNICO");
    setObservacao("");
    setMensagem("");
    setConfirmando(false);
  }

  function alternarSerial(serial: string) {
    if (!selecionado) return;

    const atual =
      seriais.includes(serial);

    const novaLista =
      atual
        ? seriais.filter(
            (item) => item !== serial
          )
        : [...seriais, serial];

    setSeriais(novaLista);

    setQuantidade(
      String(novaLista.length)
    );
  }

  function prepararDevolucao() {
    if (!selecionado) return;

    const qtd =
      Number(quantidade);

    if (
      !Number.isFinite(qtd) ||
      qtd <= 0
    ) {
      setMensagem(
        "Informe uma quantidade válida."
      );

      return;
    }

    if (
      qtd >
      selecionado.quantidade
    ) {
      setMensagem(
        "Quantidade maior que o saldo disponível."
      );

      return;
    }

    if (
      selecionado.seriais.length > 0 &&
      seriais.length !== qtd
    ) {
      setMensagem(
        `Selecione ${qtd} serial(is).`
      );

      return;
    }

    setMensagem("");
    setConfirmando(true);
  }

  function confirmarDevolucao() {
    if (!selecionado) return;

    try {
      const resultado =
        devolverEstoqueTecnicoAoCD({
          codigoTecnico:
            selecionado.codigoTecnico,

          codigoProduto:
            selecionado.codigoProduto,

          quantidade:
            Number(quantidade),

          seriais,

          motivo,

          observacao,
        });

      setConfirmando(false);
      setSelecionado(null);

      carregar();

      setMensagem(
        `${resultado.documento} enviado ao CD. Retorno ${resultado.retorno.codigo} criado.`
      );
    } catch (error) {
      setConfirmando(false);

      setMensagem(
        error instanceof Error
          ? error.message
          : "Não foi possível gerar a devolução."
      );
    }
  }

  return (
    <div className="collector-screen">
      <div className="collector-phone">

        {/* ================================================
            BARRA SUPERIOR
        ================================================= */}

        <div
          style={{
            height: 40,
            background: "#000",
            flex: "0 0 auto",
          }}
        />

        {/* ================================================
            CABEÇALHO
        ================================================= */}

        <div className="collector-header">
          <div className="collector-header-title">

            <button
              type="button"
              className="collector-back-button"
              onClick={() =>
                router.push(
                  "/coletor/consulta"
                )
              }
            >
              ‹
            </button>

            <strong>
              Estoque Técnico
            </strong>

          </div>
        </div>

        {/* ================================================
            PESQUISA
        ================================================= */}

        <div className="collector-search-area">

          <div className="collector-search-box">

            <span>
              ⌕
            </span>

            <input
              value={busca}
              onChange={(e) =>
                setBusca(
                  e.target.value
                )
              }
              placeholder="Técnico, produto ou serial..."
            />

          </div>

        </div>

        {/* ================================================
            MENSAGEM
        ================================================= */}

        {mensagem && !selecionado && (
          <div
            style={{
              margin:
                "0 14px 8px",

              padding:
                "9px 11px",

              borderRadius: 8,

              background:
                "#e6f5fb",

              color:
                "#076a91",

              fontSize: 11,
              fontWeight: 700,
            }}
          >
            {mensagem}
          </div>
        )}

        {/* ================================================
            LISTA DE ESTOQUE
        ================================================= */}

        <div
          className="collector-request-list"
          style={{
            overflowY: "auto",
            flex: 1,
            paddingBottom: 12,
          }}
        >

          {grupos.flatMap(
            ([codigoTecnico, itens]) =>
              itens.map(
                (item) => (
                  <div
                    key={item.id}
                    className="collector-request-card"

                    style={{
                      minHeight: 190,

                      background:
                        "#ffffff",

                      /*
                       * BORDA PREMIUM
                       *
                       * O azul é a própria
                       * borda esquerda do card.
                       */
                      borderTop:
                        "1px solid #d9e5eb",

                      borderRight:
                        "1px solid #d9e5eb",

                      borderBottom:
                        "1px solid #d9e5eb",

                      borderLeft:
                        "7px solid #159fc5",

                      borderRadius: 16,

                      overflow:
                        "hidden",

                      boxShadow:
                        "0 3px 9px rgba(15, 23, 42, 0.055)",
                    }}
                  >

                    {/*
                      IMPORTANTE:

                      O antigo:

                      <div className="collector-card-strip" />

                      foi removido porque agora
                      o azul faz parte da borda
                      do próprio card.
                    */}

                    <div className="collector-card-content">

                      {/* ==================================
                          PRODUTO / QUANTIDADE
                      =================================== */}

                      <div className="collector-card-header">

                        <strong>
                          {item.codigoProduto}
                        </strong>

                        <strong>
                          {item.quantidade}{" "}
                          {item.unidade}
                        </strong>

                      </div>

                      {/* ==================================
                          DESCRIÇÃO
                      =================================== */}

                      <div className="collector-technician">
                        {item.produto}
                      </div>

                      {/* ==================================
                          TÉCNICO
                      =================================== */}

                      <div className="collector-card-row">

                        <span>
                          Técnico:{" "}
                        </span>

                        {codigoTecnico}
                        {" - "}
                        {itens[0].tecnico}

                      </div>

                      {/* ==================================
                          BASE
                      =================================== */}

                      <div className="collector-card-row">

                        <span>
                          Base:{" "}
                        </span>

                        {itens[0].base}

                      </div>

                      {/* ==================================
                          SERIAL
                      =================================== */}

                      {item.seriais.length > 0 && (

                        <div className="collector-card-row">

                          <span>
                            Serial:{" "}
                          </span>

                          {item.seriais.join(
                            " • "
                          )}

                        </div>

                      )}

                      {/* ==================================
                          RODAPÉ DO CARD
                      =================================== */}

                      <div className="collector-card-footer">

                        <button
                          type="button"

                          onClick={() =>
                            abrirDevolucao(
                              item
                            )
                          }

                          style={{
                            height: 34,

                            padding:
                              "0 13px",

                            border:
                              "1px solid #1687b0",

                            borderRadius:
                              6,

                            background:
                              "#fff",

                            color:
                              "#087fab",

                            fontSize: 10,
                            fontWeight: 800,

                            cursor:
                              "pointer",
                          }}
                        >
                          DEVOLVER AO CD
                        </button>

                        <span className="collector-arrow">
                          ›
                        </span>

                      </div>

                    </div>

                  </div>
                )
              )
          )}

          {/* ================================================
              SEM ESTOQUE
          ================================================= */}

          {!grupos.length && (

            <div
              style={{
                padding: 35,

                textAlign:
                  "center",

                color:
                  "#819098",
              }}
            >
              Nenhum estoque móvel encontrado.
            </div>

          )}

        </div>

        {/* ================================================
            RODAPÉ
        ================================================= */}

        <div
          className="collector-bottom-info"
          style={{
            marginTop: 0,
            padding: 8,
          }}
        >
          {grupos.length} técnicos
          {" • "}
          saldo total {saldoTotal}
        </div>

        <div
          style={{
            height: 36,
            background: "#000",
            flex: "0 0 auto",
          }}
        />

        {/* ================================================
            MODAL DEVOLUÇÃO
        ================================================= */}

        {selecionado && (

          <div style={S.overlay}>

            <div style={S.modal}>

              <div style={S.modalTitle}>
                Devolução ao CD
              </div>

              <div style={S.infoBand}>

                {selecionado.codigoTecnico}
                {" • "}
                {selecionado.tecnico}

                <br />

                {selecionado.codigoProduto}
                {" • "}
                {selecionado.produto}

              </div>

              {/* SALDO */}

              <div style={S.balance}>

                SALDO DISPONÍVEL

                <strong>
                  {selecionado.quantidade}{" "}
                  {selecionado.unidade}
                </strong>

              </div>

              {/* QUANTIDADE / SERIAIS */}

              {selecionado.seriais.length === 0 ? (

                <label style={S.label}>

                  QUANTIDADE

                  <input
                    type="number"
                    min={1}
                    max={
                      selecionado.quantidade
                    }
                    value={
                      quantidade
                    }
                    onChange={(
                      event
                    ) =>
                      setQuantidade(
                        event.target.value
                      )
                    }
                    style={S.input}
                  />

                </label>

              ) : (

                <div>

                  <div style={S.label}>
                    SERIAIS PARA DEVOLUÇÃO
                  </div>

                  {selecionado.seriais.map(
                    (serial) => (

                      <button
                        key={serial}
                        type="button"

                        onClick={() =>
                          alternarSerial(
                            serial
                          )
                        }

                        style={{
                          ...S.serialButton,

                          ...(seriais.includes(
                            serial
                          )
                            ? S.serialSelected
                            : {}),
                        }}
                      >

                        <span>
                          {seriais.includes(
                            serial
                          )
                            ? "✓"
                            : "○"}
                        </span>

                        <strong>
                          {serial}
                        </strong>

                      </button>

                    )
                  )}

                </div>

              )}

              {/* MOTIVO */}

              <label style={S.label}>

                MOTIVO

                <select
                  value={motivo}
                  onChange={(
                    event
                  ) =>
                    setMotivo(
                      event.target.value
                    )
                  }
                  style={S.input}
                >

                  <option>
                    DEVOLUÇÃO DO TÉCNICO
                  </option>

                  <option>
                    SOBRA DE MATERIAL
                  </option>

                  <option>
                    TROCA DE TÉCNICO
                  </option>

                  <option>
                    AVARIA
                  </option>

                  <option>
                    OUTRO
                  </option>

                </select>

              </label>

              {/* OBSERVAÇÃO */}

              <label style={S.label}>

                OBSERVAÇÃO

                <textarea
                  value={observacao}

                  onChange={(
                    event
                  ) =>
                    setObservacao(
                      event.target.value
                    )
                  }

                  style={
                    S.textarea
                  }

                  placeholder="Observação opcional"
                />

              </label>

              {/* ERRO */}

              {mensagem && (

                <div
                  style={
                    S.modalMessage
                  }
                >
                  {mensagem}
                </div>

              )}

              {/* AÇÕES */}

              <div style={S.actions}>

                <button
                  type="button"
                  style={S.cancel}

                  onClick={() =>
                    setSelecionado(
                      null
                    )
                  }
                >
                  CANCELAR
                </button>

                <button
                  type="button"
                  style={S.confirm}
                  onClick={
                    prepararDevolucao
                  }
                >
                  GERAR DEVOLUÇÃO
                </button>

              </div>

            </div>

          </div>

        )}

        {/* ================================================
            CONFIRMAÇÃO DA DEVOLUÇÃO
        ================================================= */}

        {selecionado && confirmando && (

          <div style={S.overlayTop}>

            <div style={S.confirmModal}>

              <div style={S.confirmIcon}>
                !
              </div>

              <div style={S.confirmTitle}>
                Confirmar Devolução
              </div>

              <p style={S.confirmText}>

                Confirma a saída de{" "}

                <b>
                  {quantidade}{" "}
                  {selecionado.unidade}
                </b>

                {" "}de{" "}

                <b>
                  {selecionado.codigoProduto}
                </b>

                {" "}do estoque móvel de{" "}

                {selecionado.tecnico}
                ?

              </p>

              <div style={S.warning}>

                O material ficará EM TRÂNSITO
                e só entrará no estoque do CD
                após a conferência do retorno.

              </div>

              <div style={S.actions}>

                <button
                  type="button"
                  style={S.cancel}

                  onClick={() =>
                    setConfirmando(
                      false
                    )
                  }
                >
                  VOLTAR
                </button>

                <button
                  type="button"
                  style={S.confirm}
                  onClick={
                    confirmarDevolucao
                  }
                >
                  CONFIRMAR
                </button>

              </div>

            </div>

          </div>

        )}

      </div>
    </div>
  );
}

