"use client";

import {
  useEffect,
  useMemo,
  useState,
} from "react";

import {
  useParams,
  useRouter,
} from "next/navigation";

import {
  requisicoesTecnicasMock,
} from "@/lib/requisicoesTecnicas";

import {
  finalizarEmbarque,
  iniciarEmbarque,
  obterEstado,
  registrarVolumeEmbarque,
  VolumeRequisicao,
} from "@/lib/requisicoesStore";

export default function EmbarqueDetalhePage() {
  const params =
    useParams();

  const router =
    useRouter();

  const idParam =
    params.id;

  const id =
    Number(
      Array.isArray(idParam)
        ? idParam[0]
        : idParam
    );

  const requisicao =
    useMemo(
      () =>
        requisicoesTecnicasMock.find(
          (req) =>
            req.id === id
        ),
      [id]
    );

  const [carregado, setCarregado] =
    useState(false);

  const [volumes, setVolumes] =
    useState<VolumeRequisicao[]>(
      []
    );

  const [codigoLido, setCodigoLido] =
    useState("");

  const [mensagem, setMensagem] =
    useState("");

  const [finalizando, setFinalizando] =
    useState(false);

  function atualizar() {
    if (!requisicao) {
      return;
    }

    const estado =
      obterEstado(
        requisicao
      );

    setVolumes(
      estado.volumes ?? []
    );
  }

  useEffect(() => {
    if (!requisicao) {
      setCarregado(true);
      return;
    }

    try {
      const estado =
        iniciarEmbarque(
          requisicao
        );

      setVolumes(
        estado.volumes ?? []
      );
    } catch (error) {
      setMensagem(
        error instanceof Error
          ? error.message
          : "Não foi possível iniciar o embarque."
      );
    } finally {
      setCarregado(true);
    }
  }, [requisicao]);

  if (!carregado) {
    return (
      <TelaMensagem
        texto="Carregando..."
      />
    );
  }

  if (!requisicao) {
    return (
      <TelaMensagem
        texto="Requisição não encontrada."
      />
    );
  }

  const volumesLidos =
    volumes.filter(
      (volume) =>
        volume.status ===
          "EMBARCADO" ||
        volume.status ===
          "EM_TRANSITO" ||
        volume.status ===
          "RECEBIDO"
    );

  const faltam =
    Math.max(
      volumes.length -
        volumesLidos.length,
      0
    );

  const todosLidos =
    volumes.length > 0 &&
    faltam === 0;

  function lerVolume() {
    const codigo =
      codigoLido
        .trim()
        .toUpperCase();

    if (!codigo) {
      setMensagem(
        "Leia ou informe o código do volume."
      );
      return;
    }

    try {
      const volume =
        registrarVolumeEmbarque(
          requisicao,
          codigo
        );

      atualizar();

      setCodigoLido("");

      setMensagem(
        `✓ ${volume.codigo} conferido para embarque.`
      );
    } catch (error) {
      setMensagem(
        error instanceof Error
          ? error.message
          : "Não foi possível registrar o volume."
      );
    }
  }

  function concluir() {
    try {
      setFinalizando(true);

      finalizarEmbarque(
        requisicao
      );

      setMensagem(
        "Embarque finalizado. Material em trânsito para o técnico."
      );

      window.setTimeout(
        () => {
          router.push(
            "/coletor/embarque"
          );
        },
        700
      );
    } catch (error) {
      setFinalizando(false);

      setMensagem(
        error instanceof Error
          ? error.message
          : "Não foi possível finalizar o embarque."
      );
    }
  }

  const primeiroPendente =
    volumes.find(
      (volume) =>
        volume.status ===
        "FECHADO"
    );

  return (
    <div className="collector-screen">
      <div
        className="collector-phone"
        style={{
          background: "#f4f4f4",
          overflow: "hidden",
        }}
      >
        <div
          style={{
            height: 40,
            background: "#000",
            flex: "0 0 auto",
          }}
        />

        <div
          style={{
            minHeight: 76,
            background: "#168bb2",
            color: "#fff",
            display: "flex",
            alignItems: "center",
            gap: 12,
            padding: "0 16px",
            flex: "0 0 auto",
          }}
        >
          <button
            type="button"
            onClick={() =>
              router.push(
                "/coletor/embarque"
              )
            }
            style={{
              border: 0,
              background:
                "transparent",
              color: "#fff",
              fontSize: 34,
              padding: 0,
              cursor: "pointer",
            }}
          >
            ‹
          </button>

          <div
            style={{
              flex: 1,
              lineHeight: 1,
            }}
          >
            <div
              style={{
                fontSize: 22,
                fontWeight: 900,
              }}
            >
              #
              {requisicao.codigo.replace(
                "REQ-",
                ""
              )}
            </div>

            <div
              style={{
                marginTop: 3,
                fontSize: 10,
                fontWeight: 800,
              }}
            >
              {requisicao.tecnico.toUpperCase()}
            </div>

            <div
              style={{
                marginTop: 2,
                fontSize: 9,
              }}
            >
              {requisicao.codigoTecnico} •{" "}
              {requisicao.base}
            </div>
          </div>

          <span
            style={{
              fontSize: 24,
            }}
          >
            ⋮
          </span>
        </div>

        <div
          style={{
            flex: 1,
            minHeight: 0,
            overflowY: "auto",
            overflowX: "hidden",
            padding:
              "12px 12px 120px",
          }}
        >
          <section
            style={cardStyle}
          >
            <div
              style={
                tituloStyle
              }
            >
              Embarque de Volumes

              <span
                style={
                  iconeStyle
                }
              >
                ▤
              </span>
            </div>

            <div
              style={{
                marginTop: 14,
                padding:
                  "10px 12px",
                borderRadius: 6,
                background:
                  "#e8f6fb",
                color: "#087da7",
                fontSize: 11,
                fontWeight: 800,
              }}
            >
              Conferência finalizada.
              Leia os volumes para
              liberar o transporte.
            </div>

            <div
              style={{
                display: "grid",
                gridTemplateColumns:
                  "repeat(3, 1fr)",
                gap: 8,
                marginTop: 12,
              }}
            >
              <Resumo
                titulo="ESPERADOS"
                valor={
                  volumes.length
                }
              />

              <Resumo
                titulo="LIDOS"
                valor={
                  volumesLidos.length
                }
              />

              <Resumo
                titulo="FALTAM"
                valor={faltam}
              />
            </div>
          </section>

          <section
            style={{
              ...cardStyle,
              marginTop: 12,
            }}
          >
            <div
              style={
                tituloStyle
              }
            >
              Destino

              <span
                style={
                  iconeStyle
                }
              >
                ↗
              </span>
            </div>

            <div
              style={{
                marginTop: 10,
                fontSize: 17,
                fontWeight: 900,
              }}
            >
              {requisicao.tecnico}
            </div>

            <div
              style={{
                marginTop: 3,
                color: "#087da7",
                fontSize: 12,
                fontWeight: 800,
              }}
            >
              {requisicao.codigoTecnico} •{" "}
              {requisicao.base}
            </div>

            <div
              style={{
                marginTop: 7,
                fontSize: 11,
                color: "#666",
              }}
            >
              Tipo:{" "}
              <strong>
                {requisicao.tipo}
              </strong>
            </div>
          </section>

          <section
            style={{
              ...cardStyle,
              marginTop: 12,
            }}
          >
            <div
              style={
                tituloStyle
              }
            >
              Leitura do Volume

              <span
                style={
                  iconeStyle
                }
              >
                ▣
              </span>
            </div>

            <div
              style={{
                display: "grid",
                gridTemplateColumns:
                  "1fr 84px",
                marginTop: 14,
                minHeight: 52,
                border:
                  "1px solid #168bb2",
                borderRadius: 6,
                overflow: "hidden",
              }}
            >
              <input
                value={
                  codigoLido
                }
                onChange={(e) =>
                  setCodigoLido(
                    e.target.value
                  )
                }
                onKeyDown={(e) => {
                  if (
                    e.key ===
                    "Enter"
                  ) {
                    lerVolume();
                  }
                }}
                placeholder="Leia o código do volume"
                autoComplete="off"
                style={{
                  minWidth: 0,
                  border: 0,
                  outline: 0,
                  padding:
                    "0 12px",
                  fontSize: 13,
                }}
              />

              <button
                type="button"
                onClick={lerVolume}
                style={{
                  border: 0,
                  background:
                    "#168bb2",
                  color: "#fff",
                  fontSize: 24,
                  cursor: "pointer",
                }}
              >
                ✓
              </button>
            </div>

            {primeiroPendente && (
              <button
                type="button"
                onClick={() =>
                  setCodigoLido(
                    primeiroPendente.codigo
                  )
                }
                style={{
                  marginTop: 7,
                  border: 0,
                  background:
                    "transparent",
                  padding: 0,
                  color: "#087da7",
                  fontSize: 10,
                  fontWeight: 800,
                  cursor: "pointer",
                }}
              >
                Simular leitura:{" "}
                {primeiroPendente.codigo}
              </button>
            )}
          </section>

          <section
            style={{
              ...cardStyle,
              marginTop: 12,
            }}
          >
            <div
              style={
                tituloStyle
              }
            >
              Volumes

              <span
                style={
                  iconeStyle
                }
              >
                ▦
              </span>
            </div>

            <div
              style={{
                marginTop: 12,
                display: "grid",
                gap: 8,
              }}
            >
              {volumes.map(
                (volume) => {
                  const lido =
                    volume.status ===
                      "EMBARCADO" ||
                    volume.status ===
                      "EM_TRANSITO" ||
                    volume.status ===
                      "RECEBIDO";

                  return (
                    <div
                      key={
                        volume.id
                      }
                      style={{
                        border:
                          lido
                            ? "1px solid #3aa879"
                            : "1px solid #cbd5df",
                        borderRadius: 7,
                        padding:
                          "11px 12px",
                        background:
                          lido
                            ? "#edf9f3"
                            : "#fff",
                        display:
                          "flex",
                        justifyContent:
                          "space-between",
                        alignItems:
                          "center",
                        gap: 10,
                      }}
                    >
                      <div>
                        <strong
                          style={{
                            display:
                              "block",
                            fontSize: 12,
                          }}
                        >
                          {
                            volume.codigo
                          }
                        </strong>

                        <span
                          style={{
                            display:
                              "block",
                            marginTop: 3,
                            color:
                              "#687685",
                            fontSize: 10,
                          }}
                        >
                          {
                            Object.keys(
                              volume.itens
                            ).length
                          }{" "}
                          SKU(s)
                        </span>
                      </div>

                      <span
                        style={{
                          borderRadius:
                            20,
                          padding:
                            "5px 8px",
                          background:
                            lido
                              ? "#d7f3e5"
                              : "#eef2f5",
                          color:
                            lido
                              ? "#087647"
                              : "#687685",
                          fontSize: 9,
                          fontWeight:
                            900,
                        }}
                      >
                        {lido
                          ? "✓ LIDO"
                          : "PENDENTE"}
                      </span>
                    </div>
                  );
                }
              )}
            </div>
          </section>

          {mensagem && (
            <div
              style={{
                marginTop: 12,
                padding:
                  "10px 12px",
                border:
                  "1px solid #9ed8eb",
                borderRadius: 6,
                background:
                  "#e9f7fc",
                color: "#087da7",
                fontSize: 11,
                fontWeight: 700,
              }}
            >
              {mensagem}
            </div>
          )}
        </div>

        <div
          style={{
            flex: "0 0 auto",
            padding:
              "10px 12px 12px",
            background: "#fff",
            borderTop:
              "1px solid #ddd",
          }}
        >
          <button
            type="button"
            disabled={
              !todosLidos ||
              finalizando
            }
            onClick={concluir}
            style={{
              width: "100%",
              minHeight: 50,
              border: 0,
              background:
                todosLidos
                  ? "#168bb2"
                  : "#9acddd",
              color: "#fff",
              fontSize: 14,
              fontWeight: 800,
              cursor:
                todosLidos
                  ? "pointer"
                  : "default",
            }}
          >
            {finalizando
              ? "FINALIZANDO..."
              : todosLidos
              ? "FINALIZAR EMBARQUE"
              : `AGUARDANDO ${faltam} VOLUME(S)`}
          </button>
        </div>

        <div
          style={{
            height: 36,
            background: "#000",
            flex: "0 0 auto",
          }}
        />
      </div>
    </div>
  );
}

function TelaMensagem({
  texto,
}: {
