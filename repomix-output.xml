"use client";

import { useEffect, useMemo, useState } from "react";
import { useRouter } from "next/navigation";
import {
  requisicoesTecnicasMock,
  RequisicaoTecnica,
} from "@/lib/requisicoesTecnicas";
import {
  carregarEstados,
  ouvirAlteracoes,
} from "@/lib/requisicoesStore";

function prioridadeClass(prioridade: string) {
  if (prioridade === "URGENTE") return "collector-priority urgent";
  if (prioridade === "ALTA") return "collector-priority high";
  return "collector-priority normal";
}

function statusNome(status: string) {
  if (status === "SEPARADA") return "Separado";
  if (status === "EM_CONFERENCIA") return "Executando";
  return status.replaceAll("_", " ");
}

export default function ConferenciaListaPage() {
  const router = useRouter();
  const [busca, setBusca] = useState("");
  const [requisicoes, setRequisicoes] =
    useState<RequisicaoTecnica[]>([]);

  function carregar() {
    const estados = carregarEstados();

    const lista = requisicoesTecnicasMock
      .map((req) => {
        const estado = estados[req.id];

        if (!estado) return req;

        return {
          ...req,
          status: estado.status,
          itens: req.itens.map((item) => ({
            ...item,
            separado:
              estado.itens[item.id]?.quantidadeSeparada ??
              item.separado,
            conferido:
              estado.conferencia[item.id]?.quantidadeConferida ??
              item.conferido,
          })),
        };
      })
      .filter(
        (req) =>
          req.status === "SEPARADA" ||
          req.status === "EM_CONFERENCIA"
      );

    setRequisicoes(lista);
  }

  useEffect(() => {
    carregar();
    return ouvirAlteracoes(carregar);
  }, []);

  const filtradas = useMemo(() => {
    const termo = busca.trim().toLowerCase();

    if (!termo) return requisicoes;

    return requisicoes.filter(
      (req) =>
        req.codigo.toLowerCase().includes(termo) ||
        req.tecnico.toLowerCase().includes(termo) ||
        req.codigoTecnico.toLowerCase().includes(termo) ||
        req.base.toLowerCase().includes(termo)
    );
  }, [busca, requisicoes]);

  function totalItens(req: RequisicaoTecnica) {
    return req.itens.reduce(
      (total, item) => total + item.solicitado,
      0
    );
  }

  return (
    <div className="collector-screen">
      <div className="collector-phone">
        <div className="collector-header">
          <div className="collector-header-title">
            <button
              className="collector-back-button"
              onClick={() => router.push("/coletor/expedicoes")}
            >
              ‹
            </button>
            <strong>Ordens - Conferência</strong>
          </div>
        </div>

        <div className="collector-search-area">
          <div className="collector-search-box">
            <span>⌕</span>
            <input
              value={busca}
              onChange={(e) => setBusca(e.target.value)}
              placeholder="Parâmetro de busca"
            />
          </div>
        </div>

        <div className="collector-request-list">
          {filtradas.length === 0 && (
            <div
              style={{
                padding: "32px 20px",
                textAlign: "center",
                color: "#64748b",
              }}
            >
              Nenhuma ordem aguardando conferência.
            </div>
          )}

          {filtradas.map((req) => (
            <button
              key={req.id}
              className="collector-request-card"
              onClick={() =>
                router.push(`/coletor/conferencia/${req.id}`)
              }
            >
              <div className="collector-card-strip" />

              <div className="collector-card-content">
                <div className="collector-card-header">
                  <strong>Pedido: {req.codigo.replace("REQ-", "")}</strong>

                  <span className={prioridadeClass(req.prioridade)}>
                    {req.prioridade}
                  </span>
                </div>

                <div className="collector-technician">
                  Cliente: {req.tecnico}
                </div>

                <div className="collector-card-row">
                  <span>Técnico:</span>
                  <b>{req.codigoTecnico}</b>
                </div>

                <div className="collector-card-row">
                  <span>Base:</span>
                  <b>{req.base}</b>
                </div>

                <div className="collector-card-row">
                  <span>Situação:</span>
                  <b>{statusNome(req.status)}</b>
                </div>

                <div className="collector-card-numbers">
                  <div>
                    <span>Itens:</span>
                    <strong>{totalItens(req)}</strong>
                  </div>

                  <div>
                    <span>SKUs:</span>
                    <strong>{req.itens.length}</strong>
                  </div>
                </div>

                <div className="collector-card-footer">
                  <span className="collector-status separating">
                    {statusNome(req.status)}
                  </span>

                  <span className="collector-arrow">›</span>
                </div>
              </div>
            </button>
          ))}
        </div>

        <div className="collector-bottom-info">
          {filtradas.length} ordens disponíveis
        </div>
      </div>
    </div>
  );
}
