          height: 28px;

          flex: 0 0 28px;

          border-radius: 50%;

          background: #1593b7;
          color: #ffffff;

          display: flex;
          align-items: center;
          justify-content: center;

          font-size: 16px;
          font-weight: 900;
        }

        .ret-relation > div:last-child {
          display: flex;
          align-items: baseline;
          gap: 5px;
          flex-wrap: wrap;
