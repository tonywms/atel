/* =========================================================
   TELAS MENORES
   Escala o "aparelho" sem alterar o layout interno.
   ========================================================= */

@media (max-height: 875px) and (min-width: 500px) {
  .collector-phone {
    transform: scale(0.90);
    transform-origin: center center;

    margin: calc((852px * -0.05));
  }
}

@media (max-height: 780px) and (min-width: 500px) {
  .collector-phone {
    transform: scale(0.80);
    transform-origin: center center;

    margin: calc((852px * -0.10));
  }
