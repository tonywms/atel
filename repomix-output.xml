  input: { width: "100%", height: 40, boxSizing: "border-box", marginTop: 5, border: "1px solid #cbd5e1", borderRadius: 6, padding: "0 9px", background: "#fff" },
  textarea: { width: "100%", minHeight: 70, boxSizing: "border-box", marginTop: 5, border: "1px solid #cbd5e1", borderRadius: 6, padding: 9, resize: "vertical" },
  serialButton: { width: "100%", minHeight: 38, marginTop: 6, padding: "0 10px", display: "flex", alignItems: "center", gap: 8, border: "1px solid #d8e2e8", borderRadius: 6, background: "#fff", color: "#344054", cursor: "pointer" },
  serialSelected: { border: "1px solid #168bb2", background: "#edf8fc", color: "#087da7" },
  modalMessage: { marginTop: 10, padding: 9, borderRadius: 6, background: "#fff0ef", color: "#b42318", fontSize: 9, fontWeight: 700 },
  actions: { display: "grid", gridTemplateColumns: "1fr 1.35fr", gap: 8, marginTop: 15 },
  cancel: { minHeight: 44, border: "1px solid #cbd5e1", borderRadius: 7, background: "#fff", color: "#475467", fontSize: 10, fontWeight: 900, cursor: "pointer" },
  confirm: { minHeight: 44, border: 0, borderRadius: 7, background: "#0796bc", color: "#fff", fontSize: 10, fontWeight: 900, cursor: "pointer" },
  confirmModal: { width: "100%", background: "#fff", borderRadius: 14, padding: 18, textAlign: "center" },
  confirmIcon: { width: 42, height: 42, margin: "0 auto 10px", borderRadius: 21, background: "#fff6dc", color: "#946200", display: "flex", alignItems: "center", justifyContent: "center", fontSize: 22, fontWeight: 900 },
  confirmTitle: { fontSize: 16, fontWeight: 900, color: "#20242a" },
  confirmText: { fontSize: 11, lineHeight: 1.55, color: "#475467" },
  warning: { padding: 10, borderRadius: 7, background: "#fff6dc", color: "#946200", fontSize: 9, lineHeight: 1.45, fontWeight: 700 },
};
