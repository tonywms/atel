"use client";

import { useRouter } from "next/navigation";
import styles from "./consulta.module.css";

function ArrowLeft() {
  return <svg viewBox="0 0 24 24" width="23" height="23" fill="none" stroke="currentColor" strokeWidth="2.4" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true"><path d="m14 5-7 7 7 7"/><path d="M8 12h12"/></svg>;
}
function InventoryIcon({ technician = false }: { technician?: boolean }) {
  return <svg viewBox="0 0 24 24" width="23" height="23" fill="none" stroke="currentColor" strokeWidth="1.8" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">{technician ? <><circle cx="12" cy="5" r="2.5"/><path d="M7 21v-5a5 5 0 0 1 10 0v5M4 21h16M5 12l-2 3 2 2M19 12l2 3-2 2"/></> : <><path d="m4 7 8-4 8 4v10l-8 4-8-4z"/><path d="m4 7 8 4 8-4M12 11v10M8 5l8 4"/></>}</svg>;
}
const options = [
  { title: "Estoque", route: "/coletor/consulta/estoque", technician: false },
  { title: "Estoque Técnico", route: "/coletor/consulta/estoque-tecnico", technician: true },
] as const;

export default function ConsultaPage() {
  const router = useRouter();
  return (
    <div className={styles.screen}>
      <main className={styles.phone}>
        <header className={styles.header}>
          <button type="button" className={styles.back} aria-label="Voltar ao menu do coletor" onClick={() => router.push("/coletor")}><ArrowLeft /></button>
          <h1>Consulta</h1>
        </header>
        <section className={styles.content} aria-label="Opções de consulta">
          {options.map((option) => (
            <button key={option.route} type="button" className={styles.card} onClick={() => router.push(option.route)}>
              <span className={styles.icon}><InventoryIcon technician={option.technician}/></span>
              <span className={styles.name}>{option.title}</span>
              <span className={styles.counter} aria-label="Indicador visual sem contagem disponível" />
            </button>
          ))}
        </section>
      </main>
    </div>
  );
}
</file>

<file path="app/coletor/embarque/page.tsx">
"use client";

import "./atel-v47.css";

import { useEffect, useMemo, useState } from "react";
import { useRouter } from "next/navigation";

import {
  requisicoesTecnicasMock,
  RequisicaoTecnica,
} from "@/lib/requisicoesTecnicas";

import {
  carregarEstados,
  ouvirAlteracoes,
} from "@/lib/requisicoesStore";

export default function EmbarquePage() {
  const router = useRouter();

  const [busca, setBusca] = useState("");
  const [versao, setVersao] = useState(0);

  useEffect(() => {
    const atualizar = () =>
      setVersao((valor) => valor + 1);

    atualizar();

    return ouvirAlteracoes(atualizar);
  }, []);

  const requisicoes = useMemo(() => {
    void versao;

    const estados = carregarEstados();

    const termo = busca
      .trim()
      .toUpperCase();

    return requisicoesTecnicasMock
      .map((req) => {
        const estado = estados[req.id];

        return {
          ...req,

          status:
            estado?.status ??
            req.status,

          volumes:
            estado?.volumes ??
            [],
        };
      })
      .filter(
        (req) =>
          req.status === "CONFERIDA" ||
          req.status === "EMBARCADA"
      )
      .filter((req) => {
        if (!termo) {
          return true;
        }

        return [
          req.codigo,
          req.tecnico,
          req.codigoTecnico,
          req.base,
          req.tipo,
        ]
          .join(" ")
          .toUpperCase()
          .includes(termo);
      });
  }, [busca, versao]);

  return (
    <div className="collector-screen atel-v47-screen atel-v47-embarque">
      <div
        className="collector-phone"
        style={{
          background: "#f4f4f4",
          overflow: "hidden",
        }}
      >
        

        <div
          style={{
            minHeight: 76,
            background: "#168bb2",
            color: "#fff",
            display: "flex",
            alignItems: "center",
            gap: 12,
            padding: "0 18px",
            flex: "0 0 auto",
          }}
        >
          <button
            type="button"
            onClick={() =>
              router.push(
                "/coletor/expedicoes"
              )
            }
            style={{
              border: 0,
              background: "transparent",
              color: "#fff",
              fontSize: 34,
              cursor: "pointer",
              padding: 0,
            }}
          ><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.3" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg></button>

          <strong
            style={{
              fontSize: 23,
            }}
          >
            Embarque
          </strong>
        </div>

        <div
          style={{
            padding: "12px 12px 8px",
            flex: "0 0 auto",
          }}
        >
          <div
            style={{
              minHeight: 56,
              border: "1px solid #aaa",
              borderRadius: 18,
              background: "#fff",
              display: "flex",
              alignItems: "center",
              gap: 10,
              padding: "0 15px",
            }}
          >
            <span
              style={{
                color: "#587184",
                fontSize: 20,
              }}
            ><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg></span>

            <input
              value={busca}
              onChange={(e) =>
                setBusca(
                  e.target.value
                )
              }
              placeholder="Parâmetro de busca"
              style={{
                flex: 1,
                border: 0,
                outline: 0,
                background: "transparent",
                fontSize: 15,
              }}
            />
          </div>
        </div>

        <div
          style={{
            flex: 1,
            minHeight: 0,
            overflowY: "auto",
            padding: "8px 8px 30px",
          }}
        >
          {requisicoes.map(
            (req) => (
              <Card
                key={req.id}
                requisicao={req}
                onClick={() =>
                  router.push(
                    `/coletor/embarque/${req.id}`
                  )
                }
              />
            )
          )}

          {requisicoes.length === 0 && (
            <div
              style={{
                marginTop: 50,
                textAlign: "center",
                color: "#999",
                fontSize: 12,
              }}
            >
              Nenhuma ordem disponível
              para embarque.
            </div>
          )}

          <div
            style={{
              marginTop: 20,
              textAlign: "center",
              color: "#999",
              fontSize: 10,
            }}
          >
            {requisicoes.length}{" "}
            ordem(ns) disponível(is)
          </div>
        </div>

        <div
          style={{
            height: 36,
            background: "#000",
            flex: "0 0 auto",
          }}
        />
      </div>
    </div>
  );
}

function Card({
  requisicao,
  onClick,
}: {
  requisicao:
    RequisicaoTecnica & {
      volumes: any[];
    };

  onClick: () => void;
}) {
  const volumes =
    requisicao.volumes ?? [];

  const lidos =
    volumes.filter(
      (volume) =>
        volume.status ===
          "EMBARCADO" ||
        volume.status ===
          "EM_TRANSITO" ||
        volume.status ===
          "RECEBIDO"
    ).length;

  const totalItens =
    requisicao.itens.reduce(
      (total, item) =>
        total +
        item.solicitado,
      0
    );

  return (
    <button
      type="button"
      onClick={onClick}
      style={{
        width: "100%",
        minHeight: 166,

        marginBottom: 10,

        /*
