  returnButton: { width: "calc(100% - 22px)", minHeight: 34, margin: "0 11px", border: "1px solid #168bb2", borderRadius: 6, background: "#fff", color: "#087da7", fontSize: 9, fontWeight: 900, cursor: "pointer" },
  empty: { padding: 35, textAlign: "center", color: "#819098" },
  overlay: { position: "absolute", inset: 0, zIndex: 50, background: "rgba(0,0,0,.48)", display: "flex", alignItems: "flex-end" },
  overlayTop: { position: "absolute", inset: 0, zIndex: 80, background: "rgba(0,0,0,.58)", display: "flex", alignItems: "center", justifyContent: "center", padding: 18 },
  modal: { width: "100%", maxHeight: "82%", overflowY: "auto", background: "#fff", borderRadius: "18px 18px 0 0", padding: 16 },
  modalTitle: { color: "#087da7", fontSize: 16, fontWeight: 900, marginBottom: 10 },
  infoBand: { padding: 10, borderRadius: 7, background: "#edf8fc", color: "#087da7", fontSize: 10, fontWeight: 800, lineHeight: 1.5 },
