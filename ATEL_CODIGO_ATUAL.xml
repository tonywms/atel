                      }
                    />

                    {statusNome(
                      req.status
                    )}
                  </span>

                  <div
                    style={{
                      display: "flex",
                      alignItems: "center",
                      gap: 7,
                    }}
                  >
                    <div
                      style={
                        premiumCountersStyle
                      }
                    >
                      <span>
                        SKUs{" "}
                        <strong
