                  }
                />

                {/* =========================================
                    INFORMAÇÕES
                ========================================= */}

                <div
                  style={
                    premiumInfoGridStyle
                  }
                >
                  <div
                    style={
                      premiumInfoItemStyle
                    }
                  >
                    <span
                      style={
                        premiumInfoLabelStyle
                      }
                    >
                      BASE
                    </span>

                    <span
                      style={
                        premiumInfoValueStyle
                      }
                    >
                      {req.base}
                    </span>
                  </div>

                  <div
                    style={
                      premiumInfoItemStyle
                    }
                  >
                    <span
                      style={
                        premiumInfoLabelStyle
                      }
                    >
                      ITENS
                    </span>

                    <span
                      style={
                        premiumInfoValueStyle
                      }
                    >
                      {totalItens(req)}
                    </span>
                  </div>
                </div>

                {/* =========================================
                    STATUS
                ========================================= */}

                <div
                  style={
                    premiumFooterStyle
                  }
                >
                  <span
                    style={premiumStatusStyle(
                      req.status
                    )}
                  >
                    <span
                      style={
