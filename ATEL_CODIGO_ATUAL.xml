          "1px solid #d9e5eb",
        borderBottom:
          "1px solid #d9e5eb",
        borderLeft:
          "7px solid #159fc5",

        borderRadius: 16,

        background: "#fff",

        padding: "12px 13px",

        textAlign: "left",
        cursor: "pointer",

        position: "relative",

        overflow: "hidden",

        /*
         * Sombra bem sutil apenas
         * para separar do fundo.
         */
        boxShadow:
          "0 3px 9px rgba(15, 23, 42, 0.055)",

        fontFamily: "inherit",
      }}
    >
      <div
        style={{
          display: "flex",
          justifyContent:
            "space-between",
