                  setCodigoLido(
                    e.target.value
                  )
                }
                onKeyDown={(e) => {
                  if (
                    e.key ===
                    "Enter"
                  ) {
                    lerVolume();
                  }
                }}
                placeholder="Leia o código do volume"
                autoComplete="off"
                style={{
                  minWidth: 0,
