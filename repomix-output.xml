<file path="app/coletor/expedicoes/estoque-tecnico/page.tsx">
"use client";
import React,{useEffect,useMemo,useState}from"react";
import{carregarEstoqueTecnico,carregarMovimentacoesEstoqueTecnico,ouvirEstoqueTecnico,type EstoqueTecnico,type MovimentoEstoqueTecnico}from"@/lib/estoqueTecnicoStore";
export default function Page(){const[e,setE]=useState<EstoqueTecnico[]>([]),[m,setM]=useState<MovimentoEstoqueTecnico[]>([]),[q,setQ]=useState("");function load(){setE(carregarEstoqueTecnico());setM(carregarMovimentacoesEstoqueTecnico())}useEffect(()=>{load();return ouvirEstoqueTecnico(load)},[]);const f=useMemo(()=>{const x=q.toLowerCase().trim();return e.filter(i=>!x||[i.tecnico,i.codigoTecnico,i.codigoProduto,i.produto,...i.seriais].some(v=>v.toLowerCase().includes(x)))},[e,q]);const tecnicos=new Set(e.filter(x=>x.quantidade>0).map(x=>x.codigoTecnico)).size;return <main style={S.page}><div style={S.head}><div><h1 style={S.h1}>Estoque Móvel do Técnico</h1><div style={S.sub}>Saldo aceito fisicamente pelo técnico após o recebimento.</div></div><button style={S.btn} onClick={load}>ATUALIZAR</button></div><div style={S.kpis}><K t="TÉCNICOS" v={tecnicos}/><K t="SKUS" v={e.filter(x=>x.quantidade>0).length}/><K t="QUANTIDADE" v={e.reduce((a,b)=>a+b.quantidade,0)}/><K t="SERIAIS" v={e.reduce((a,b)=>a+b.seriais.length,0)}/></div><section style={S.panel}><div style={S.toolbar}><input style={S.input} value={q} onChange={x=>setQ(x.target.value)} placeholder="Buscar técnico, produto, código ou serial..."/></div><div style={{overflowX:"auto"}}><table style={S.table}><thead><tr>{["TÉCNICO","BASE","PRODUTO","DESCRIÇÃO","QTD","UN","SERIAIS","SITUAÇÃO"].map(x=><th key={x} style={S.th}>{x}</th>)}</tr></thead><tbody>{f.map(i=><tr key={i.id}><td style={S.td}><b>{i.tecnico}</b><div style={S.muted}>{i.codigoTecnico}</div></td><td style={S.td}>{i.base}</td><td style={S.td}><b>{i.codigoProduto}</b></td><td style={S.td}>{i.produto}</td><td style={S.td}><b>{i.quantidade}</b></td><td style={S.td}>{i.unidade}</td><td style={S.td}>{i.seriais.length?i.seriais.join(", "):"—"}</td><td style={S.td}><span style={S.ok}>DISPONÍVEL</span></td></tr>)}{!f.length&&<tr><td colSpan={8} style={S.empty}>Nenhum estoque móvel encontrado.</td></tr>}</tbody></table></div></section><section style={S.panel}><h3 style={S.section}>ÚLTIMAS MOVIMENTAÇÕES</h3><div style={{overflowX:"auto"}}><table style={S.table}><thead><tr>{["DATA","DOCUMENTO","TÉCNICO","PRODUTO","QTD","TIPO"].map(x=><th key={x} style={S.th}>{x}</th>)}</tr></thead><tbody>{m.slice(0,30).map(x=><tr key={x.id}><td style={S.td}>{new Date(x.criadoEm).toLocaleString("pt-BR")}</td><td style={S.td}><b>{x.documentoOrigem}</b></td><td style={S.td}>{x.codigoTecnico} - {x.tecnico}</td><td style={S.td}>{x.codigoProduto} - {x.produto}</td><td style={S.td}>{x.quantidade} {x.unidade}</td><td style={S.td}>{x.tipo}</td></tr>)}</tbody></table></div></section></main>}
function K({t,v}:{t:string;v:number}){return <div style={S.kpi}><span style={S.kt}>{t}</span><b style={S.kv}>{v}</b></div>}
