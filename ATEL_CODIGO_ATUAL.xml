"use client";

/* =========================================================
   TIPOS
========================================================= */

export type StatusPendenciaRetorno =
  | "ABERTA"
  | "EM_ANALISE"
  | "RESOLVIDA";

export type SolucaoPendenciaRetorno =
  | "DISPONIVEL"
  | "QUARENTENA"
  | "BAIXA";

export type PendenciaRetorno = {
  id: string;
  chaveIdempotencia: string;

  retornoId: number;
  retornoCodigo: string;

  itemRetornoId: number;

  documentoOrigem: string;

  codigoProduto: string;
  produto: string;
  unidade: string;

  quantidade: number;

  motivo?: string;
  observacao?: string;

  seriais: string[];

  tecnico: string;
  codigoTecnico: string;
  base: string;

  status: StatusPendenciaRetorno;

  criadoEm: string;
  atualizadoEm: string;

  solucao?: SolucaoPendenciaRetorno;
  resolvidoEm?: string;
  observacaoResolucao?: string;

  chaveResolucao?: string;
};

export type EstoqueRetorno = {
  id: string;
  local: string;

  codigoProduto: string;
  produto: string;

  quantidade: number;

  unidade: string;

  situacao:
    | "DISPONIVEL"
    | "QUARENTENA";

  seriais: string[];

  atualizadoEm: string;
};

export type MovimentoPendenciaRetorno = {
  id: string;

  tipo:
    | "ENTRADA_PENDENCIA_RESOLVIDA"
    | "BAIXA_PENDENCIA";

  retornoId: number;
  retornoCodigo: string;

  pendenciaId: string;

  documentoOrigem: string;

  codigoProduto: string;
  produto: string;

  quantidade: number;
  unidade: string;

  origem: string;
  destino: string;

  tecnico: string;

  situacao?: "DISPONIVEL" | "QUARENTENA";

  seriais: string[];

  chaveIdempotencia: string;

  criadoEm: string;
};

/* =========================================================
   STORAGE
========================================================= */

const PENDENCIAS_KEY =
  "wms-expert-pendencias-retornos";

const ESTOQUE_KEY =
  "wms-expert-estoque-retornos";

const MOVIMENTACOES_KEY =
  "wms-expert-movimentacoes-retornos";

const UPDATE_EVENT =
  "wms-pendencias-retornos-update";

/* =========================================================
   HELPERS
========================================================= */

function isBrowser() {
  return typeof window !== "undefined";
}

function agora() {
  return new Date().toISOString();
}

function lerArray<T>(
  chave: string
): T[] {
  if (!isBrowser()) {
    return [];
  }

  try {
    const raw =
      localStorage.getItem(chave);

    if (!raw) {
      return [];
    }

    const dados =
      JSON.parse(raw);

    return Array.isArray(dados)
      ? dados
      : [];
  } catch {
    return [];
  }
}

function salvarArray<T>(
  chave: string,
  dados: T[]
) {
  if (!isBrowser()) {
    return;
  }

  localStorage.setItem(
    chave,
    JSON.stringify(dados)
  );
}

function emitirAtualizacao() {
  if (!isBrowser()) {
    return;
  }

  window.dispatchEvent(
    new CustomEvent(
      UPDATE_EVENT
    )
  );
}

function limparSeriais(
  seriais?: string[]
) {
  return Array.from(
    new Set(
      (seriais ?? [])
        .map((serial) =>
          String(serial).trim()
        )
        .filter(Boolean)
    )
  );
}

/* =========================================================
   CONSULTAS
========================================================= */

export function carregarPendenciasRetorno():
  PendenciaRetorno[] {
  return lerArray<PendenciaRetorno>(
    PENDENCIAS_KEY
  ).map((pendencia) => ({
    ...pendencia,

    seriais:
      limparSeriais(
        pendencia.seriais
      ),

    status:
      pendencia.status ??
      "ABERTA",
  }));
}

export function obterPendenciaRetorno(
  id: string
) {
  return (
    carregarPendenciasRetorno().find(
      (pendencia) =>
        pendencia.id === id
    ) ?? null
  );
}

export function carregarEstoqueRetorno():
  EstoqueRetorno[] {
  return lerArray<EstoqueRetorno>(
    ESTOQUE_KEY
  );
}

export function carregarMovimentacoesRetorno():
  MovimentoPendenciaRetorno[] {
  return lerArray<MovimentoPendenciaRetorno>(
    MOVIMENTACOES_KEY
  );
}

/* =========================================================
   EVENTOS
========================================================= */

export function ouvirPendenciasRetorno(
  callback: () => void
) {
  if (!isBrowser()) {
    return () => {};
  }

  const atualizar = () => {
    callback();
  };

  const storage = (
    event: StorageEvent
  ) => {
    if (
      event.key ===
        PENDENCIAS_KEY ||
      event.key ===
        ESTOQUE_KEY ||
      event.key ===
        MOVIMENTACOES_KEY
    ) {
      callback();
    }
  };

  window.addEventListener(
    UPDATE_EVENT,
    atualizar
  );

  window.addEventListener(
    "storage",
    storage
  );

  return () => {
    window.removeEventListener(
      UPDATE_EVENT,
      atualizar
    );

    window.removeEventListener(
      "storage",
      storage
    );
  };
}

/* =========================================================
   EM ANÁLISE
========================================================= */

export function iniciarAnalisePendencia(
  id: string
) {
  const pendencias =
    carregarPendenciasRetorno();

  const pendencia =
    pendencias.find(
      (item) =>
        item.id === id
    );

  if (!pendencia) {
    throw new Error(
      "Pendência não encontrada."
    );
  }

  if (
    pendencia.status ===
    "RESOLVIDA"
  ) {
    throw new Error(
      "Esta pendência já foi resolvida."
    );
  }

  pendencia.status =
    "EM_ANALISE";

  pendencia.atualizadoEm =
    agora();

  salvarArray(
    PENDENCIAS_KEY,
    pendencias
  );

  emitirAtualizacao();

  return pendencia;
}

/* =========================================================
   DEVOLVER PARA ABERTA
========================================================= */

export function reabrirAnalisePendencia(
  id: string
) {
  const pendencias =
    carregarPendenciasRetorno();

  const pendencia =
    pendencias.find(
      (item) =>
        item.id === id
    );

  if (!pendencia) {
    throw new Error(
      "Pendência não encontrada."
    );
  }

  if (
    pendencia.status ===
    "RESOLVIDA"
  ) {
    throw new Error(
      "Pendência resolvida não pode voltar para aberta."
    );
  }

  pendencia.status =
    "ABERTA";

  pendencia.atualizadoEm =
    agora();

  salvarArray(
    PENDENCIAS_KEY,
    pendencias
  );

  emitirAtualizacao();

  return pendencia;
}

/* =========================================================
   SOMAR ESTOQUE
========================================================= */

function adicionarAoEstoque(
  pendencia: PendenciaRetorno,
  situacao:
    | "DISPONIVEL"
    | "QUARENTENA",
  data: string
) {
  const estoque =
    carregarEstoqueRetorno();

  const local =
    situacao === "QUARENTENA"
      ? "QUARENTENA - CD Fortaleza"
      : "CD Fortaleza";

  const idEstoque =
    `${local}|${pendencia.codigoProduto}|${situacao}`;

  const existente =
    estoque.find(
      (item) =>
        item.id === idEstoque
    );

  if (existente) {
    existente.quantidade =
      Number(
        existente.quantidade ?? 0
      ) +
      Number(
        pendencia.quantidade ?? 0
      );

    existente.seriais =
      limparSeriais([
        ...(existente.seriais ??
          []),
        ...(pendencia.seriais ??
          []),
      ]);

    existente.atualizadoEm =
      data;
  } else {
    estoque.push({
      id: idEstoque,

      local,

      codigoProduto:
        pendencia.codigoProduto,

      produto:
        pendencia.produto,

      quantidade:
        Number(
          pendencia.quantidade ??
            0
        ),

      unidade:
        pendencia.unidade,

      situacao,

      seriais:
        limparSeriais(
          pendencia.seriais
        ),

      atualizadoEm: data,
    });
  }

  salvarArray(
    ESTOQUE_KEY,
    estoque
  );
}

/* =========================================================
   MOVIMENTAÇÃO
========================================================= */

function registrarMovimentacaoResolucao(
  pendencia: PendenciaRetorno,
  solucao: SolucaoPendenciaRetorno,
  chaveResolucao: string,
  data: string
) {
  const movimentacoes =
    carregarMovimentacoesRetorno();

  const jaExiste =
    movimentacoes.some(
      (movimento) =>
        movimento.chaveIdempotencia ===
        chaveResolucao
    );

  if (jaExiste) {
    return;
  }

  let destino =
    "BAIXA / AJUSTE";

  let situacao:
    | "DISPONIVEL"
    | "QUARENTENA"
    | undefined;

  if (
    solucao ===
    "DISPONIVEL"
  ) {
    destino =
      "CD Fortaleza";

    situacao =
      "DISPONIVEL";
  }

  if (
    solucao ===
    "QUARENTENA"
  ) {
    destino =
      "QUARENTENA - CD Fortaleza";

    situacao =
      "QUARENTENA";
  }

  const movimento:
    MovimentoPendenciaRetorno = {
    id:
      `MOV-PEND-${Date.now()}-${pendencia.itemRetornoId}`,

    tipo:
      solucao === "BAIXA"
        ? "BAIXA_PENDENCIA"
        : "ENTRADA_PENDENCIA_RESOLVIDA",

    retornoId:
      pendencia.retornoId,

    retornoCodigo:
      pendencia.retornoCodigo,

    pendenciaId:
      pendencia.id,

    documentoOrigem:
      pendencia.documentoOrigem,

    codigoProduto:
      pendencia.codigoProduto,

    produto:
      pendencia.produto,

    quantidade:
      pendencia.quantidade,

    unidade:
      pendencia.unidade,

    origem:
      `PENDÊNCIA ${pendencia.id}`,

    destino,

    tecnico:
      pendencia.tecnico,

    situacao,

    seriais:
      limparSeriais(
        pendencia.seriais
      ),

    chaveIdempotencia:
      chaveResolucao,

    criadoEm:
      data,
  };

  movimentacoes.unshift(
    movimento
  );

  salvarArray(
    MOVIMENTACOES_KEY,
    movimentacoes
  );
}

/* =========================================================
   RESOLVER
========================================================= */

export function resolverPendenciaRetorno(
  id: string,
  dados: {
    solucao:
      SolucaoPendenciaRetorno;

    observacao: string;
  }
) {
  const pendencias =
    carregarPendenciasRetorno();

  const pendencia =
    pendencias.find(
      (item) =>
        item.id === id
    );

  if (!pendencia) {
    throw new Error(
      "Pendência não encontrada."
    );
  }

  if (
    pendencia.status ===
    "RESOLVIDA"
  ) {
    throw new Error(
      "Esta pendência já foi resolvida."
    );
  }

  if (
    !dados.observacao.trim()
  ) {
    throw new Error(
      "Informe a justificativa da resolução."
    );
  }

  if (
    !Number.isFinite(
      Number(
        pendencia.quantidade
      )
    ) ||
    Number(
      pendencia.quantidade
    ) <= 0
  ) {
    throw new Error(
      "A pendência possui quantidade inválida."
    );
  }

  /*
   * A chave é específica da resolução.
   *
   * A pendência original possui:
   * RET|retorno|item|DIVERGENCIA
   *
   * A resolução passa a possuir:
   * PEND|id|RESOLUCAO
   *
   * Assim não conflita com a geração original
   * e impede resolver duas vezes.
   */
  const chaveResolucao =
    `PEND|${pendencia.id}|RESOLUCAO`;

  const movimentacoes =
    carregarMovimentacoesRetorno();

  const jaMovimentado =
    movimentacoes.some(
      (movimento) =>
        movimento.chaveIdempotencia ===
        chaveResolucao
    );

  /*
   * Se não houve movimentação anterior,
   * executamos a solução.
   */
  if (!jaMovimentado) {
    const data =
      agora();

    if (
      dados.solucao ===
      "DISPONIVEL"
    ) {
      adicionarAoEstoque(
        pendencia,
        "DISPONIVEL",
        data
      );
    }

    if (
      dados.solucao ===
      "QUARENTENA"
    ) {
      adicionarAoEstoque(
        pendencia,
        "QUARENTENA",
        data
      );
    }

    /*
     * BAIXA não adiciona saldo.
     *
     * Apenas gera movimentação
     * de encerramento.
     */

    registrarMovimentacaoResolucao(
      pendencia,
      dados.solucao,
      chaveResolucao,
      data
    );
  }

  const dataResolucao =
    agora();

  pendencia.status =
    "RESOLVIDA";

  pendencia.solucao =
    dados.solucao;

  pendencia.resolvidoEm =
    dataResolucao;

  pendencia.atualizadoEm =
    dataResolucao;

  pendencia.observacaoResolucao =
    dados.observacao.trim();

  pendencia.chaveResolucao =
    chaveResolucao;

  salvarArray(
    PENDENCIAS_KEY,
    pendencias
  );

  emitirAtualizacao();

  return pendencia;
}
</file>

<file path="lib/retornosStore.ts">
"use client";

import type { RequisicaoTecnica } from "@/lib/requisicoesTecnicas";
import { processarEntradaRetornoNoEstoque } from "@/lib/estoqueRetornoStore";

export type TipoRetorno =
  | "RECUSA_TOTAL"
  | "RECUSA_PARCIAL"
  | "TROCA"
  | "AVARIA"
  | "CANCELAMENTO"
  | "DEVOLUCAO";

export type OrigemRetorno =
  | "REQUISICAO"
  | "ABASTECIMENTO"
  | "ORDEM_SERVICO"
  | "CLIENTE"
  | "TECNICO";

export type StatusRetorno =
  | "AGUARDANDO_RETORNO"
  | "COM_TECNICO"
  | "EM_TRANSITO_CD"
  | "AGUARDANDO_CONFERENCIA"
  | "EM_CONFERENCIA"
  | "RECEBIDO"
  | "FINALIZADO";

export type DestinoItemRetorno =
  | "DISPONIVEL"
  | "QUARENTENA"
  | "DIVERGENCIA";

export type ItemRetorno = {
  id: number;
  itemIdOrigem?: number;
  codigoProduto: string;
  produto: string;
  unidade: string;
  quantidade: number;
  quantidadeEsperada?: number;
  quantidadeRecebida?: number;
  quantidadeAceita?: number;
  motivo?: string;
  observacao?: string;
  seriais: string[];
};

export type ConferenciaItemRetorno = {
  itemId: number;
  destino: DestinoItemRetorno;
  quantidadeRecebida: number;
  quantidadeDisponivel: number;
  quantidadeQuarentena: number;
  quantidadeDivergente: number;
  seriaisRecebidos: string[];
  observacao?: string;
  conferidoEm: string;
};

export type RecebimentoRetorno = {
  iniciadoEm?: string;
  codigoLido?: string;
  lidoEm?: string;
  finalizadoEm?: string;
  itensConferidos: Record<number, ConferenciaItemRetorno>;
};

export type RetornoDevolucao = {
  id: number;
  codigo: string;
  tipo: TipoRetorno;
  origem: OrigemRetorno;
  status: StatusRetorno;
  documentoOrigem: string;
  requisicaoId?: number;

  tecnico: string;
  codigoTecnico: string;
  base: string;

  origemFisica: string;
  destinoFisico: string;

  criadoEm: string;
  atualizadoEm: string;

  observacao?: string;

  itens: ItemRetorno[];

  recebimentoCD?: RecebimentoRetorno;
};

const STORAGE_KEY = "wms-expert-retornos";
const UPDATE_EVENT = "wms-retornos-update";

function isBrowser() {
  return typeof window !== "undefined";
}

/* =========================================================
   NORMALIZAÇÃO
========================================================= */

function normalizarRetorno(
  retorno: RetornoDevolucao
): RetornoDevolucao {
  return {
    ...retorno,

    itens: Array.isArray(retorno.itens)
      ? retorno.itens.map((item) => ({
          ...item,
          seriais: Array.isArray(item.seriais)
            ? item.seriais
            : [],
        }))
      : [],

    recebimentoCD: {
      iniciadoEm: retorno.recebimentoCD?.iniciadoEm,
      codigoLido: retorno.recebimentoCD?.codigoLido,
      lidoEm: retorno.recebimentoCD?.lidoEm,
      finalizadoEm: retorno.recebimentoCD?.finalizadoEm,

      itensConferidos:
        retorno.recebimentoCD?.itensConferidos ?? {},
    },
  };
}

/* =========================================================
   STORAGE
========================================================= */

export function carregarRetornos(): RetornoDevolucao[] {
  if (!isBrowser()) {
    return [];
  }

  try {
    const raw = localStorage.getItem(STORAGE_KEY);

    if (!raw) {
      return [];
    }

    const dados = JSON.parse(raw);

    if (!Array.isArray(dados)) {
      return [];
    }

    return dados.map((retorno) =>
      normalizarRetorno(retorno)
    );
  } catch {
    return [];
  }
}

function salvarRetornos(
  retornos: RetornoDevolucao[]
) {
  if (!isBrowser()) {
    return;
  }

  localStorage.setItem(
    STORAGE_KEY,
    JSON.stringify(retornos)
  );

  window.dispatchEvent(
    new CustomEvent(UPDATE_EVENT)
  );
}

export function ouvirRetornos(
  callback: () => void
) {
  if (!isBrowser()) {
    return () => {};
  }

  const onUpdate = () => {
    callback();
  };

  const onStorage = (
    event: StorageEvent
  ) => {
    if (event.key === STORAGE_KEY) {
      callback();
    }
  };

  window.addEventListener(
    UPDATE_EVENT,
    onUpdate
  );

  window.addEventListener(
    "storage",
    onStorage
  );

  return () => {
    window.removeEventListener(
      UPDATE_EVENT,
      onUpdate
    );

    window.removeEventListener(
      "storage",
      onStorage
    );
  };
}

/* =========================================================
   CÓDIGO RET
========================================================= */

function gerarCodigoRetorno(
  retornos: RetornoDevolucao[]
) {
  const ano = String(
    new Date().getFullYear()
  ).slice(-2);

  const maiorNumero = retornos.reduce(
    (maior, retorno) => {
      const match =
        retorno.codigo.match(
          /RET-\d{2}(\d+)/
        );

      const numero = Number(
        match?.[1] ?? 0
      );

      return Math.max(
        maior,
        numero
      );
    },
    0
  );

  return `RET-${ano}${String(
    maiorNumero + 1
  ).padStart(5, "0")}`;
}

/* =========================================================
   CONSULTAS
========================================================= */

export function obterRetorno(
  id: number
) {
  return (
    carregarRetornos().find(
      (retorno) =>
        retorno.id === id
    ) ?? null
  );
}

export function obterRetornoPorRequisicao(
  requisicaoId: number
) {
  return carregarRetornos().find(
    (retorno) =>
      retorno.requisicaoId ===
      requisicaoId
  );
}

/* =========================================================
   GERAR RETORNO DA REQUISIÇÃO
========================================================= */

export function gerarRetornoDaRequisicao(
  requisicao: RequisicaoTecnica,
  avaliacoes: Record<string, any>,
  volumes: Array<{
    id: number;
    itens: Record<number, any>;
  }>
) {
  const retornos =
    carregarRetornos();

  const existente =
    retornos.find(
      (retorno) =>
        retorno.requisicaoId ===
          requisicao.id &&
        (
          retorno.tipo ===
            "RECUSA_TOTAL" ||
          retorno.tipo ===
            "RECUSA_PARCIAL"
        )
    );

  if (existente) {
    return existente;
  }

  const itensRetorno: ItemRetorno[] = [];

  let houveAceite = false;
  let houveRecusa = false;

  for (const volume of volumes) {
    const itensVolume =
      Object.values(
        volume.itens ?? {}
      );

    for (
      const itemVolume of itensVolume
    ) {
      const avaliacao =
        avaliacoes[
          `${volume.id}:${itemVolume.itemId}`
        ];

      if (!avaliacao) {
        continue;
      }

      const produto =
        requisicao.itens.find(
          (item) =>
            item.id ===
            itemVolume.itemId
        );

      if (!produto) {
        continue;
      }

      const quantidadeEsperada =
        Number(
          itemVolume.quantidade ?? 0
        );

      const quantidadeRecebida =
        Number(
          avaliacao.quantidadeRecebida ??
            quantidadeEsperada
        );

      const quantidadeAceita =
        Number(
          avaliacao.quantidadeAceita ??
            (
              avaliacao.situacao ===
              "OK"
                ? quantidadeRecebida
                : (
                    avaliacao.decisao ===
                      "RECUSA_ITEM" ||
                    avaliacao.decisao ===
                      "RECUSA_VOLUME"
                  )
                ? 0
                : quantidadeRecebida
            )
        );

      const quantidadeFaltante =
        Math.max(
          quantidadeEsperada -
            quantidadeRecebida,
          0
        );

      const quantidadeRecusadaFisica =
        Math.max(
          quantidadeRecebida -
            quantidadeAceita,
          0
        );

      const quantidadeRetorno =
        quantidadeFaltante +
        quantidadeRecusadaFisica;

      if (quantidadeAceita > 0) {
        houveAceite = true;
      }

      if (quantidadeRetorno <= 0) {
        continue;
      }

      houveRecusa = true;

      const seriaisRecusados =
        avaliacao.seriaisRecusados ??
        (
          avaliacao.decisao ===
            "RECUSA_ITEM" ||
          avaliacao.decisao ===
            "RECUSA_VOLUME"
            ? (
                avaliacao.seriaisRecebidos ??
                itemVolume.seriais ??
                []
              )
            : []
        );

      itensRetorno.push({
        id:
          itensRetorno.length + 1,

        itemIdOrigem:
          itemVolume.itemId,

        codigoProduto:
          produto.codigoProduto,

        produto:
          produto.produto,

        unidade:
          produto.unidade,

        quantidade:
          quantidadeRetorno,

        quantidadeEsperada,

        quantidadeRecebida,

        quantidadeAceita,

        motivo:
          avaliacao.tipoDivergencia,

        observacao:
          avaliacao.observacao,

        seriais: [
          ...seriaisRecusados,
        ],
      });
    }
  }

  if (
    !houveRecusa ||
    itensRetorno.length === 0
  ) {
    return null;
  }

  const agora =
    new Date().toISOString();

  const retorno: RetornoDevolucao = {
    id: Date.now(),

    codigo:
      gerarCodigoRetorno(
        retornos
      ),

    tipo: houveAceite
      ? "RECUSA_PARCIAL"
      : "RECUSA_TOTAL",

    origem: "ABASTECIMENTO",

    status:
      "AGUARDANDO_RETORNO",

    documentoOrigem:
      requisicao.codigo,

    requisicaoId:
      requisicao.id,

    tecnico:
      requisicao.tecnico,

    codigoTecnico:
      requisicao.codigoTecnico,

    base:
      requisicao.base,

    origemFisica:
      `${requisicao.codigoTecnico} - ${requisicao.tecnico}`,

    destinoFisico:
      requisicao.origem ??
      "CD Fortaleza",

    criadoEm: agora,

    atualizadoEm: agora,

    itens: itensRetorno,

    recebimentoCD: {
      itensConferidos: {},
    },
  };

  retornos.unshift(
    retorno
  );

  salvarRetornos(
    retornos
  );

  return retorno;
}

/* =========================================================
   CRIAÇÃO MANUAL
========================================================= */

export function criarRetornoManual(
  dados: Omit<
    RetornoDevolucao,
    | "id"
    | "codigo"
    | "criadoEm"
    | "atualizadoEm"
  >
) {
  const retornos =
    carregarRetornos();

  const agora =
    new Date().toISOString();

  const retorno =
    normalizarRetorno({
      ...dados,

      id: Date.now(),

      codigo:
        gerarCodigoRetorno(
          retornos
        ),

      criadoEm: agora,

      atualizadoEm: agora,
    });

  retornos.unshift(
    retorno
  );

  salvarRetornos(
    retornos
  );

  return retorno;
}

/* =========================================================
   ALTERAR STATUS
========================================================= */

export function alterarStatusRetorno(
  id: number,
  status: StatusRetorno
) {
  const retornos =
    carregarRetornos();

  const retorno =
    retornos.find(
      (item) =>
        item.id === id
    );

  if (!retorno) {
    throw new Error(
      "Retorno não encontrado."
    );
  }

  retorno.status =
    status;

  retorno.atualizadoEm =
    new Date().toISOString();

  salvarRetornos(
    retornos
  );

  return retorno;
}

/* =========================================================
   RECEBIMENTO DO RETORNO NO CD
========================================================= */

export function iniciarRecebimentoRetorno(
  id: number
) {
  const retornos =
    carregarRetornos();

  const retorno =
    retornos.find(
      (item) =>
        item.id === id
    );

  if (!retorno) {
    throw new Error(
      "Retorno não encontrado."
    );
  }

  const statusPermitidos:
    StatusRetorno[] = [
      "EM_TRANSITO_CD",
      "AGUARDANDO_CONFERENCIA",
      "EM_CONFERENCIA",
    ];

  if (
    !statusPermitidos.includes(
      retorno.status
    )
  ) {
    throw new Error(
      "Este retorno ainda não está disponível para recebimento no CD."
    );
  }

  retorno.recebimentoCD = {
    ...retorno.recebimentoCD,

    iniciadoEm:
      retorno.recebimentoCD
        ?.iniciadoEm ??
      new Date().toISOString(),

    itensConferidos:
      retorno.recebimentoCD
        ?.itensConferidos ??
      {},
  };

  retorno.atualizadoEm =
    new Date().toISOString();

  salvarRetornos(
    retornos
  );

  return retorno;
}

/* =========================================================
   LEITURA DO RETORNO
========================================================= */

export function registrarLeituraRetorno(
  id: number,
  codigoDigitado: string
) {
  const retornos =
    carregarRetornos();

  const retorno =
    retornos.find(
      (item) =>
        item.id === id
    );

  if (!retorno) {
    throw new Error(
      "Retorno não encontrado."
    );
  }

  const codigo =
    codigoDigitado
      .trim()
      .toUpperCase();

  if (!codigo) {
    throw new Error(
      "Informe ou leia o código do retorno."
    );
  }

  const codigoEsperado =
    retorno.codigo.toUpperCase();

  const codigoValido =
    codigo === codigoEsperado ||
    codigo.includes(
      `RETORNO=${codigoEsperado}`
    ) ||
    codigo.includes(
      codigoEsperado
    );

  if (!codigoValido) {
    throw new Error(
      `Código inválido. Esperado: ${retorno.codigo}`
    );
  }

  retorno.recebimentoCD = {
    ...retorno.recebimentoCD,

    iniciadoEm:
      retorno.recebimentoCD
        ?.iniciadoEm ??
      new Date().toISOString(),

    codigoLido:
      retorno.codigo,

    lidoEm:
      new Date().toISOString(),

    itensConferidos:
      retorno.recebimentoCD
        ?.itensConferidos ??
      {},
  };

  retorno.status =
    "EM_CONFERENCIA";

  retorno.atualizadoEm =
    new Date().toISOString();

  salvarRetornos(
    retornos
  );

  return retorno;
}

/* =========================================================
   CONFERÊNCIA DO ITEM
========================================================= */

export function registrarConferenciaItemRetorno(
  retornoId: number,
  itemId: number,
  dados: {
    destino:
      DestinoItemRetorno;

    quantidadeRecebida:
      number;

    seriaisRecebidos?:
      string[];

    observacao?:
      string;
  }
) {
  const retornos =
    carregarRetornos();

  const retorno =
    retornos.find(
      (item) =>
        item.id ===
        retornoId
    );

  if (!retorno) {
    throw new Error(
      "Retorno não encontrado."
    );
  }

  if (
    !retorno.recebimentoCD
      ?.codigoLido
  ) {
    throw new Error(
      "Leia o código do retorno antes de conferir os itens."
    );
  }

  const item =
    retorno.itens.find(
      (produto) =>
        produto.id === itemId
    );

  if (!item) {
    throw new Error(
      "Item do retorno não encontrado."
    );
  }

  const quantidadeRecebida =
    Number(
      dados.quantidadeRecebida
    );

  const quantidadeEsperada =
    Number(
      item.quantidade ?? 0
    );

  if (
    !Number.isFinite(
      quantidadeRecebida
    ) ||
    quantidadeRecebida < 0
  ) {
    throw new Error(
      "Quantidade recebida inválida."
    );
  }

  if (
    quantidadeRecebida >
    quantidadeEsperada
  ) {
    throw new Error(
      `A quantidade recebida não pode ser maior que ${quantidadeEsperada} ${item.unidade}.`
    );
  }

  let quantidadeDisponivel = 0;
  let quantidadeQuarentena = 0;
  let quantidadeDivergente = 0;

  if (
    dados.destino ===
    "DISPONIVEL"
  ) {
    quantidadeDisponivel =
      quantidadeRecebida;

    quantidadeDivergente =
      Math.max(
        quantidadeEsperada -
          quantidadeRecebida,
        0
      );
  }

  if (
    dados.destino ===
    "QUARENTENA"
  ) {
    quantidadeQuarentena =
      quantidadeRecebida;

    quantidadeDivergente =
      Math.max(
        quantidadeEsperada -
          quantidadeRecebida,
        0
      );
  }

  if (
    dados.destino ===
    "DIVERGENCIA"
  ) {
    quantidadeDivergente =
      quantidadeEsperada;
  }

  retorno.recebimentoCD
    .itensConferidos[itemId] = {
      itemId,

      destino:
        dados.destino,

      quantidadeRecebida,

      quantidadeDisponivel,

      quantidadeQuarentena,

      quantidadeDivergente,

      seriaisRecebidos:
        dados.seriaisRecebidos ??
        [],

      observacao:
        dados.observacao,

      conferidoEm:
        new Date().toISOString(),
    };

  retorno.status =
    "EM_CONFERENCIA";

  retorno.atualizadoEm =
    new Date().toISOString();

  salvarRetornos(
    retornos
  );

  return retorno;
}

/* =========================================================
   FINALIZAR RECEBIMENTO
========================================================= */

export function finalizarRecebimentoRetorno(
  id: number
) {
  const retornos =
    carregarRetornos();

  const retorno =
    retornos.find(
      (item) =>
        item.id === id
    );

  if (!retorno) {
    throw new Error(
      "Retorno não encontrado."
    );
  }

  if (
    !retorno.recebimentoCD
      ?.codigoLido
  ) {
    throw new Error(
      "O retorno ainda não foi lido."
    );
  }

  const itensConferidos =
    retorno.recebimentoCD
      .itensConferidos ??
    {};

  const itensPendentes =
    retorno.itens.filter(
      (item) =>
        !itensConferidos[
          item.id
        ]
    );

  if (
    itensPendentes.length > 0
  ) {
    throw new Error(
      `Existem ${itensPendentes.length} item(ns) sem conferência.`
    );
  }

  // A movimentação de estoque só acontece depois da conferência completa.
  // A função é idempotente: o mesmo RET não duplica saldo/movimentação.
  processarEntradaRetornoNoEstoque(retorno);

  retorno.recebimentoCD
    .finalizadoEm =
    new Date().toISOString();

  retorno.status =
    "FINALIZADO";

  retorno.atualizadoEm =
    new Date().toISOString();

  salvarRetornos(
    retornos
  );

  return retorno;
}
</file>

