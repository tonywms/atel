export function extrairCodigoVolume(leitura: string) {

  const texto = leitura.trim().toUpperCase();

  if (!texto) return "";

  const match = texto.match(/(?:^|\|)VOLUME=([^|]+)/);

  return match ? match[1].trim() : texto;

}



