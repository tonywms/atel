/* =========================================================
   COLETOR - MODO APRESENTAÇÃO FIXO
   Referência visual: 393 x 852
   ========================================================= */

html,
body {
  height: 100%;
}

/* A rota do coletor não gera scroll na página */
body:has(.collector-app) {
  overflow: hidden;
}

.collector-app {
  width: 100%;
  height: 100vh;
  min-height: 0;
  overflow: hidden;
  background: #e8eef5;
}

/*
  Área disponível para apresentação.
  O coletor sempre fica inteiro na tela.
*/
.collector-screen {
  width: 100%;
  height: 100vh;
  min-height: 0;

  display: flex;
  align-items: center;
  justify-content: center;

  overflow: hidden;

  background: #e8eef5;

  padding: 12px;
}

/*
  Nosso "dispositivo".
  Não usamos mais 720px.
*/
.collector-phone {
  width: 393px;
  height: min(852px, calc(100vh - 24px));

  min-height: 0;
  max-width: none;

  position: relative;

  display: flex;
  flex-direction: column;

  overflow: hidden;

  background: #f4f4f4;

  box-shadow:
    0 8px 30px rgba(21, 55, 74, 0.15);

  flex-shrink: 0;
}

