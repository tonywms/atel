/* =========================================================
   GARANTIR MOCK
========================================================= */

function garantirDados() {
  if (!podeUsarStorage()) {
    return;
  }

  const mocks = criarMockInicial();
  const existente = localStorage.getItem(STORAGE_OS);

  if (!existente) {
    salvar(STORAGE_OS, mocks);
    return;
  }

  try {
    const atuais = JSON.parse(existente) as OrdemServico[];
    let alterou = false;

    for (const mock of mocks) {
      if (!atuais.some((item) => item.id === mock.id)) {
        atuais.push(mock);
        alterou = true;
      }
    }

    if (alterou) {
      salvar(STORAGE_OS, atuais);
    }
  } catch {
    salvar(STORAGE_OS, mocks);
  }
}

/* =========================================================
   CARREGAR
========================================================= */

export function carregarOrdensServico() {
  garantirDados();

  return ler<OrdemServico[]>(
    STORAGE_OS,
    []
  );
}

/* =========================================================
   OBTER OS
========================================================= */

export function obterOrdemServico(
  id: number
) {
  return carregarOrdensServico().find(
    (os) => os.id === id
  );
}

/* =========================================================
   SALVAR OS
========================================================= */

function salvarOrdemServico(
  ordem: OrdemServico
) {
  const ordens =
    carregarOrdensServico();

  const indice =
    ordens.findIndex(
      (item) =>
        item.id === ordem.id
    );

  if (indice >= 0) {
    ordens[indice] = ordem;
  } else {
    ordens.push(ordem);
  }

  salvar(
    STORAGE_OS,
    ordens
  );

  disparar();

  return ordem;
}

/* =========================================================
   INICIAR OS
========================================================= */

export function iniciarOrdemServico(
  id: number
) {
  const ordem =
    obterOrdemServico(id);

  if (!ordem) {
    throw new Error(
      "Ordem de serviço não encontrada."
    );
  }

  if (
    ordem.status === "FINALIZADA"
  ) {
    throw new Error(
      "A ordem de serviço já foi finalizada."
    );
  }

  const atualizada: OrdemServico = {
    ...ordem,

    status:
      "EM_ATENDIMENTO",

    iniciadoEm:
      ordem.iniciadoEm ??
      new Date().toISOString(),
  };

  return salvarOrdemServico(
    atualizada
  );
}

/* =========================================================
   ADICIONAR MATERIAL
========================================================= */

export function adicionarMaterialOS(
  ordemId: number,
  dados: {
    codigoProduto: string;
    quantidade: number;
    seriais: string[];
    destino: DestinoMaterialOS;
  }
) {
  const ordem =
    obterOrdemServico(ordemId);

  if (!ordem) {
    throw new Error(
      "Ordem de serviço não encontrada."
    );
  }

  if (
    ordem.status !==
    "EM_ATENDIMENTO"
  ) {
    throw new Error(
      "Inicie a ordem de serviço antes de informar materiais."
    );
  }

  const estoque =
    carregarEstoqueTecnico();

  const saldo =
    estoque.find(
      (item) =>
        item.codigoTecnico ===
          ordem.codigoTecnico &&
        item.codigoProduto ===
          dados.codigoProduto &&
        item.quantidade > 0
    );

  if (!saldo) {
    throw new Error(
      "Produto não disponível no estoque do técnico."
    );
  }

  if (
    dados.quantidade <= 0
  ) {
    throw new Error(
      "Informe uma quantidade válida."
    );
  }

  if (
    dados.quantidade >
    saldo.quantidade
  ) {
    throw new Error(
      `Saldo insuficiente. Disponível: ${saldo.quantidade} ${saldo.unidade}.`
    );
  }

  const seriais =
    Array.from(
      new Set(
        dados.seriais.filter(Boolean)
      )
    );

  if (
    seriais.some(
      (serial) =>
        !saldo.seriais.includes(
          serial
        )
    )
  ) {
    throw new Error(
      "Um dos seriais informados não pertence ao estoque deste técnico."
    );
  }

  /*
    Se o produto possui serial no estoque,
    a quantidade selecionada deve ter a
    mesma quantidade de seriais.
  */

  if (
    saldo.seriais.length > 0 &&
    seriais.length !==
      dados.quantidade
  ) {
    throw new Error(
      `Selecione ${dados.quantidade} serial(is) para este produto.`
    );
  }

  const itensSemMesmoProduto =
    ordem.itens.filter(
      (item) =>
        item.codigoProduto !==
        saldo.codigoProduto
    );

  const novoItem: ItemOrdemServico = {
    id: Date.now(),

    codigoProduto:
      saldo.codigoProduto,

    produto:
      saldo.produto,

    unidade:
      saldo.unidade,

    quantidade:
      dados.quantidade,

    serialObrigatorio:
      saldo.seriais.length > 0,

    seriais,

    destino:
      dados.destino,
  };

  const atualizada: OrdemServico = {
    ...ordem,

    itens: [
      ...itensSemMesmoProduto,
      novoItem,
    ],
  };

  return salvarOrdemServico(
    atualizada
  );
}

/* =========================================================
   REMOVER MATERIAL
========================================================= */

export function removerMaterialOS(
  ordemId: number,
  itemId: number
) {
  const ordem =
    obterOrdemServico(ordemId);

  if (!ordem) {
    throw new Error(
      "Ordem de serviço não encontrada."
    );
  }

  const atualizada: OrdemServico = {
    ...ordem,

    itens:
      ordem.itens.filter(
        (item) =>
          item.id !== itemId
      ),
  };

  return salvarOrdemServico(
    atualizada
  );
}

