.c4 .top { background: #83afbc; }
.c5 .top { background: #31a48e; }

/* TABELA */

.wms-table-container {
  background: white;
  overflow: hidden;
  border-radius: 2px;
}

.wms-table-scroll {
  overflow-x: auto;
  max-height: calc(100vh - 250px);
}

.wms-table {
  border-collapse: collapse;
  width: 100%;
  min-width: 1450px;
}

.wms-table thead {
  position: sticky;
  top: 0;
  z-index: 2;
}

.wms-table th {
  height: 51px;
  background: #075a79;
  color: white;
  font-size: 12px;
  padding: 0 12px;
  text-align: center;
  white-space: nowrap;
}

.wms-table td {
  height: 52px;
  padding: 6px 12px;
  font-size: 12px;
  text-align: center;
  border: 0;
}

.wms-table tbody tr:nth-child(odd) {
  background: #e7edf2;
}

.wms-table tbody tr:nth-child(even) {
  background: white;
}

.wms-table tbody tr:hover {
  background: #d7e8f1;
}

.product-name {
  min-width: 240px;
  text-align: left !important;
  font-weight: 500;
}

.tech-name {
  min-width: 160px;
  text-align: left !important;
}

.stock-positive {
  font-weight: 700;
  color: #07854c;
}

.stock-zero {
  color: #d22f37;
  font-weight: 700;
}

.tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 58px;
  border-radius: 13px;
  padding: 4px 9px;
  font-size: 10px;
  font-weight: 700;
}

.tag.green {
  background: #dff3e8;
  color: #008546;
}

.tag.orange {
  background: #fff0d5;
  color: #bd7200;
}

.tag.blue {
  background: #dceff7;
  color: #087ba6;
}

.tag.red {
  background: #fde1e1;
  color: #d3262e;
}

.table-footer {
  min-height: 74px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  background: var(--wms-bg);
  gap: 8px;
}

.load-more {
  background: #075a79;
  color: white;
  border: 0;
  border-radius: 19px;
  padding: 9px 21px;
  font-size: 12px;
  font-weight: 700;
}

.table-count {
  color: #8b98a5;
  font-size: 11px;
}

@media (max-width: 1000px) {
  aside,
  .sidebar-user {
    width: 220px;
  }

  .work {
    margin-left: 220px;
    width: calc(100% - 220px);
  }

  .stock-summary {
    grid-template-columns: repeat(2, 1fr);
  }
}

/* =========================================================
   REQUISIÇÕES TÉCNICAS
   ========================================================= */

.req-layout {
  display: grid;
  grid-template-columns: 335px minmax(0, 1fr);
  gap: 14px;
  height: calc(100vh - 235px);
  min-height: 570px;
}

.req-sidebar-panel {
  background: #f5f7f9;
  border: 1px solid #0789bd;
  border-radius: 17px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.req-sidebar-title {
  min-height: 43px;
  background: #0784b2;
  color: white;
  display: flex;
  align-items: center;
  padding: 0 15px;
  justify-content: space-between;
  font-size: 13px;
}

.req-sidebar-title span {
  min-width: 27px;
  height: 27px;
  padding: 0 7px;
  border-radius: 50%;
  background: white;
  color: #0784b2;
  display: grid;
  place-items: center;
  font-weight: 700;
}

.req-list {
  overflow-y: auto;
  padding: 8px;
}

.req-card {
  width: 100%;
  display: block;
  text-align: left;
  background: white;
  border: 1px solid #1592c1;
  border-radius: 16px;
  padding: 13px 13px 11px;
  margin-bottom: 9px;
  color: #111827;
  transition: 0.15s;
}

.req-card:hover {
  background: #f5fbfe;
  transform: translateY(-1px);
}

.req-card.selected {
  border: 2px solid #057fab;
  background: #eef9fd;
  box-shadow: 0 3px 10px rgba(7, 91, 124, 0.12);
}

.req-card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 8px;
}

.req-card-top strong {
  color: #057fae;
  font-size: 14px;
}

.req-card-tech {
  font-weight: 700;
  margin: 8px 0 6px;
  font-size: 13px;
}

.req-card-line {
  font-size: 11px;
  line-height: 18px;
  color: #303a46;
}

.req-card-line b {
  color: #111827;
}

.req-card-bottom {
  margin-top: 10px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.req-priority {
  padding: 4px 8px;
  border-radius: 12px;
  font-size: 8px;
  font-weight: 800;
}

.req-priority.urgent {
  color: white;
  background: #ef3d4a;
}

.req-priority.high {
  color: white;
  background: #ee8b00;
}

.req-priority.normal {
  color: white;
  background: #0785b2;
}

.req-status {
  display: inline-flex;
  align-items: center;
  border-radius: 12px;
  padding: 5px 8px;
  font-size: 8px;
  font-weight: 800;
}

.req-status.pending {
  background: #edf0f3;
  color: #687381;
}

.req-status.separating {
  background: #dceffa;
  color: #087ead;
}

.req-status.separated {
  background: #fff0d6;
  color: #b66b00;
}

.req-status.checked {
  background: #e8e3ff;
  color: #684bc3;
}

.req-status.transit {
  background: #fff0d7;
  color: #b86e00;
}

.req-status.finished {
  background: #dff4e9;
  color: #07864c;
}

.req-skus {
  color: #6e7a87;
  font-size: 9px;
  font-weight: 700;
}

/* DETALHE */

.req-detail {
  min-width: 0;
  background: white;
  border: 1px solid #0789bd;
  border-radius: 17px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.req-detail-header {
  min-height: 65px;
  padding: 13px 19px;
  border-bottom: 1px solid #dce4e9;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.req-detail-code {
  font-size: 20px;
  font-weight: 800;
  color: #057da9;
}

.req-detail-description {
  color: #788491;
  font-size: 10px;
  margin-top: 3px;
}

/* API */

.integration-strip {
  min-height: 66px;
  margin: 12px 15px 0;
  border-radius: 11px;
  background: #edf8fc;
  border: 1px solid #b7dfed;
  display: flex;
  align-items: center;
  padding: 10px 13px;
  gap: 11px;
}

.integration-icon {
  width: 43px;
  height: 43px;
  border-radius: 10px;
  background: #0785b2;
  color: white;
  display: grid;
  place-items: center;
  font-size: 10px;
  font-weight: 800;
}

.integration-strip > div:nth-child(2) {
  flex: 1;
}

.integration-strip > div:nth-child(2) strong,
.integration-strip > div:nth-child(2) span {
  display: block;
}

.integration-strip > div:nth-child(2) strong {
  color: #075d7d;
  font-size: 11px;
}

.integration-strip > div:nth-child(2) span {
  color: #758491;
  font-size: 9px;
  margin-top: 4px;
}

.integration-info {
  min-width: 125px;
  padding-left: 15px;
  border-left: 1px solid #c7dfe8;
}

.integration-info small,
.integration-info strong {
  display: block;
}

.integration-info small {
  color: #7c8b98;
  font-size: 7px;
  font-weight: 700;
}

.integration-info strong {
  color: #283641;
  font-size: 10px;
  margin-top: 3px;
}

/* DADOS */

.req-info-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 9px;
  padding: 12px 15px 0;
}

.req-info {
  border: 1px solid #d8e1e7;
  border-radius: 10px;
  padding: 10px 11px;
  min-width: 0;
}

.req-info small,
.req-info strong,
.req-info span {
  display: block;
}

.req-info small {
  font-size: 7px;
  color: #84919c;
  font-weight: 800;
}

.req-info strong {
  margin-top: 4px;
  color: #1e2934;
  font-size: 11px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.req-info span {
  margin-top: 3px;
  font-size: 8px;
  color: #87939e;
}

/* MINI RESUMO */

.req-mini-summary {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  margin: 10px 15px 0;
  background: #f4f7f9;
  border-radius: 10px;
}

.req-mini-summary div {
  padding: 8px 12px;
  border-right: 1px solid #dde5ea;
}

.req-mini-summary div:last-child {
  border-right: 0;
}

.req-mini-summary small,
.req-mini-summary strong {
  display: block;
}

.req-mini-summary small {
  color: #89949f;
  font-size: 7px;
  font-weight: 700;
}

.req-mini-summary strong {
  margin-top: 3px;
  font-size: 12px;
  color: #15222c;
}

/* PRODUTOS */

.req-products {
  margin: 11px 15px 0;
  border: 1px solid #d5dfe5;
  border-radius: 10px;
  overflow: hidden;
}

.req-products-title {
  min-height: 35px;
  background: #075d7d;
  color: white;
  display: flex;
  align-items: center;
  padding: 0 13px;
  font-size: 11px;
  font-weight: 700;
}

.req-products-scroll {
  overflow-x: auto;
}

.req-products table {
  width: 100%;
  border-collapse: collapse;
  min-width: 920px;
}

.req-products th {
  background: #eef2f5;
  color: #53616d;
  height: 34px;
  padding: 0 8px;
  font-size: 7px;
  text-align: center;
  white-space: nowrap;
}

.req-products td {
  border-bottom: 1px solid #e6ebee;
  padding: 10px 8px;
  text-align: center;
  font-size: 9px;
}

.req-products tbody tr:nth-child(even) {
  background: #f6f8fa;
}

.req-product-name {
  text-align: left !important;
  min-width: 205px;
}

.item-status-dot {
  display: inline-block;
  width: 11px;
  height: 11px;
  border-radius: 3px;
  background: #27aa67;
}

/* RODAPÉ */

.req-footer {
  margin-top: auto;
  min-height: 76px;
  border-top: 1px solid #dce3e7;
  padding: 12px 15px;
  display: flex;
  align-items: center;
  gap: 15px;
}

.req-flow {
  display: flex;
  align-items: center;
  flex: 1;
}

.req-flow-step {
  display: flex;
  align-items: center;
  gap: 5px;
  color: #9ba5ae;
  font-size: 8px;
  font-weight: 700;
  white-space: nowrap;
}

.req-flow-step span {
  width: 20px;
  height: 20px;
  border-radius: 50%;
  background: #dce2e6;
  display: grid;
  place-items: center;
  color: #82909b;
  font-size: 8px;
}

.req-flow-step.active {
  color: #0784b2;
}

.req-flow-step.active span {
  color: white;
  background: #0784b2;
}

.req-flow-line {
  height: 2px;
  background: #dce2e6;
  flex: 1;
  min-width: 15px;
  margin: 0 5px;
}

.generate-separation {
  min-width: 145px;
  height: 39px;
  border: 0;
  border-radius: 19px;
  background: #0784b2;
  color: white;
  font-size: 10px;
  font-weight: 800;
  box-shadow: 0 3px 8px rgba(7, 132, 178, 0.18);
}

.generate-separation:hover {
  background: #066d93;
}

.separation-generated {
  min-width: 145px;
  height: 39px;
  border-radius: 19px;
  background: #dff4e9;
  color: #07864c;
  display: grid;
  place-items: center;
  font-size: 10px;
  font-weight: 800;
}

/* RESPONSIVO */

@media (max-width: 1200px) {
  .req-layout {
    grid-template-columns: 285px minmax(0, 1fr);
  }

  .req-info-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .integration-info {
    display: none;
  }
}

