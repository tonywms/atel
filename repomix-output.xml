========================================================= */



export function ouvirAlteracoes(

  callback: () => void

) {

  if (!podeUsarStorage()) {

    return () => {};

  }



  const atualizar = () =>

    callback();



  const atualizarStorage = (

    event: StorageEvent

  ) => {

    if (

      !event.key ||

      event.key === STORAGE_KEY

    ) {

      callback();

    }

  };



  window.addEventListener(

    EVENTO_ATUALIZACAO,

    atualizar

  );



  window.addEventListener(

    "storage",

    atualizarStorage

  );



  return () => {

    window.removeEventListener(

      EVENTO_ATUALIZACAO,

      atualizar

    );



    window.removeEventListener(

      "storage",

      atualizarStorage

    );

  };

}



