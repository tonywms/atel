"use client";

import { useEffect, useMemo, useState } from "react";
import { useParams, useRouter } from "next/navigation";

import { requisicoesTecnicasMock } from "@/lib/requisicoesTecnicas";

import {
  DecisaoRecebimento,
  finalizarRecebimentoTecnico,
  iniciarRecebimentoTecnico,
  marcarItemRecebimentoDivergencia,
  marcarItemRecebimentoOk,
  obterEstado,
  recusarVolumeRecebimento,
  registrarVolumeRecebimentoTecnico,
  TipoDivergenciaRecebimento,
  VolumeRequisicao,
} from "@/lib/requisicoesStore";

/* =========================================================
   TIPOS
========================================================= */

type Modal = {
  volumeId: number;
  itemId: number;
  produto: string;
  codigo: string;
  unidade: string;
  esperado: number;
  seriais: string[];
} | null;

const TIPOS: [TipoDivergenciaRecebimento, string][] = [
  ["FALTANTE", "Item faltante"],
  ["QUANTIDADE_DIVERGENTE", "Quantidade divergente"],
  ["AVARIADO", "Material avariado"],
  ["PRODUTO_ERRADO", "Produto errado"],
  ["SERIAL_DIVERGENTE", "Serial divergente"],
];

/* =========================================================
   HELPERS
========================================================= */

const rotulo = (d?: DecisaoRecebimento) =>
  d === "ACEITE_TOTAL"
    ? "ACEITE TOTAL"
    : d === "ACEITE_PARCIAL"
      ? "ACEITE PARCIAL"
      : d === "RECUSA_ITEM"
        ? "ITEM RECUSADO"
        : d === "RECUSA_VOLUME"
          ? "VOLUME RECUSADO"
          : "DIVERGÊNCIA";

/* =========================================================
   PAGE
========================================================= */

export default function Page() {
  const params = useParams();
  const router = useRouter();

  const id = Number(
    Array.isArray(params.id)
      ? params.id[0]
      : params.id
  );

  const req = useMemo(
    () =>
      requisicoesTecnicasMock.find(
        (r) => r.id === id
      ),
    [id]
  );

  const [ready, setReady] =
    useState(false);

  const [volumes, setVolumes] =
    useState<VolumeRequisicao[]>([]);

  const [lidos, setLidos] =
    useState<Record<number, string>>({});

  const [avs, setAvs] =
    useState<Record<string, any>>({});

  const [codigo, setCodigo] =
    useState("");

  const [msg, setMsg] =
    useState("");

  const [fim, setFim] =
    useState(false);

  /* =======================================================
     MODAL DIVERGÊNCIA
  ======================================================= */

  const [modal, setModal] =
    useState<Modal>(null);

  const [tipo, setTipo] =
    useState<TipoDivergenciaRecebimento>(
      "QUANTIDADE_DIVERGENTE"
    );

  const [decisao, setDecisao] =
    useState<
      Exclude<
        DecisaoRecebimento,
        "ACEITE_TOTAL"
      >
    >("ACEITE_PARCIAL");

  const [qr, setQr] =
    useState("0");

  const [qa, setQa] =
    useState("0");

  const [obs, setObs] =
    useState("");

  /*
   * NOVO:
   * seriais fisicamente recebidos.
   */
  const [
    seriaisRecebidos,
    setSeriaisRecebidos,
  ] = useState<string[]>([]);

  /*
   * NOVO:
   * seriais que o técnico decidiu aceitar.
   */
  const [
    seriaisAceitos,
    setSeriaisAceitos,
  ] = useState<string[]>([]);

  /* =======================================================
     HELPERS
  ======================================================= */

  const key = (
    v: number,
    i: number
  ) => `${v}:${i}`;

  function refresh() {
    if (!req) return;

    const e = obterEstado(req);

    setVolumes(
      e.volumes ?? []
    );

    setLidos(
      e.recebimentoTecnico
        ?.volumesLidos ?? {}
    );

    setAvs(
      e.recebimentoTecnico
        ?.itensConferidos ?? {}
    );
  }

  /* =======================================================
     INICIALIZAÇÃO
  ======================================================= */

  useEffect(() => {
    if (!req) {
      setReady(true);
      return;
    }

    try {
      iniciarRecebimentoTecnico(
        req
      );

      refresh();
    } catch (e) {
      setMsg(
        e instanceof Error
          ? e.message
          : "Erro."
      );
    } finally {
      setReady(true);
    }
  }, [req]);

  /* =======================================================
     TELAS DE ESTADO
  ======================================================= */

  if (!ready) {
    return (
      <Tela t="Carregando..." />
    );
  }

  if (!req) {
    return (
      <Tela t="Requisição não encontrada." />
    );
  }

  /* =======================================================
     RESUMO
  ======================================================= */

  const qtdLidos =
    volumes.filter(
      (v) =>
        !!lidos[v.id] ||
        v.status === "RECEBIDO"
    ).length;

  const faltam =
    volumes.length - qtdLidos;

  let total = 0;
  let avaliados = 0;
  let ok = 0;
  let div = 0;
  let aceitos = 0;
  let recusados = 0;
  let recusaVolume = false;

  volumes.forEach((v) => {
    if (
      !lidos[v.id] &&
      v.status !== "RECEBIDO"
    ) {
      return;
    }

    Object.values(
      v.itens ?? {}
    ).forEach((i) => {
      total++;

      const a =
        avs[
          key(
            v.id,
            i.itemId
          )
        ];

      if (!a) return;

      avaliados++;

      if (
        a.situacao === "OK"
      ) {
        ok++;
      } else {
        div++;
      }

      aceitos += Number(
        a.quantidadeAceita ??
          a.quantidadeRecebida ??
          0
      );

      recusados += Number(
        a.quantidadeRecusada ??
          0
      );

      if (
        a.decisao ===
        "RECUSA_VOLUME"
      ) {
        recusaVolume = true;
      }
    });
  });

  const pode =
    volumes.length > 0 &&
    faltam === 0 &&
    total > 0 &&
    avaliados === total &&
    !fim;

  const prod = (i: number) =>
    req.itens.find(
      (x) => x.id === i
    );

  const totalVol = (
    v: VolumeRequisicao
  ) =>
    Object.values(
      v.itens ?? {}
    ).reduce(
      (s, i) =>
        s +
        Number(
          i.quantidade || 0
        ),
      0
    );

  /* =======================================================
     LEITURA DO VOLUME
  ======================================================= */

  function ler() {
    try {
      if (!codigo.trim()) {
        throw new Error(
          "Leia ou informe o código do volume."
        );
      }

      const v =
        registrarVolumeRecebimentoTecnico(
          req!,
          codigo
        );

      setCodigo("");

      refresh();

      setMsg(
        `Volume ${v.codigo} lido. Confira os materiais antes do aceite.`
      );
    } catch (e) {
      setMsg(
        e instanceof Error
          ? e.message
          : "Erro ao ler volume."
      );
    }
  }

  /* =======================================================
     MATERIAL OK
  ======================================================= */

  function materialOk(
    v: number,
    i: number
  ) {
    try {
      marcarItemRecebimentoOk(
        req!,
        v,
        i
      );

      refresh();

      setMsg(
        "Material aceito integralmente."
      );
    } catch (e) {
      setMsg(
        e instanceof Error
          ? e.message
          : "Erro."
      );
    }
  }

  /* =======================================================
     ABRIR DIVERGÊNCIA
  ======================================================= */

  function abrir(
    v: VolumeRequisicao,
    i: number
  ) {
    const iv =
      v.itens[i];

    const p =
      prod(i);

    if (!iv || !p) {
      return;
    }

    const seriais =
      [
        ...(iv.seriais ?? []),
      ];

    setModal({
      volumeId: v.id,
      itemId: i,
      produto: p.produto,
      codigo:
        p.codigoProduto,
      unidade: p.unidade,
      esperado:
        iv.quantidade,
      seriais,
    });

    setTipo(
      "QUANTIDADE_DIVERGENTE"
    );

    setDecisao(
      "ACEITE_PARCIAL"
    );

    /*
     * Por padrão consideramos que
     * todo o material chegou.
     */
    setQr(
      String(
        iv.quantidade
      )
    );

    /*
     * Inicialmente todos os
     * seriais estão recebidos
     * e aceitos.
     */
    setSeriaisRecebidos(
      seriais
    );

    setSeriaisAceitos(
      seriais
    );

    /*
     * Para produto serializado
     * a quantidade aceita será
     * controlada pelos seriais.
     */
    if (
      seriais.length > 0
    ) {
      setQa(
        String(
          seriais.length
        )
      );
    } else {
      setQa(
        String(
          Math.max(
            iv.quantidade - 1,
            0
          )
        )
      );
    }

    setObs("");
  }

  /* =======================================================
     ALTERAR SERIAL ACEITO
  ======================================================= */

  function toggleSerialAceito(
    serial: string
  ) {
    setSeriaisAceitos(
      (atuais) => {
        const existe =
          atuais.includes(
            serial
          );

        const novos =
          existe
            ? atuais.filter(
                (s) =>
                  s !==
                  serial
              )
            : [
                ...atuais,
                serial,
              ];

        /*
         * QUANTIDADE ACEITA
         * acompanha automaticamente
         * os seriais selecionados.
         */
        setQa(
          String(
            novos.length
          )
        );

        return novos;
      }
    );
  }

  /* =======================================================
     DECISÃO ACEITE PARCIAL
  ======================================================= */

  function selecionarAceiteParcial() {
    setDecisao(
      "ACEITE_PARCIAL"
    );

    if (
      modal &&
      modal.seriais.length > 0
    ) {
      setQa(
        String(
          seriaisAceitos.length
        )
      );
    } else {
      setQa(qr);
    }
  }

  /* =======================================================
     RECUSAR ITEM
  ======================================================= */

  function selecionarRecusaItem() {
    setDecisao(
      "RECUSA_ITEM"
    );

    setQa("0");

    setSeriaisAceitos([]);
  }

  /* =======================================================
     RECUSAR VOLUME
  ======================================================= */

  function selecionarRecusaVolume() {
    setDecisao(
      "RECUSA_VOLUME"
    );

    setQa("0");

    setSeriaisAceitos([]);
  }

  /* =======================================================
     SALVAR DIVERGÊNCIA
  ======================================================= */

  function salvar() {
    if (!modal) return;

    try {
      const quantidadeRecebida =
        Number(
          qr.replace(
            ",",
            "."
          )
        );

      /*
       * PRODUTO SERIALIZADO:
       * quantidade aceita vem
       * exclusivamente dos seriais.
       */
      const quantidadeAceita =
        decisao ===
        "RECUSA_ITEM"
          ? 0
          : modal.seriais
                .length > 0
            ? seriaisAceitos.length
            : Number(
                qa.replace(
                  ",",
                  "."
                )
              );

      if (
        decisao ===
          "ACEITE_PARCIAL" &&
        quantidadeAceita >=
          quantidadeRecebida
      ) {
        throw new Error(
          "No aceite parcial deve existir pelo menos uma unidade recusada."
        );
      }

      if (
        quantidadeAceita >
        quantidadeRecebida
      ) {
        throw new Error(
          "A quantidade aceita não pode ser maior que a quantidade recebida."
        );
      }

      if (
        modal.seriais.length >
          0 &&
        seriaisAceitos.length >
          seriaisRecebidos.length
      ) {
        throw new Error(
          "Existem mais seriais aceitos do que seriais recebidos."
        );
      }

      if (
        decisao ===
        "RECUSA_VOLUME"
      ) {
        recusarVolumeRecebimento(
          req!,
          modal.volumeId,
          {
            tipo,
            observacao:
              obs,
          }
        );
      } else {
        marcarItemRecebimentoDivergencia(
          req!,
          modal.volumeId,
          modal.itemId,
          {
            tipo,

            decisao,

            quantidadeRecebida,

            quantidadeAceita,

            observacao: obs,

            seriaisRecebidos:
              seriaisRecebidos,

            seriaisAceitos:
              decisao ===
              "RECUSA_ITEM"
                ? []
                : seriaisAceitos,
          }
        );
      }

      setModal(null);

      refresh();

      setMsg(
        decisao ===
          "RECUSA_VOLUME"
          ? "Volume recusado. Todo o conteúdo ficará pendente de retorno ao CD."
          : decisao ===
              "RECUSA_ITEM"
            ? "Item recusado. Nenhuma unidade será aceita."
            : "Aceite parcial registrado."
      );
    } catch (e) {
      setMsg(
        e instanceof Error
          ? e.message
          : "Erro ao registrar decisão."
      );
    }
  }

  /* =======================================================
     FINALIZAR
  ======================================================= */

  function finalizar() {
    try {
      setFim(true);

      finalizarRecebimentoTecnico(
        req!
      );

      setMsg(
        div
          ? "Recebimento finalizado com divergência/recusa."
          : "Recebimento confirmado."
      );

      setTimeout(
        () =>
          router.push(
            "/coletor/recebimento"
          ),
        900
      );
    } catch (e) {
      setFim(false);

      setMsg(
        e instanceof Error
          ? e.message
          : "Erro ao finalizar."
      );
    }
  }

  /* =======================================================
     RENDER
  ======================================================= */

  return (
    <div className="collector-screen">
      <div
        className="collector-phone"
        style={{
          position: "relative",
        }}
      >
        {/* =================================================
            HEADER
        ================================================= */}

        <div className="collector-header">
          <div className="collector-header-title">
            <button
              className="collector-back-button"
              onClick={() =>
                router.push(
                  "/coletor/recebimento"
                )
              }
            >
              ‹
            </button>

            <div>
              <strong>
                #
                {req.codigo.replace(
                  "REQ-",
                  ""
                )}
              </strong>

              <div
                style={{
                  fontSize: 10,
                }}
              >
                {req.tecnico.toUpperCase()}
              </div>

              <div
                style={{
                  fontSize: 9,
                }}
              >
                {req.codigoTecnico} •{" "}
                {req.base}
              </div>
            </div>
          </div>

          <span
            style={{
              fontSize: 22,
            }}
          >
            ⋮
          </span>
        </div>

        {/* =================================================
            BODY
        ================================================= */}

        <div
          className="collector-operation-body"
          style={{
            flex: 1,
            minHeight: 0,
            overflowY: "auto",
            paddingBottom: 110,
          }}
        >
          <section className="collector-section">
            <div className="collector-section-title">
              <span>
                Recebimento de Volumes
              </span>

              <span>✓</span>
            </div>

            <div style={info}>
              Material em trânsito
              para{" "}
              {req.codigoTecnico}
            </div>

            {/* =============================================
                CONTADORES
            ============================================= */}

            <div className="collector-quantity-grid">
              <div>
                <span>
                  Esperados
                </span>

                <strong>
                  {volumes.length}
                </strong>
              </div>

              <div>
                <span>
                  Lidos
                </span>

                <strong>
                  {qtdLidos}
                </strong>
              </div>

              <div>
                <span>
                  Faltam
                </span>

                <strong>
                  {faltam}
                </strong>
              </div>
            </div>

            {/* =============================================
                DESTINO
            ============================================= */}

            <div style={box}>
              <div style={lab}>
                DESTINO
              </div>

              <b
                style={{
                  fontSize: 16,
                }}
              >
                {req.tecnico}
              </b>

              <div
                style={{
                  color:
                    "#087da7",
                  fontSize: 12,
                  fontWeight: 700,
                }}
              >
                {req.codigoTecnico} •{" "}
                {req.base}
              </div>

              <div
                style={{
                  marginTop: 8,
                  fontSize: 11,
                  color:
                    "#64748b",
                }}
              >
                Origem:{" "}
                {req.origem ||
                  "CD FORTALEZA"}
                <br />

                Tipo: {req.tipo}
              </div>
            </div>

            {/* =============================================
                LEITURA
            ============================================= */}

            <div
              style={{
                marginTop: 16,
                marginBottom: 7,
                fontSize: 11,
                fontWeight: 800,
              }}
            >
              LEITURA DO VOLUME
            </div>

            <div className="collector-input-action">
              <input
                value={codigo}
                onChange={(e) =>
                  setCodigo(
                    e.target.value
                  )
                }
                placeholder="Código do volume"
                onKeyDown={(e) =>
                  e.key ===
                    "Enter" &&
                  ler()
                }
              />

              <button
                onClick={ler}
              >
                ✓
              </button>
            </div>

            {/* =============================================
                VOLUMES
            ============================================= */}

            {volumes.map(
              (v) => {
                const vl =
                  !!lidos[v.id] ||
                  v.status ===
                    "RECEBIDO";

                const itens =
                  Object.values(
                    v.itens ?? {}
                  );

                const vr =
                  itens.length >
                    0 &&
                  itens.every(
                    (i) =>
                      avs[
                        key(
                          v.id,
                          i.itemId
                        )
                      ]?.decisao ===
                      "RECUSA_VOLUME"
                  );

                return (
                  <div
                    key={v.id}
                    style={{
                      marginTop: 10,

                      border: `1.5px solid ${
                        vr
                          ? "#c0392b"
                          : vl
                            ? "#22a06b"
                            : "#cbd5e1"
                      }`,

                      borderRadius: 8,

                      overflow:
                        "hidden",

                      background:
                        "#fff",
                    }}
                  >
                    {/* =====================================
                        CABEÇALHO VOLUME
                    ===================================== */}

                    <div
                      style={{
                        padding: 11,

                        display:
                          "flex",

                        justifyContent:
                          "space-between",

                        alignItems:
                          "center",
                      }}
                    >
                      <div>
                        <b
                          style={{
                            fontSize:
                              12,
                          }}
                        >
                          {v.codigo}
                        </b>

                        <div
                          style={{
                            fontSize:
                              10,

                            color:
                              "#64748b",

                            marginTop:
                              4,
                          }}
                        >
                          {
                            itens.length
                          }{" "}
                          SKU(s) •{" "}
                          {totalVol(
                            v
                          )}{" "}
                          unidades
                        </div>
                      </div>

                      <span
                        style={{
                          padding:
                            "5px 8px",

                          borderRadius:
                            12,

                          fontSize:
                            9,

                          fontWeight:
                            900,

                          background:
                            vr
                              ? "#fee4e2"
                              : vl
                                ? "#dff4e9"
                                : "#e9f7fc",

                          color:
                            vr
                              ? "#b42318"
                              : vl
                                ? "#07864c"
                                : "#087da7",
                        }}
                      >
                        {vr
                          ? "✕ RECUSADO"
                          : vl
                            ? "✓ LIDO"
                            : "AGUARDANDO"}
                      </span>
                    </div>

                    {/* =====================================
                        SIMULAR LEITURA
                    ===================================== */}

                    {!vl && (
                      <button
                        className="collector-demo-fill"
                        onClick={() =>
                          setCodigo(
                            v.codigo
                          )
                        }
                        style={{
                          margin:
                            "0 11px 11px",
                        }}
                      >
                        Simular leitura:{" "}
                        {v.codigo}
                      </button>
                    )}

                    {/* =====================================
                        ITENS
                    ===================================== */}

                    {vl && (
                      <div>
                        <div
                          style={{
                            padding:
                              "9px 11px",

                            background:
                              "#edf8fc",

                            color:
                              "#087da7",

                            fontSize:
                              10,

                            fontWeight:
                              900,
                          }}
                        >
                          CONTEÚDO PARA
                          CONFERÊNCIA
                        </div>

                        {itens.map(
                          (iv) => {
                            const p =
                              prod(
                                iv.itemId
                              );

                            if (!p) {
                              return null;
                            }

                            const a =
                              avs[
                                key(
                                  v.id,
                                  iv.itemId
                                )
                              ];

                            const isOk =
                              a?.situacao ===
                              "OK";

                            return (
                              <div
                                key={
                                  iv.itemId
                                }
                                style={{
                                  padding:
                                    11,

                                  borderBottom:
                                    "1px solid #e5e7eb",

                                  background:
                                    isOk
                                      ? "#f4fbf7"
                                      : a
                                        ? "#fffaf0"
                                        : "#fff",
                                }}
                              >
                                <div
                                  style={{
                                    display:
                                      "flex",

                                    justifyContent:
                                      "space-between",

                                    gap: 10,
                                  }}
                                >
                                  <div>
                                    <b
                                      style={{
                                        fontSize:
                                          12,
                                      }}
                                    >
                                      {
                                        p.produto
                                      }
                                    </b>

                                    <div
                                      style={{
                                        color:
                                          "#087da7",

                                        fontSize:
                                          10,

                                        fontWeight:
                                          800,
                                      }}
                                    >
                                      {
                                        p.codigoProduto
                                      }
                                    </div>
                                  </div>

                                  <div
                                    style={{
                                      textAlign:
                                        "right",
                                    }}
                                  >
                                    <span
                                      style={
                                        lab
                                      }
                                    >
                                      ESPERADO
                                    </span>

                                    <b
                                      style={{
                                        display:
                                          "block",

                                        fontSize:
                                          14,
                                      }}
                                    >
                                      {
                                        iv.quantidade
                                      }{" "}
                                      {
                                        p.unidade
                                      }
                                    </b>
                                  </div>
                                </div>

                                {/* =========================
                                    SERIAIS ESPERADOS
                                ========================= */}

                                {p.controlaSerie &&
                                  iv.seriais &&
                                  iv.seriais
                                    .length >
                                    0 && (
                                    <div
                                      style={{
                                        marginTop:
                                          8,

                                        padding:
                                          8,

                                        background:
                                          "#f8fafc",

                                        border:
                                          "1px solid #e2e8f0",

                                        borderRadius:
                                          5,
                                      }}
                                    >
                                      <div
                                        style={
                                          lab
                                        }
                                      >
                                        SERIAIS
                                        ESPERADOS
                                      </div>

                                      {iv.seriais.map(
                                        (
                                          s
                                        ) => (
                                          <div
                                            key={
                                              s
                                            }
                                            style={{
                                              fontSize:
                                                10,

                                              marginTop:
                                                4,
                                            }}
                                          >
                                            •{" "}
                                            {
                                              s
                                            }
                                          </div>
                                        )
                                      )}
                                    </div>
                                  )}

                                {/* =========================
                                    RESULTADO
                                ========================= */}

                                {a && (
                                  <div
                                    style={{
                                      marginTop:
                                        8,

                                      padding:
                                        7,

                                      borderRadius:
                                        5,

                                      background:
                                        isOk
                                          ? "#eaf8f0"
                                          : "#fff1cc",

                                      color:
                                        isOk
                                          ? "#07864c"
                                          : "#9a6700",

                                      fontSize:
                                        10,

                                      fontWeight:
                                        800,

                                      lineHeight:
                                        1.4,
                                    }}
                                  >
                                    {isOk ? (
                                      `✓ ACEITE TOTAL • ${a.quantidadeAceita} ${p.unidade}`
                                    ) : (
                                      <>
                                        ⚠{" "}
                                        {rotulo(
                                          a.decisao
                                        )}
                                        <br />

                                        Recebido:{" "}
                                        {
                                          a.quantidadeRecebida
                                        }{" "}
                                        •
                                        Aceito:{" "}
                                        {
                                          a.quantidadeAceita
                                        }{" "}
                                        •
                                        Recusado:{" "}
                                        {
                                          a.quantidadeRecusada
                                        }{" "}
                                        {
                                          p.unidade
                                        }
                                      </>
                                    )}
                                  </div>
                                )}

                                {/* =========================
                                    BOTÕES
                                ========================= */}

                                {!vr && (
                                  <div
                                    style={{
                                      display:
                                        "flex",

                                      gap: 7,

                                      marginTop:
                                        9,
                                    }}
                                  >
                                    <button
                                      onClick={() =>
                                        materialOk(
                                          v.id,
                                          iv.itemId
                                        )
                                      }
                                      style={
                                        btnOk
                                      }
                                    >
                                      {isOk
                                        ? "✓ ACEITO"
                                        : "✓ MATERIAL OK"}
                                    </button>

                                    <button
                                      onClick={() =>
                                        abrir(
                                          v,
                                          iv.itemId
                                        )
                                      }
                                      style={
                                        btnDiv
                                      }
                                    >
                                      ⚠
                                      DIVERGÊNCIA
                                    </button>
                                  </div>
                                )}
                              </div>
                            );
                          }
                        )}
                      </div>
                    )}
                  </div>
                );
              }
            )}

            {/* =============================================
                RESUMO
            ============================================= */}

            {qtdLidos > 0 && (
              <div style={box}>
                <b
                  style={{
                    fontSize: 10,
                  }}
                >
