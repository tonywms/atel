<file path="app/coletor/embarque/[id]/page.tsx">
"use client";

import {
  useEffect,
  useMemo,
  useState,
} from "react";

import {
  useParams,
  useRouter,
} from "next/navigation";

import {
  requisicoesTecnicasMock,
} from "@/lib/requisicoesTecnicas";

import {
  finalizarEmbarque,
  iniciarEmbarque,
  obterEstado,
  registrarVolumeEmbarque,
  VolumeRequisicao,
} from "@/lib/requisicoesStore";

export default function EmbarqueDetalhePage() {
  const params =
    useParams();

  const router =
    useRouter();

  const idParam =
    params.id;

  const id =
    Number(
      Array.isArray(idParam)
        ? idParam[0]
        : idParam
    );

  const requisicao =
    useMemo(
      () =>
        requisicoesTecnicasMock.find(
          (req) =>
            req.id === id
        ),
      [id]
    );

  const [carregado, setCarregado] =
    useState(false);

  const [volumes, setVolumes] =
    useState<VolumeRequisicao[]>(
      []
    );

  const [codigoLido, setCodigoLido] =
    useState("");

  const [mensagem, setMensagem] =
    useState("");

  const [finalizando, setFinalizando] =
    useState(false);

  function atualizar() {
    if (!requisicao) {
      return;
    }

    const estado =
      obterEstado(
        requisicao
      );

    setVolumes(
      estado.volumes ?? []
    );
  }

  useEffect(() => {
    if (!requisicao) {
      setCarregado(true);
      return;
    }

    try {
      const estado =
        iniciarEmbarque(
          requisicao
        );

      setVolumes(
        estado.volumes ?? []
      );
    } catch (error) {
      setMensagem(
        error instanceof Error
          ? error.message
          : "Não foi possível iniciar o embarque."
      );
    } finally {
      setCarregado(true);
    }
  }, [requisicao]);

  if (!carregado) {
    return (
      <TelaMensagem
        texto="Carregando..."
      />
    );
  }

  if (!requisicao) {
    return (
      <TelaMensagem
        texto="Requisição não encontrada."
      />
    );
  }

  const requisicaoSeguro = requisicao;

  const volumesLidos =
    volumes.filter(
      (volume) =>
        volume.status ===
          "EMBARCADO" ||
        volume.status ===
          "EM_TRANSITO" ||
        volume.status ===
          "RECEBIDO"
    );

  const faltam =
    Math.max(
      volumes.length -
        volumesLidos.length,
      0
    );

  const todosLidos =
    volumes.length > 0 &&
    faltam === 0;

  function lerVolume() {
    const codigo =
      codigoLido
        .trim()
        .toUpperCase();

    if (!codigo) {
      setMensagem(
        "Leia ou informe o código do volume."
      );
      return;
    }

    try {
      const volume =
        registrarVolumeEmbarque(
          requisicaoSeguro,
          codigo
        );

      atualizar();

      setCodigoLido("");

      setMensagem(
        `✓ ${volume.codigo} conferido para embarque.`
      );
    } catch (error) {
      setMensagem(
        error instanceof Error
          ? error.message
          : "Não foi possível registrar o volume."
      );
    }
  }

  function concluir() {
    try {
      setFinalizando(true);

      finalizarEmbarque(
        requisicaoSeguro
      );

      setMensagem(
        "Embarque finalizado. Material em trânsito para o técnico."
      );

      window.setTimeout(
        () => {
          router.push(
            "/coletor/embarque"
          );
        },
        700
      );
    } catch (error) {
      setFinalizando(false);

      setMensagem(
        error instanceof Error
          ? error.message
          : "Não foi possível finalizar o embarque."
      );
    }
  }

  const primeiroPendente =
    volumes.find(
      (volume) =>
        volume.status ===
        "FECHADO"
    );

  return (
    <div className="collector-screen">
      <div
        className="collector-phone"
        style={{
          background: "#f4f4f4",
          overflow: "hidden",
        }}
      >
        <div
          style={{
            height: 40,
            background: "#000",
            flex: "0 0 auto",
          }}
        />

        <div
          style={{
            minHeight: 76,
            background: "#168bb2",
            color: "#fff",
            display: "flex",
            alignItems: "center",
            gap: 12,
            padding: "0 16px",
            flex: "0 0 auto",
          }}
        >
          <button
            type="button"
            onClick={() =>
              router.push(
                "/coletor/embarque"
              )
            }
            style={{
              border: 0,
              background:
                "transparent",
              color: "#fff",
              fontSize: 34,
              padding: 0,
              cursor: "pointer",
            }}
          >
            ‹
          </button>

          <div
            style={{
              flex: 1,
              lineHeight: 1,
            }}
          >
            <div
              style={{
                fontSize: 22,
                fontWeight: 900,
              }}
            >
              #
              {requisicaoSeguro.codigo.replace(
                "REQ-",
                ""
              )}
            </div>

            <div
              style={{
                marginTop: 3,
                fontSize: 10,
                fontWeight: 800,
              }}
            >
              {requisicaoSeguro.tecnico.toUpperCase()}
            </div>

            <div
              style={{
                marginTop: 2,
                fontSize: 9,
              }}
            >
              {requisicaoSeguro.codigoTecnico} •{" "}
              {requisicaoSeguro.base}
            </div>
          </div>

          <span
            style={{
              fontSize: 24,
            }}
          >
            ⋮
          </span>
        </div>

        <div
          style={{
            flex: 1,
            minHeight: 0,
            overflowY: "auto",
            overflowX: "hidden",
            padding:
              "12px 12px 120px",
          }}
        >
          <section
            style={cardStyle}
          >
            <div
              style={
                tituloStyle
              }
            >
              Embarque de Volumes

              <span
                style={
                  iconeStyle
                }
              >
                ▤
              </span>
            </div>

            <div
              style={{
                marginTop: 14,
                padding:
                  "10px 12px",
                borderRadius: 6,
                background:
                  "#e8f6fb",
                color: "#087da7",
                fontSize: 11,
                fontWeight: 800,
              }}
            >
              Conferência finalizada.
