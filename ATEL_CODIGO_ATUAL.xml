/* =========================================================

   CRIAR VOLUME

========================================================= */



export function criarVolume(

  requisicao: RequisicaoTecnica

) {

  const estados =

    carregarEstados();



  const atual =

    normalizarEstado(

      estados[

        requisicao.id

      ] ??

        criarEstadoInicial(

          requisicao

        )

    );



  if (

    atual.status !==

      "EM_CONFERENCIA" &&

    atual.status !==

      "CONFERIDA"

  ) {

    throw new Error(

      "O volume somente pode ser criado durante a conferência."

    );

  }



  /*

   * Não deixa criar outro volume

   * enquanto existir um aberto.

   */

  const volumeAberto =

    atual.volumes.find(

      (volume) =>

        volume.status ===

        "ABERTO"

    );



  if (volumeAberto) {

    return volumeAberto;

  }



  const id =

    proximoIdVolume(

      atual

    );



  const volume: VolumeRequisicao =

    {

      id,



      codigo:

        gerarCodigoVolume(

          requisicao,

          id

        ),



      status: "ABERTO",



      itens: {},



      criadoEm:

        new Date().toISOString(),

    };



  atual.volumes.push(

    volume

  );



  estados[requisicao.id] =

    atual;



  salvarEstados(estados);



  return volume;

}



/* =========================================================

   ADICIONAR ITEM AO VOLUME

========================================================= */



export function adicionarItemAoVolume(

  requisicao: RequisicaoTecnica,

  volumeId: number,

  itemId: number,

  quantidade: number,

  seriais: string[] = []

) {

  const estados =

    carregarEstados();



  const atual =

    normalizarEstado(

      estados[

        requisicao.id

      ] ??

        criarEstadoInicial(

          requisicao

        )

    );



  const volume =

    atual.volumes.find(

      (item) =>

        item.id ===

        volumeId

    );



  if (!volume) {

    throw new Error(

      "Volume não encontrado."

    );

  }



  if (

    volume.status !==

    "ABERTO"

  ) {

    throw new Error(

      "O volume já está fechado."

    );

  }



  const conferencia =

    atual.conferencia[

      itemId

    ];



  if (!conferencia) {

    throw new Error(

      "O produto precisa estar conferido antes de ser colocado no volume."

    );

  }



  if (quantidade <= 0) {

    throw new Error(

      "Informe uma quantidade válida para o volume."

    );

  }



  /*

   * Soma quanto deste produto já foi colocado

   * em OUTROS volumes.

   */

  const quantidadeEmOutrosVolumes =

    atual.volumes.reduce(

      (

        total,

        volumeAtual

      ) => {

        if (

          volumeAtual.id ===

          volumeId

        ) {

          return total;

        }



        return (

          total +

          (volumeAtual.itens[

            itemId

          ]?.quantidade ??

            0)

        );

      },

      0

    );



  const disponivel =

    conferencia.quantidadeConferida -

    quantidadeEmOutrosVolumes;



  if (

    quantidade >

    disponivel

  ) {

    throw new Error(

      `Quantidade maior que o saldo conferido disponível para volume. Disponível: ${disponivel}.`

    );

  }



  /*

   * Para produto serializado:

   * impede serial duplicado entre volumes.

   */

  if (

    seriais.length > 0

  ) {

    const seriaisConferidos =

      conferencia.seriais ?? [];



    for (

      const serial of seriais

    ) {

      if (

        !seriaisConferidos.includes(

          serial

        )

      ) {

        throw new Error(

          `O serial ${serial} não foi conferido.`

        );

      }



      const serialJaUsado =

        atual.volumes.some(

          (volumeAtual) =>

            volumeAtual.id !==

              volumeId &&

            Object.values(

              volumeAtual.itens

            ).some((item) =>

              item.seriais.includes(

                serial

              )

            )

        );



      if (serialJaUsado) {

        throw new Error(

          `O serial ${serial} já pertence a outro volume.`

        );

      }

    }

  }



  volume.itens[itemId] = {

    itemId,



    quantidade,



    seriais: [

      ...seriais,

    ],

  };



  estados[requisicao.id] =

    atual;



  salvarEstados(estados);



  return volume;

}



/* =========================================================

   REMOVER ITEM DO VOLUME

========================================================= */



export function removerItemDoVolume(

  requisicao: RequisicaoTecnica,

  volumeId: number,

  itemId: number

) {

  const estados =

    carregarEstados();



  const atual =

    normalizarEstado(

      estados[

        requisicao.id

      ] ??

        criarEstadoInicial(

          requisicao

        )

    );



  const volume =

    atual.volumes.find(

      (item) =>

        item.id ===

        volumeId

    );



  if (!volume) {

    throw new Error(

      "Volume não encontrado."

    );

  }



  if (

    volume.status !==

    "ABERTO"

  ) {

    throw new Error(

      "Não é possível alterar um volume fechado."

    );

  }



  delete volume.itens[

    itemId

  ];



  estados[requisicao.id] =

    atual;



  salvarEstados(estados);



  return volume;

}



/* =========================================================

   FECHAR VOLUME

========================================================= */



export function fecharVolume(

  requisicao: RequisicaoTecnica,

  volumeId: number

) {

  const estados =

    carregarEstados();



  const atual =

    normalizarEstado(

      estados[

        requisicao.id

      ] ??

        criarEstadoInicial(

          requisicao

        )

    );



  const volume =

    atual.volumes.find(

      (item) =>

        item.id ===

        volumeId

    );



  if (!volume) {

    throw new Error(

      "Volume não encontrado."

    );

  }



  if (

    volume.status ===

    "FECHADO"

  ) {

    return volume;

  }



  if (

    volume.status !==

    "ABERTO"

  ) {

    throw new Error(

      "O volume não pode mais ser fechado."

    );

  }



  if (

    Object.keys(

      volume.itens

    ).length === 0

  ) {

    throw new Error(

      "O volume precisa possuir pelo menos um produto."

    );

  }



  volume.status =

    "FECHADO";



  volume.fechadoEm =

    new Date().toISOString();



  estados[requisicao.id] =

    atual;



  salvarEstados(estados);



  return volume;

}



