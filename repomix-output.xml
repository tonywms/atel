<file path="lib/ordensServicoStore.ts">
"use client";

import {
  baixarEstoqueTecnico,
  carregarEstoqueTecnico,
} from "@/lib/estoqueTecnicoStore";

/* =========================================================
   TIPOS
========================================================= */

export type TipoOrdemServico =
  | "INSTALACAO"
  | "MANUTENCAO"
  | "TROCA"
  | "RETIRADA";

export type StatusOrdemServico =
  | "PENDENTE"
  | "EM_ATENDIMENTO"
  | "FINALIZADA"
  | "CANCELADA";

export type DestinoMaterialOS =
  | "COMODATO"
  | "VENDA"
  | "CONSUMO";

export type ItemOrdemServico = {
  id: number;

  codigoProduto: string;
  produto: string;
  unidade: string;

  quantidade: number;

  serialObrigatorio: boolean;
  seriais: string[];

  destino: DestinoMaterialOS;
};

export type OrdemServico = {
  id: number;
  codigo: string;

  tipo: TipoOrdemServico;
  status: StatusOrdemServico;

  codigoTecnico: string;
  tecnico: string;
  base: string;

  codigoCliente: string;
  cliente: string;

  endereco: string;
  cidade: string;

  dataPrevista: string;

  observacao?: string;

  iniciadoEm?: string;
  finalizadoEm?: string;

  itens: ItemOrdemServico[];
};

export type PatrimonioCliente = {
  id: string;

  codigoCliente: string;
  cliente: string;

  ordemServico: string;

  codigoProduto: string;
  produto: string;

  serial: string;

  quantidade: number;

  tipo: "COMODATO" | "VENDA";

  tecnico: string;
  codigoTecnico: string;

  instaladoEm: string;

  retiradoEm?: string;
  ordemRetirada?: string;
  retiradoPorTecnico?: string;
  retiradoPorCodigoTecnico?: string;

  status:
    | "INSTALADO"
    | "VENDIDO"
    | "RETIRADO";
};

/* =========================================================
   STORAGE
========================================================= */

const STORAGE_OS =
  "wms-expert-ordens-servico";

const STORAGE_PATRIMONIO =
  "wms-expert-patrimonio-cliente";

const EVENTO_OS =
  "wms-ordens-servico-update";

/* =========================================================
   HELPERS
========================================================= */

function podeUsarStorage() {
  return typeof window !== "undefined";
}

function ler<T>(
  chave: string,
  padrao: T
): T {
  if (!podeUsarStorage()) {
    return padrao;
  }

  try {
    const valor =
      localStorage.getItem(chave);

    return valor
      ? (JSON.parse(valor) as T)
      : padrao;
  } catch {
    return padrao;
  }
}

function salvar<T>(
  chave: string,
  valor: T
) {
  if (!podeUsarStorage()) {
    return;
  }

  localStorage.setItem(
    chave,
    JSON.stringify(valor)
  );
}

function disparar() {
  if (!podeUsarStorage()) {
    return;
  }

  window.dispatchEvent(
    new CustomEvent(EVENTO_OS)
  );
}

/* =========================================================
