  );
}

function ResolutionOption({
  active,
  icon,
  title,
  description,
  onClick,
}: {
  active: boolean;
  icon: string;
  title: string;
  description: string;
  onClick: () => void;
}) {
  return (
    <button
      type="button"
      onClick={onClick}
      style={{
        ...resolutionOption,

        borderColor:
          active
            ? "#009fe3"
            : "#d0d8dd",

        background:
          active
            ? "#edf9fd"
            : "#ffffff",
      }}
    >
      <div
        style={{
          ...resolutionIcon,

          background:
            active
              ? "#009fe3"
              : "#edf1f3",

          color:
            active
              ? "#ffffff"
              : "#667085",
        }}
      >
        {icon}
      </div>

      <div>
        <strong>
          {title}
        </strong>

        <span>
          {description}
        </span>
      </div>
    </button>
  );
}

/* =========================================================
   FORMATADORES
========================================================= */

function formatarTexto(
  valor: string
) {
  return valor
    .replaceAll("_", " ")
    .toLowerCase()
    .replace(
      /(^|\s)\S/g,
      (letra) =>
        letra.toUpperCase()
    );
}

function formatarSolucao(
  valor?: SolucaoPendenciaRetorno
) {
  if (
    valor === "DISPONIVEL"
  ) {
    return "Estoque disponÃ­vel";
  }

  if (
    valor === "QUARENTENA"
  ) {
    return "Quarentena";
  }

  if (
    valor === "BAIXA"
  ) {
    return "Ajuste / baixa";
  }

  return "-";
}

function formatarData(
  valor?: string
) {
  if (!valor) {
    return "-";
  }

  return new Intl.DateTimeFormat(
    "pt-BR",
    {
      dateStyle: "short",
      timeStyle: "short",
    }
  ).format(
    new Date(valor)
  );
}

