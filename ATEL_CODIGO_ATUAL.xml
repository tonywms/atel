/* =========================================================
   COLETOR - MODO APRESENTAÇÃO FIXO
   Referência visual: 393 x 852
   ========================================================= */

html,
body {
  height: 100%;
}

/* A rota do coletor não gera scroll na página */
body:has(.collector-app) {
  overflow: hidden;
}

.collector-app {
  width: 100%;
  height: 100vh;
  min-height: 0;
  overflow: hidden;
  background: #e8eef5;
}

/*
  Área disponível para apresentação.
  O coletor sempre fica inteiro na tela.
*/
.collector-screen {
  width: 100%;
  height: 100vh;
  min-height: 0;

  display: flex;
  align-items: center;
  justify-content: center;

  overflow: hidden;

  background: #e8eef5;

  padding: 12px;
}

/*
  Nosso "dispositivo".
  Não usamos mais 720px.
*/
.collector-phone {
  width: 393px;
  height: min(852px, calc(100vh - 24px));

  min-height: 0;
  max-width: none;

  position: relative;

  display: flex;
  flex-direction: column;

  overflow: hidden;

  background: #f4f4f4;

  box-shadow:
    0 8px 30px rgba(21, 55, 74, 0.15);

  flex-shrink: 0;
}

/* =========================================================
   HEADER
   ========================================================= */

.collector-header {
  min-height: 76px;
  height: 76px;

  flex-shrink: 0;

  background: #1584ad;
  color: white;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 0 24px;
}

.collector-header-title {
  display: flex;
  align-items: center;
  gap: 13px;

  font-size: 25px;
}

.collector-back,
.collector-back-button {
  font-size: 43px;
  line-height: 1;
}

.collector-filter {
  font-size: 26px;
}

/* =========================================================
   CABEÇALHO DA REQUISIÇÃO
   ========================================================= */

.collector-order-info {
  flex-shrink: 0;

  background: white;

  padding: 14px 14px 13px;

  border-bottom: 1px solid #ddd;
}

.collector-order-line {
  display: grid;
  grid-template-columns: 1.4fr .7fr .9fr;
  gap: 7px;

  font-size: 15px;
}

.collector-order-technician {
  margin-top: 8px;
  font-size: 15px;
}

.collector-order-destination {
  margin-top: 4px;

  color: #1484ad;

  font-size: 12px;
  font-weight: 700;
}

/* =========================================================
   ÁREA OPERACIONAL
   ÚNICO LOCAL QUE PODE TER SCROLL
   ========================================================= */

.collector-operation-body {
  flex: 1;
  min-height: 0;

  overflow-y: auto;
  overflow-x: hidden;

  padding: 15px 18px 16px;

  scrollbar-width: thin;
}

/* =========================================================
   CARDS
   ========================================================= */

.collector-section {
  border: 1.5px solid #078bc0;
  border-radius: 17px;

  background: white;

  padding: 19px 20px;

  margin-bottom: 14px;
}

.collector-section-title {
  color: #0784b4;

  font-size: 20px;
  line-height: 1.1;

  font-weight: 700;

  display: flex;
  justify-content: space-between;
  align-items: center;
}

.collector-section-title span {
  width: 44px;
  height: 44px;

  flex-shrink: 0;

  border-radius: 50%;

  background: #1685ad;
  color: white;

  display: grid;
  place-items: center;

  font-size: 18px;
}

/* =========================================================
   ENDEREÇO
   ========================================================= */

.collector-address-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);

  gap: 10px;

  margin: 12px 0;
}

.collector-address {
  height: 83px;

  border: 1.5px solid #078bc0;
  border-radius: 11px;

  padding: 7px;

  color: #0784ad;
}

.collector-address.active {
  color: white;
  background: #1685ad;
}

.collector-address span {
  display: block;

  font-size: 16px;
  font-weight: 700;
}

.collector-address strong {
  display: block;

  text-align: center;

  font-size: 20px;

  margin-top: 10px;
}

/* =========================================================
   INPUTS
   ========================================================= */

.collector-input-action {
  height: 48px;

  display: flex;

  border: 1px solid #bbb;
  border-radius: 6px;

  overflow: hidden;
}

.collector-input-action input {
  flex: 1;
  min-width: 0;

  border: 0;
  outline: 0;

  padding: 0 13px;

  font-size: 14px;
}

.collector-input-action button {
  width: 92px;

  border: 0;

  background: #1685ad;
  color: white;

  font-size: 18px;
}

.collector-demo-fill {
  margin-top: 6px;

  border: 0;
  background: transparent;

  color: #1685ad;

  font-size: 9px;
  font-weight: 700;
}

/* =========================================================
   PRODUTO
   ========================================================= */

.collector-product-description {
  margin-top: 13px;

  font-size: 17px;
  line-height: 1.2;

  font-weight: 700;
}

.collector-product-code {
  color: #888;

  font-size: 14px;

  margin: 5px 0 11px;
}

/* =========================================================
   QUANTIDADES
   ========================================================= */

.collector-quantity-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);

  gap: 12px;

  margin-top: 17px;
}

.collector-quantity-grid span {
  display: block;

  color: #888;

  font-size: 13px;
  font-weight: 700;
}

.collector-quantity-grid strong {
  display: block;

  margin-top: 6px;

  padding: 6px;

  border: 1px solid #bbb;
  border-radius: 5px;

  font-size: 15px;
}

/* =========================================================
   SERIAL
   ========================================================= */

.collector-serial-area {
  margin-top: 15px;
  padding-top: 13px;

  border-top: 1px solid #ddd;
}

.collector-serial-area label {
  margin-bottom: 6px;

  font-size: 13px;
}

.collector-serial-counter {
  margin-top: 7px;

  font-size: 11px;
}

.collector-serial-item {
  margin-top: 5px;

  padding: 6px 8px;

  font-size: 10px;
}

/* =========================================================
   BOTÕES INTERNOS
   ========================================================= */

.collector-full-quantity,
.collector-confirm-item {
  width: 100%;
  height: 42px;

  margin-top: 14px;

  border: 0;
  border-radius: 6px;

  background: #1685ad;
  color: white;

  font-size: 11px;
  font-weight: 800;
}

.collector-message {
  padding: 8px 10px;

  font-size: 11px;
}

/* =========================================================
   FOOTER FIXO DO COLETOR
   ========================================================= */

.collector-operation-footer {
  position: relative;

  bottom: auto;
  left: auto;
  right: auto;

  flex-shrink: 0;

  height: 64px;

  display: grid;
  grid-template-columns: 1fr 66px 1fr;

  background: white;

  z-index: 10;
}

.collector-cut,
.collector-next {
  border: 0;

  color: white;

  font-size: 17px;
}

.collector-cut {
  background: #e52529;
}

.collector-next {
  background: #1685ad;
}

.collector-lock {
  width: 70px;
  height: 70px;

  margin-top: -6px;
  margin-left: -2px;

  background: white;

  border-radius: 50%;

  display: grid;
  place-items: center;

  font-size: 23px;

  z-index: 3;
}

/* =========================================================
   LISTA DE REQUISIÇÕES
   ========================================================= */

.collector-search-area {
  flex-shrink: 0;

  padding: 12px 12px 7px;
}

.collector-search-box {
  height: 56px;

  border-radius: 18px;

  padding: 0 15px;
}

.collector-search-box span {
  font-size: 24px;

  margin-right: 12px;
}

.collector-search-box input {
  font-size: 16px;
}

.collector-context {
  flex-shrink: 0;

  margin: 3px 12px 7px;
}

.collector-request-list {
  flex: 1;
  min-height: 0;

  overflow-y: auto;

  padding: 2px 7px 10px;
}

.collector-request-card {
  min-height: 165px;

  margin: 6px 0;

  border-radius: 13px;
}

.collector-card-strip {
  width: 47px;
}

.collector-card-content {
  padding: 10px 11px 8px;
}

.collector-card-header strong {
  font-size: 17px;
}

.collector-technician {
  font-size: 14px;

  margin: 6px 0;
}

.collector-card-row {
  font-size: 12px;

  margin: 3px 0;
}

.collector-card-numbers {
  margin-top: 6px;

  font-size: 12px;
}

.collector-card-footer {
  margin-top: 7px;
}

.collector-bottom-info {
  flex-shrink: 0;

  margin-top: 0;

  padding: 8px;

  font-size: 10px;
}

/* =========================================================
   TELAS MENORES
   Escala o "aparelho" sem alterar o layout interno.
