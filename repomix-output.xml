"use client";

import { useEffect, useMemo, useState } from "react";
import { useRouter } from "next/navigation";

import {
  requisicoesTecnicasMock,
  RequisicaoTecnica,
} from "@/lib/requisicoesTecnicas";

import {
  carregarEstados,
  ouvirAlteracoes,
} from "@/lib/requisicoesStore";

export default function EmbarquePage() {
  const router = useRouter();

  const [busca, setBusca] =
    useState("");

  const [versao, setVersao] =
    useState(0);

  useEffect(() => {
    const atualizar = () =>
      setVersao(
        (valor) => valor + 1
      );

    atualizar();

    return ouvirAlteracoes(
      atualizar
    );
  }, []);

  const requisicoes =
    useMemo(() => {
      void versao;

      const estados =
        carregarEstados();

      const termo =
        busca
          .trim()
          .toUpperCase();

      return requisicoesTecnicasMock
        .map((req) => {
          const estado =
            estados[req.id];

          return {
            ...req,

            status:
              estado?.status ??
              req.status,

            volumes:
              estado?.volumes ??
              [],
          };
        })
        .filter(
          (req) =>
            req.status ===
              "CONFERIDA" ||
            req.status ===
              "EMBARCADA"
        )
        .filter((req) => {
          if (!termo) {
            return true;
          }

          return [
            req.codigo,
            req.tecnico,
            req.codigoTecnico,
            req.base,
            req.tipo,
          ]
            .join(" ")
            .toUpperCase()
            .includes(termo);
        });
    }, [busca, versao]);

  return (
    <div className="collector-screen">
      <div
        className="collector-phone"
        style={{
          background: "#f4f4f4",
          overflow: "hidden",
        }}
      >
        <div
          style={{
            height: 40,
            background: "#000",
            flex: "0 0 auto",
          }}
        />

        <div
          style={{
            minHeight: 76,
            background: "#168bb2",
            color: "#fff",
            display: "flex",
            alignItems: "center",
            gap: 12,
            padding: "0 18px",
            flex: "0 0 auto",
          }}
        >
          <button
            type="button"
            onClick={() =>
              router.push(
                "/coletor/expedicoes"
              )
            }
            style={{
              border: 0,
              background:
                "transparent",
              color: "#fff",
              fontSize: 34,
              cursor: "pointer",
              padding: 0,
            }}
          >
            ‹
          </button>

          <strong
            style={{
              fontSize: 23,
            }}
          >
            Ordens - Embarque
          </strong>
        </div>

        <div
          style={{
            padding: "12px 12px 8px",
            flex: "0 0 auto",
          }}
        >
          <div
            style={{
              minHeight: 56,
              border:
                "1px solid #aaa",
              borderRadius: 18,
              background: "#fff",
              display: "flex",
              alignItems: "center",
              gap: 10,
              padding: "0 15px",
            }}
          >
            <span
              style={{
                color: "#587184",
                fontSize: 20,
              }}
            >
              ⌕
            </span>

            <input
              value={busca}
              onChange={(e) =>
                setBusca(
                  e.target.value
                )
              }
              placeholder="Parâmetro de busca"
              style={{
                flex: 1,
                border: 0,
                outline: 0,
                background:
                  "transparent",
                fontSize: 15,
              }}
            />
          </div>
        </div>

        <div
          style={{
            flex: 1,
            minHeight: 0,
            overflowY: "auto",
            padding: "8px 8px 30px",
          }}
        >
          {requisicoes.map(
            (req) => (
              <Card
                key={req.id}
                requisicao={req}
                onClick={() =>
                  router.push(
                    `/coletor/embarque/${req.id}`
                  )
                }
              />
            )
          )}

          {requisicoes.length ===
            0 && (
            <div
              style={{
                marginTop: 50,
                textAlign:
                  "center",
                color: "#999",
                fontSize: 12,
              }}
            >
              Nenhuma ordem disponível
              para embarque.
            </div>
          )}

          <div
            style={{
              marginTop: 20,
              textAlign: "center",
              color: "#999",
              fontSize: 10,
            }}
          >
            {requisicoes.length}{" "}
            ordem(ns) disponível(is)
          </div>
        </div>

        <div
          style={{
            height: 36,
            background: "#000",
            flex: "0 0 auto",
          }}
        />
      </div>
    </div>
  );
}

function Card({
  requisicao,
  onClick,
}: {
  requisicao:
    RequisicaoTecnica & {
      volumes: any[];
    };

  onClick: () => void;
}) {
  const volumes =
    requisicao.volumes ??
    [];

  const lidos =
    volumes.filter(
      (volume) =>
        volume.status ===
          "EMBARCADO" ||
        volume.status ===
          "EM_TRANSITO" ||
        volume.status ===
          "RECEBIDO"
    ).length;

  const totalItens =
    requisicao.itens.reduce(
      (total, item) =>
        total +
        item.solicitado,
      0
    );

  return (
    <button
      type="button"
      onClick={onClick}
      style={{
        width: "100%",
        minHeight: 166,
        marginBottom: 10,
        border:
          "2px solid #168bb2",
        borderRadius: 12,
        background: "#fff",
        padding: "10px 12px",
        textAlign: "left",
        cursor: "pointer",
        position: "relative",
      }}
    >
      <div
        style={{
          display: "flex",
          justifyContent:
            "space-between",
          gap: 10,
        }}
      >
        <div>
          <div
            style={{
              fontSize: 17,
              fontWeight: 800,
            }}
          >
            Pedido:{" "}
            {requisicao.codigo.replace(
              "REQ-",
              ""
            )}
          </div>

          <div
            style={{
              marginTop: 12,
              fontSize: 12,
              lineHeight: 1.55,
              color: "#087da7",
            }}
          >
            <div>
              <strong>
                Técnico:
              </strong>{" "}
              {requisicao.tecnico}
            </div>

            <div>
              <strong>
                Cód.:
              </strong>{" "}
              {requisicao.codigoTecnico}
            </div>

            <div>
              <strong>
                Base:
              </strong>{" "}
              {requisicao.base}
            </div>

            <div>
              <strong>
                Tipo:
              </strong>{" "}
              {requisicao.tipo}
            </div>
          </div>
        </div>

        <span
          style={{
            alignSelf: "start",
            borderRadius: 20,
            background:
              requisicao.status ===
              "EMBARCADA"
                ? "#fff0c7"
                : "#d9f3fb",
            color:
              requisicao.status ===
              "EMBARCADA"
                ? "#9a6500"
                : "#087da7",
            padding: "7px 11px",
            fontSize: 10,
            fontWeight: 800,
          }}
        >
          {requisicao.status ===
          "EMBARCADA"
            ? "EM ANDAMENTO"
            : "CONFERIDA"}
        </span>
      </div>

      <div
        style={{
          display: "grid",
          gridTemplateColumns:
            "1fr 1fr 1fr",
          gap: 8,
          marginTop: 12,
          fontSize: 11,
        }}
      >
        <div>
          <strong>Itens:</strong>{" "}
          {totalItens}
        </div>

        <div>
          <strong>Volumes:</strong>{" "}
          {volumes.length}
        </div>

        <div>
          <strong>Lidos:</strong>{" "}
          {lidos}/{volumes.length}
        </div>
      </div>

      <div
        style={{
          position: "absolute",
          right: 14,
          bottom: 12,
          color: "#168bb2",
          fontSize: 27,
        }}
      >
        ›
      </div>
    </button>
  );
}
</file>

