lay:flex;justify-content:space-between;align-items:center;gap:10px;padding:14px 17px;border-bottom:1px solid #dce9f0}.detailHead span:first-child{font-size:10px;color:#7292a4;font-weight:700;letter-spacing:.6px}.detailHead h2{font-size:19px;color:#007eaf;margin:3px 0}.detailHead p{font-size:11px;color:#637d8e;margin:0}.infoGrid{display:grid;grid-template-columns:1fr 1fr 1.4fr;gap:8px;padding:12px 14px}.infoGrid>div{background:#f2f8fc;border:1px solid #e0edf4;border-radius:8px;padding:10px;display:flex;flex-direction:column;gap:5px;min-width:0;overflow-wrap:anywhere}.infoGrid small{font-size:10px;color:#708b9c}.infoGrid strong{font-size:12px;color:#183f58}.infoGrid span{font-size:10px;color:#648193}.notice{margin:0 14px 9px;border-left:3px solid #e8a338;background:#fff7e8;padding:8px 10px;display:flex;flex-direction:column;gap:4px;font-size:11px}.tabs{display:flex;gap:0;border-bottom:1px solid #cfe1ec;padding:0 14px;margin-top:8px}.tabs button{border:0;border-bottom:3px solid transparent;background:transparent;color:#607f91;padding:11px 13px;font-size:12px;font-weight:700}.tabs button.active{color:#087fb2;border-color:#087fb2}.summary{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;padding:13px 14px}.summary>div{border:1px solid #d7e9f2;border-radius:8px;padding:10px;display:flex;flex-direction:column;gap:5px}.summary small{font-size:10px;color:#6d899b}.summary strong{font-size:20px;color:#087fac}.tableWrap{overflow-x:auto;padding:0 14px 20px}.tableWrap table{width:100%;border-collapse:collapse;min-width:690px}.tableWrap th{font-size:10px;text-align:left;color:#173447;padding:12px 9px;border-bottom:2px solid #cfe2ee;white-space:nowrap}.tableWrap td{padding:13px 9px;border-bottom:1px solid #e7eff4;font-size:11px;color:#344c5c}.tableWrap td strong{color:#087fab}.dot{display:inline-block;width:11px;height:11px;border-radius:3px;background:#dba23a}.dotOk{background:#22a078}.dotWarn{background:#e36a59}.timeline{padding:17px 23px;max-height:490px;overflow-y:auto}.timeline article{display:flex;gap:12px;position:relative;border-left:2px solid #d4e8f3;margin-left:5px;padding:0 0 20px 18px}.timelineDot{position:absolute;left:-7px;top:2px;width:12px;height:12px;border:3px solid #fff;border-radius:50%;background:#0b8ab9;box-shadow:0 0 0 1px #0b8ab9}.timeline article>div:last-child{background:#f2f7fa;border-radius:9px;padding:12px;width:100%}.timeline strong,.timeline small{display:block}.timeline strong{font-size:12px;color:#19435d}.timeline small{font-size:10px;color:#7290a1;margin-top:6px}.timeline p{font-size:11px;margin:7px 0 0;color:#35566a}.placeholder{height:100%;min-height:490px;display:flex;align-items:center;justify-content:center;flex-direction:column;text-align:center;padding:25px;color:#7794a5}.placeholderIcon{font-size:48px;color:#8ac8e4}.placeholder h2{font-size:17px;color:#315f78}.placeholder p{max-width:380px;font-size:12px;line-height:1.6}.empty{padding:28px;text-align:center;color:#7993a3;font-size:12px}.footnote{font-size:10px;color:#8197a6;margin-top:12px}.error{padding:10px;background:#ffecec;color:#a33;border-radius:8px}@media(max-width:1250px){.kpis{grid-template-columns:repeat(3,1fr)}.toolbar{align-items:stretch;flex-direction:column}.filters input{flex:1}}@media(max-width:850px){.workspace{grid-template-columns:1fr}.osList{max-height:320px}.infoGrid{grid-template-columns:1fr 1fr}}@media(max-width:520px){.root{padding:10px}.kpis{grid-template-columns:repeat(2,1fr)}.infoGrid,.summary{grid-template-columns:1fr 1fr}.readonly{display:none}.filters input,.filters select{width:100%;max-width:none}.filters{display:grid;grid-template-columns:1fr 1fr}.filters input{grid-column:1/-1}}

/* V08.0.2 — ocorrencias acessiveis apenas por modal; menu WMS intacto */
.detailActions{display:flex;align-items:center;gap:12px;flex-wrap:wrap;justify-content:flex-end}

/* V08.0.6 — resumo FSM no rodapé do painel, sem interferir no menu global */
.detailPane{display:flex;flex-direction:column}
.fsmFlow{margin-top:auto;border-top:1px solid #d5e5ee;background:#fff;padding:12px 15px 15px;flex-shrink:0}
.fsmFlowTitle{display:flex;justify-content:space-between;gap:10px;align-items:center;font-size:11px;color:#087eaf;margin-bottom:12px}
.fsmFlowTitle span{color:#637f90;font-size:10px}
.fsmFlowSteps{display:flex;align-items:flex-start;list-style:none;padding:0;margin:0;gap:0}
.fsmFlowStep{flex:1;min-width:0;display:flex;align-items:center;position:relative;gap:7px;color:#99a9b4;font-size:11px;font-weight:700}
.fsmFlowStep:not(:last-child):after{content:"";height:2px;background:#dce4e9;flex:1;margin:0 7px}
.fsmFlowCircle{display:inline-flex;align-items:center;justify-content:center;flex:none;width:25px;height:25px;border-radius:50%;background:#e1e7eb;color:#8498a4;font-size:11px}
.fsmFlowDone .fsmFlowCircle{background:#239d80;color:white}.fsmFlowDone{color:#2b806e}
.fsmFlowCurrent .fsmFlowCircle{background:#0786b5;color:white}.fsmFlowCurrent{color:#087fae}
.fsmFlowAlert{margin-top:10px;font-size:11px;color:#a06918;background:#fff5e5;border-left:3px solid #e5a03d;padding:7px 9px}
@media(max-width:650px){.fsmFlowSteps{flex-wrap:wrap;gap:8px}.fsmFlowStep{flex:0 0 calc(50% - 4px)}.fsmFlowStep:after{display:none}.fsmFlowLabel{font-size:10px}}


/* V08.0.7 — icones nas etapas FSM */
.fsmFlowCircle svg{display:block;width:15px;height:15px;flex-shrink:0}
.fsmFlowDone .fsmFlowCircle svg,.fsmFlowCurrent .fsmFlowCircle svg{stroke:currentColor}
.fsmFlowStep{gap:8px}
.fsmFlowStep:not(:last-child):after{min-width:12px}
@media(max-width:850px){.fsmFlowCircle{width:28px;height:28px}.fsmFlowLabel{font-size:10px}}
