.androidHome{width:9px;height:9px;border:1.5px solid #fff;border-radius:50%}
.androidRecent{width:11px;height:10px;border-left:2px solid #fff;border-right:2px solid #fff;position:relative}
.androidRecent:after{content:"";position:absolute;left:3px;top:0;height:10px;border-left:1px solid #fff}
@media(max-width:500px){.screen{padding:0;background:#f6f9fc;min-height:100dvh}.phone{width:100%;max-width:none;height:100dvh;min-height:0;box-shadow:none;padding:0!important}.phone:before,.androidNav{display:none}.header{height:65px;min-height:65px}}
</file>

