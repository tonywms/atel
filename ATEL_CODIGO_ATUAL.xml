/* =========================================================
   OPÇÃO
========================================================= */

function Opcao({
  ativo,
  titulo,
  desc,
  on,
  perigo = false,
}: {
  ativo: boolean;
  titulo: string;
  desc: string;
  on: () => void;
  perigo?: boolean;
}) {
  return (
    <button
      onClick={on}
      style={{
        width: "100%",

        textAlign: "left",

        padding: 10,

        marginBottom: 7,

        borderRadius: 7,

        border: ativo
          ? `2px solid ${
              perigo
                ? "#c0392b"
                : "#087da7"
            }`
          : "1px solid #cbd5e1",

        background: ativo
          ? perigo
            ? "#fff1f0"
            : "#edf8fc"
          : "#fff",

        cursor: "pointer",
      }}
    >
      <b
        style={{
          fontSize: 10,

          color: perigo
            ? "#b42318"
            : "#111827",
        }}
      >
        {ativo ? "● " : "○ "}
        {titulo}
      </b>

      <div
        style={{
          fontSize: 9,

          color: "#64748b",

          marginTop: 4,
        }}
      >
        {desc}
      </div>
    </button>
  );
}

/* =========================================================
   RESUMO
========================================================= */

function Resumo({
  t,
  v,
}: {
  t: string;
  v: string;
}) {
  return (
    <div
      style={{
        padding: 8,

        border:
          "1px solid #e2e8f0",

