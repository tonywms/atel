<file path="app/expedicoes/pendencias/page.tsx">
"use client";

import {
  useEffect,
  useMemo,
  useState,
} from "react";

import {
  useRouter,
} from "next/navigation";

import {
  carregarPendenciasRetorno,
  iniciarAnalisePendencia,
  ouvirPendenciasRetorno,
  PendenciaRetorno,
  reabrirAnalisePendencia,
  resolverPendenciaRetorno,
  SolucaoPendenciaRetorno,
} from "@/lib/pendenciasRetornoStore";

/* =========================================================
   TIPOS
========================================================= */

type FiltroStatus =
  | "TODAS"
  | "ABERTA"
  | "EM_ANALISE"
  | "RESOLVIDA";

/* =========================================================
   PAGE
========================================================= */

export default function Page() {
  const router =
    useRouter();

  const [
    pendencias,
    setPendencias,
  ] = useState<
    PendenciaRetorno[]
  >([]);

  const [
    selecionadaId,
    setSelecionadaId,
  ] = useState<
    string | null
  >(null);

  const [
    pesquisa,
    setPesquisa,
  ] = useState("");

  const [
    filtro,
    setFiltro,
  ] =
    useState<FiltroStatus>(
      "TODAS"
    );

  const [
    modalResolver,
    setModalResolver,
  ] = useState(false);

  const [
    solucao,
    setSolucao,
  ] =
    useState<SolucaoPendenciaRetorno | null>(
      null
    );

  const [
    observacao,
    setObservacao,
  ] = useState("");

  const [
    mensagem,
    setMensagem,
  ] = useState("");

  /* =========================================================
     CARREGAR
  ========================================================= */

  function atualizar() {
    const dados =
      carregarPendenciasRetorno();

    setPendencias(dados);

    setSelecionadaId(
      (atual) => {
        if (
          atual &&
          dados.some(
            (item) =>
              item.id ===
              atual
          )
        ) {
          return atual;
        }

        return (
          dados[0]?.id ??
          null
        );
      }
    );
  }

  useEffect(() => {
    atualizar();

    return ouvirPendenciasRetorno(
      atualizar
    );
  }, []);

  /* =========================================================
     RESUMO
  ========================================================= */

  const resumo =
    useMemo(() => {
      return {
        total:
          pendencias.length,

        abertas:
          pendencias.filter(
            (item) =>
              item.status ===
              "ABERTA"
          ).length,

        analise:
          pendencias.filter(
            (item) =>
              item.status ===
              "EM_ANALISE"
          ).length,

        resolvidas:
          pendencias.filter(
            (item) =>
              item.status ===
              "RESOLVIDA"
          ).length,
      };
    }, [pendencias]);

  /* =========================================================
     FILTRO
  ========================================================= */

  const filtradas =
    useMemo(() => {
      const termo =
        pesquisa
          .trim()
          .toLowerCase();

      return pendencias.filter(
        (pendencia) => {
          if (
            filtro !==
              "TODAS" &&
            pendencia.status !==
              filtro
          ) {
            return false;
          }

          if (!termo) {
            return true;
          }

          const texto = [
            pendencia.id,
            pendencia.retornoCodigo,
            pendencia.documentoOrigem,
            pendencia.codigoProduto,
            pendencia.produto,
            pendencia.tecnico,
            pendencia.codigoTecnico,
            pendencia.base,
            pendencia.motivo,
          ]
            .filter(Boolean)
            .join(" ")
            .toLowerCase();

          return texto.includes(
            termo
          );
        }
      );
    }, [
      pendencias,
      pesquisa,
      filtro,
    ]);

  const selecionada =
    useMemo(() => {
      return (
        pendencias.find(
          (item) =>
            item.id ===
            selecionadaId
        ) ?? null
      );
    }, [
      pendencias,
      selecionadaId,
    ]);

  /* =========================================================
     AÇÕES
  ========================================================= */

  function iniciarAnalise() {
    if (!selecionada) {
      return;
    }

    try {
      iniciarAnalisePendencia(
        selecionada.id
      );

      setMensagem(
        "✓ Pendência colocada em análise."
      );

      atualizar();
    } catch (erro) {
      setMensagem(
        erro instanceof Error
          ? erro.message
          : "Erro ao iniciar análise."
      );
    }
  }

  function devolverParaAberta() {
    if (!selecionada) {
      return;
    }

    try {
      reabrirAnalisePendencia(
        selecionada.id
      );

      setMensagem(
        "Pendência devolvida para ABERTA."
      );

      atualizar();
    } catch (erro) {
      setMensagem(
        erro instanceof Error
          ? erro.message
          : "Erro ao atualizar pendência."
      );
    }
  }

  function abrirResolucao() {
    setSolucao(null);

    setObservacao("");

    setMensagem("");

    setModalResolver(true);
  }

  function confirmarResolucao() {
    if (
      !selecionada
    ) {
      return;
    }

    if (!solucao) {
      setMensagem(
        "Selecione a solução da pendência."
      );

      return;
    }

    if (
      !observacao.trim()
    ) {
      setMensagem(
        "Informe a justificativa da resolução."
      );

      return;
