<file path="app/coletor/retornos/page.tsx">
"use client";

import "./atel-v47.css";
import "./atel-v47-2.css";

import {
  useEffect,
  useMemo,
  useState,
} from "react";

import { useRouter } from "next/navigation";

import {
  carregarRetornos,
  ouvirRetornos,
} from "@/lib/retornosStore";

export default function Page() {
  const router = useRouter();

  const [busca, setBusca] = useState("");
  const [tick, setTick] = useState(0);
  const [ready, setReady] = useState(false);

  /* =========================================================
     ATUALIZAÇÃO
  ========================================================= */

  useEffect(() => {
    setReady(true);

    return ouvirRetornos(() => {
      setTick((valor) => valor + 1);
    });
  }, []);

  /* =========================================================
     LISTAGEM
  ========================================================= */

  const lista = useMemo(() => {
    if (!ready) {
      return [];
    }

    const termo = busca
      .trim()
      .toLowerCase();

    return carregarRetornos()
      .filter((retorno) =>
        [
          "EM_TRANSITO_CD",
          "AGUARDANDO_CONFERENCIA",
          "EM_CONFERENCIA",
        ].includes(retorno.status)
      )
      .filter((retorno) => {
        if (!termo) {
          return true;
        }

        const texto = [
          retorno.codigo,
          retorno.tecnico,
          retorno.codigoTecnico,
          retorno.documentoOrigem,
          retorno.destinoFisico,
          retorno.base,
        ]
          .join(" ")
          .toLowerCase();

        return texto.includes(termo);
      });
  }, [ready, tick, busca]);

  /* =========================================================
     RENDER
  ========================================================= */

  return (
    <div className="collector-screen atel-v47-screen atel-v47-retornos">
      <div
        className="collector-phone"
        style={phone}
      >
        {/* BARRA PRETA SUPERIOR */}

        

        {/* ===================================================
            HEADER
        =================================================== */}

        <div style={header}>
          <button
            type="button"
            onClick={() =>
              router.push("/coletor/expedicoes")
            }
            style={backButton}
            aria-label="Voltar"
          ><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.3" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg></button>

          <div style={headerTitle}>
            Retornos ao CD
          </div>
        </div>

        {/* ===================================================
            PESQUISA
        =================================================== */}

        <div style={searchArea}>
          <div style={searchContainer}>
            <span style={searchIcon}><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg></span>

            <input
              value={busca}
              onChange={(event) =>
                setBusca(event.target.value)
              }
              placeholder="Retorno / técnico / documento"
              style={searchInput}
            />

            {busca.length > 0 && (
              <button
                type="button"
                onClick={() =>
                  setBusca("")
                }
                style={clearSearchButton}
                aria-label="Limpar pesquisa"
              >
                ×
              </button>
            )}
          </div>
        </div>

        {/* ===================================================
            CORPO
        =================================================== */}

        <div
          className="collector-operation-body"
          style={body}
        >
          {/* =================================================
              CABEÇALHO DA LISTAGEM
          ================================================= */}

          {lista.length > 0 && (
            <div style={listHeader}>
              <span>
                RETORNOS PARA RECEBIMENTO
              </span>

              <span style={counterBadge}>
                {lista.length}
              </span>
            </div>
          )}

          {/* =================================================
              RETORNOS
          ================================================= */}

          {lista.map((retorno) => {
            const quantidade =
              retorno.itens.reduce(
                (total, item) =>
                  total +
                  Number(
                    item.quantidade ?? 0
                  ),
                0
              );

            const conferidos =
              Object.keys(
                retorno.recebimentoCD
                  ?.itensConferidos ?? {}
              ).length;

            return (
              <button
                type="button"
                key={retorno.id}
                onClick={() =>
                  router.push(
                    `/coletor/retornos/${retorno.id}`
                  )
                }
                style={card}
              >
                {/* CABEÇALHO */}

                <div style={cardHeader}>
                  <div style={cardTitleArea}>
                    <div style={returnCode}>
                      {retorno.codigo}
                    </div>

                    <div style={documentOrigin}>
                      {retorno.documentoOrigem}
                    </div>
                  </div>

                  <span
                    style={
                      retorno.status ===
                      "EM_TRANSITO_CD"
                        ? transitBadge
                        : conferenceBadge
                    }
                  >
                    {formatarStatus(
                      retorno.status
                    )}
                  </span>
                </div>

                <div style={divider} />

                {/* TÉCNICO */}

                <div style={technicianName}>
                  {retorno.tecnico}
                </div>

                <div style={technicianCode}>
                  {retorno.codigoTecnico}
                  {retorno.base
                    ? ` • ${retorno.base}`
                    : ""}
                </div>

                {/* ORIGEM / DESTINO */}

                <div style={infoGrid}>
                  <Info
                    label="ORIGEM"
                    value={
                      retorno.documentoOrigem
                    }
                  />

                  <Info
                    label="DESTINO"
                    value={
                      retorno.destinoFisico
                    }
                  />
                </div>

                {/* RODAPÉ DO CARD */}

                <div style={summaryRow}>
                  <div style={summaryItem}>
                    <span style={summaryLabel}>
                      SKUs
                    </span>

                    <strong style={summaryValue}>
                      {retorno.itens.length}
                    </strong>
                  </div>

                  <div style={summaryItem}>
                    <span style={summaryLabel}>
                      QTD.
                    </span>

                    <strong style={summaryValue}>
                      {quantidade}
                    </strong>
                  </div>

                  <div style={summaryItem}>
                    <span style={summaryLabel}>
                      CONFERIDOS
                    </span>

                    <strong style={summaryValue}>
                      {conferidos}/
                      {retorno.itens.length}
                    </strong>
                  </div>

                  <span style={arrow}>
                    ›
                  </span>
                </div>
              </button>
            );
          })}

          {/* =================================================
              LISTA VAZIA
          ================================================= */}

          {ready &&
            lista.length === 0 && (
              <div style={emptyState}>
                <div style={emptyIcon}>
                  ↩
                </div>

                <strong style={emptyTitle}>
                  Nenhum retorno pendente
                </strong>

                <span
                  style={emptyDescription}
                >
                  Nenhum retorno está em
                  trânsito ou aguardando
                  recebimento no CD.
                </span>
              </div>
            )}
        </div>

        {/* BARRA PRETA INFERIOR */}

        <div style={bottomBar} />
      </div>
    </div>
  );
}

/* =========================================================
   COMPONENTE INFO
========================================================= */

function Info({
  label,
  value,
}: {
  label: string;
  value: string;
}) {
  return (
    <div style={infoItem}>
      <span style={infoLabel}>
        {label}
      </span>

      <strong style={infoValue}>
        {value}
      </strong>
    </div>
  );
}

/* =========================================================
   FORMATAR STATUS
========================================================= */

function formatarStatus(
  status: string
) {
  switch (status) {
    case "EM_TRANSITO_CD":
      return "EM TRÂNSITO";

    case "AGUARDANDO_CONFERENCIA":
      return "AGUARDANDO";

    case "EM_CONFERENCIA":
      return "EM CONFERÊNCIA";

    default:
      return status.replaceAll(
        "_",
        " "
      );
  }
}

