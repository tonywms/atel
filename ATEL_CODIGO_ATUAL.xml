                  )}

                  {solucao ===
                    "QUARENTENA" && (
                    <>
                      <strong>
                        ⚠ QUARENTENA
                      </strong>

                      <span>
                        {
                          selecionada.quantidade
                        }{" "}
                        {
                          selecionada.unidade
                        } serão adicionadas à quarentena.
                      </span>
