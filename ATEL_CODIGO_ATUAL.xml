  retiradoPorCodigoTecnico?: string;

  status:
    | "INSTALADO"
    | "VENDIDO"
    | "RETIRADO";
};

/* =========================================================
   STORAGE
========================================================= */

const STORAGE_OS =
  "wms-expert-ordens-servico";

const STORAGE_PATRIMONIO =
  "wms-expert-patrimonio-cliente";

const EVENTO_OS =
  "wms-ordens-servico-update";

/* =========================================================
   HELPERS
========================================================= */

function podeUsarStorage() {
  return typeof window !== "undefined";
}

function ler<T>(
  chave: string,
  padrao: T
): T {
  if (!podeUsarStorage()) {
    return padrao;
  }

  try {
    const valor =
      localStorage.getItem(chave);

    return valor
      ? (JSON.parse(valor) as T)
      : padrao;
  } catch {
    return padrao;
  }
}

function salvar<T>(
  chave: string,
  valor: T
) {
  if (!podeUsarStorage()) {
    return;
  }

  localStorage.setItem(
    chave,
    JSON.stringify(valor)
  );
}

function disparar() {
  if (!podeUsarStorage()) {
    return;
  }

  window.dispatchEvent(
    new CustomEvent(EVENTO_OS)
  );
}

