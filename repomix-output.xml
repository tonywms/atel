                            .value
                        )
                      }
                      style={
                        campo
                      }
                    />
                  </>
                )}

              {/* ===========================================
                  OBSERVAÇÃO
              =========================================== */}

              <Campo t="OBSERVAÇÃO" />

              <textarea
                rows={3}
                value={obs}
                onChange={(e) =>
                  setObs(
                    e.target.value
                  )
                }
                style={{
                  ...campo,

                  height: "auto",

                  paddingTop: 10,
                }}
                placeholder="Descreva o problema encontrado..."
              />

              {decisao ===
                "RECUSA_VOLUME" && (
                <div
                  style={{
                    marginTop: 12,

                    padding: 10,

                    background:
                      "#fff1f0",

                    color:
                      "#b42318",

                    fontSize: 10,

                    fontWeight:
                      800,
                  }}
                >
                  ⚠ Todo o volume
                  ficará pendente de
                  retorno ao CD.
                </div>
              )}

              {/* ===========================================
                  BOTÃO SALVAR
              =========================================== */}

              <button
                onClick={salvar}
                style={{
                  width: "100%",

                  height: 46,

                  marginTop: 14,

                  border: 0,

                  borderRadius: 6,

                  background:
                    decisao ===
                    "RECUSA_VOLUME"
                      ? "#c0392b"
                      : "#e39400",

                  color: "#fff",

                  fontWeight: 900,

                  cursor:
                    "pointer",
                }}
              >
                {decisao ===
                "RECUSA_VOLUME"
                  ? "CONFIRMAR RECUSA DO VOLUME"
                  : decisao ===
                      "RECUSA_ITEM"
                    ? "CONFIRMAR RECUSA DO ITEM"
                    : "SALVAR ACEITE PARCIAL"}
              </button>
            </div>
          </div>
        )}
      </div>
    </div>
  );
}

/* =========================================================
   OPÇÃO
========================================================= */

function Opcao({
  ativo,
  titulo,
  desc,
  on,
  perigo = false,
}: {
  ativo: boolean;
  titulo: string;
  desc: string;
  on: () => void;
  perigo?: boolean;
}) {
  return (
    <button
      onClick={on}
      style={{
        width: "100%",

        textAlign: "left",

        padding: 10,

        marginBottom: 7,

        borderRadius: 7,

        border: ativo
          ? `2px solid ${
              perigo
                ? "#c0392b"
                : "#087da7"
            }`
          : "1px solid #cbd5e1",

        background: ativo
          ? perigo
            ? "#fff1f0"
            : "#edf8fc"
          : "#fff",

        cursor: "pointer",
      }}
    >
      <b
        style={{
          fontSize: 10,

          color: perigo
            ? "#b42318"
            : "#111827",
        }}
      >
        {ativo ? "● " : "○ "}
        {titulo}
      </b>

      <div
        style={{
          fontSize: 9,

          color: "#64748b",

          marginTop: 4,
        }}
      >
        {desc}
      </div>
    </button>
  );
}

/* =========================================================
   RESUMO
========================================================= */

function Resumo({
  t,
  v,
}: {
  t: string;
  v: string;
}) {
  return (
    <div
      style={{
        padding: 8,

        border:
          "1px solid #e2e8f0",

        borderRadius: 5,

        textAlign: "center",
      }}
    >
      <span
        style={{
          display: "block",

          fontSize: 8,

          color: "#64748b",

          fontWeight: 800,
        }}
      >
        {t.toUpperCase()}
      </span>

      <b
        style={{
          fontSize: 14,
        }}
      >
        {v}
      </b>
    </div>
  );
}

/* =========================================================
   CAMPO
========================================================= */

function Campo({
  t,
}: {
  t: string;
}) {
  return (
    <div
      style={{
        marginTop: 13,

        marginBottom: 5,

        fontSize: 9,

        fontWeight: 900,
      }}
    >
      {t}
    </div>
  );
}

/* =========================================================
   TELA
========================================================= */

function Tela({
  t,
}: {
  t: string;
}) {
  return (
    <div className="collector-screen">
      <div className="collector-phone">
        <div
          style={{
            padding: 30,

            textAlign:
              "center",
          }}
        >
          {t}
        </div>
      </div>
    </div>
  );
}

/* =========================================================
