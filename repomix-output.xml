function MetricCard({
  title,
  value,
  subtitle,
  accent,
  onClick,
}: {
  title: string;
  value: number;
  subtitle: string;
  accent: string;
  onClick: () => void;
}) {
  return (
    <button
      type="button"
      onClick={onClick}
      style={metricCard}
    >
      <div
        style={{
          ...metricHeader,
          background: accent,
        }}
      >
        {title}
      </div>

      <div style={metricValue}>
        {value}
      </div>

      <div style={metricSubtitle}>
        {subtitle}
      </div>
    </button>
  );
}

function StatusBadge({
  status,
}: {
  status:
    PendenciaRetorno["status"];
}) {
  const config =
    status === "ABERTA"
      ? {
          background:
            "#fff1c2",
          color:
            "#9a6700",
          texto:
            "Aberta",
        }
      : status ===
        "EM_ANALISE"
      ? {
          background:
            "#dff4fb",
          color:
            "#087da7",
          texto:
            "Em análise",
        }
      : {
          background:
            "#daf2e5",
          color:
            "#067647",
          texto:
            "Resolvida",
        };

  return (
    <span
      style={{
        ...statusBadge,
        background:
          config.background,
        color:
          config.color,
      }}
    >
      {config.texto}
    </span>
  );
}

function DetailInfo({
  label,
  value,
}: {
  label: string;
  value: string;
}) {
  return (
    <div style={detailInfo}>
      <span style={tinyLabel}>
        {label}
      </span>

      <strong>
        {value}
      </strong>
    </div>
  );
}

function ResolutionOption({
  active,
  icon,
  title,
  description,
  onClick,
}: {
  active: boolean;
  icon: string;
  title: string;
  description: string;
  onClick: () => void;
}) {
  return (
    <button
      type="button"
      onClick={onClick}
      style={{
        ...resolutionOption,
        borderColor: active ? "#009fe3" : "#d0d8dd",
        background: active ? "#edf9fd" : "#ffffff",
        boxShadow: active
          ? "0 0 0 1px rgba(0,159,227,.10)"
          : "none",
      }}
    >
      <div
        style={{
          ...resolutionIcon,
          background: active ? "#009fe3" : "#edf1f3",
          color: active ? "#ffffff" : "#667085",
        }}
      >
        {icon}
      </div>

      <div style={resolutionContent}>
        <strong style={resolutionTitle}>
          {title}
        </strong>

        <span style={resolutionDescription}>
          {description}
        </span>
      </div>

      <div
        aria-hidden="true"
        style={{
          ...resolutionRadio,
          borderColor: active ? "#009fe3" : "#cbd5db",
          background: active ? "#009fe3" : "#ffffff",
        }}
      >
        {active && <span style={resolutionRadioDot} />}
      </div>
    </button>
  );
}

/* =========================================================
   FORMATADORES
========================================================= */

function formatarTexto(
  valor: string
) {
  return valor
    .replaceAll("_", " ")
    .toLowerCase()
    .replace(
      /(^|\s)\S/g,
      (letra) =>
        letra.toUpperCase()
    );
}

function formatarSolucao(
  valor?: SolucaoPendenciaRetorno
) {
  if (
    valor === "DISPONIVEL"
  ) {
    return "Estoque disponível";
  }

  if (
    valor === "QUARENTENA"
  ) {
    return "Quarentena";
  }

  if (
    valor === "BAIXA"
  ) {
    return "Ajuste / baixa";
  }

  return "-";
}

function formatarData(
  valor?: string
) {
  if (!valor) {
    return "-";
  }

  return new Intl.DateTimeFormat(
    "pt-BR",
    {
      dateStyle: "short",
      timeStyle: "short",
    }
  ).format(
    new Date(valor)
  );
}

