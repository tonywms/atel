          color: #7c8a95;
        }

        .ret-search input {
          width: 100%;

          border: none;
          outline: none;

          background: transparent;

          color: #65727e;
          font-size: 15px;
        }

        .ret-header-icon {
          width: 30px;
          height: 30px;

          border: none;
          background: transparent;

          color: #006f9e;
          font-size: 18px;

          cursor: pointer;
        }

        /* ===================================================
