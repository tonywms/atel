                            20,
                          padding:
                            "5px 8px",
                          background:
                            lido
                              ? "#d7f3e5"
                              : "#eef2f5",
                          color:
                            lido
                              ? "#087647"
                              : "#687685",
                          fontSize: 9,
                          fontWeight:
                            900,
                        }}
                      >
                        {lido
                          ? "✓ LIDO"
                          : "PENDENTE"}
                      </span>
                    </div>
                  );
                }
              )}
            </div>
          </section>

          {mensagem && (
            <div
              style={{
                marginTop: 12,
                padding:
                  "10px 12px",
                border:
