/* =========================================================
   FORMATADORES
========================================================= */

function formatarTexto(
  valor: string
) {
  return valor
    .replaceAll("_", " ")
    .toLowerCase()
    .replace(
      /(^|\s)\S/g,
      (letra) =>
        letra.toUpperCase()
    );
}

function formatarSolucao(
  valor?: SolucaoPendenciaRetorno
) {
  if (
    valor === "DISPONIVEL"
  ) {
    return "Estoque disponÃ­vel";
  }

  if (
    valor === "QUARENTENA"
  ) {
    return "Quarentena";
  }

  if (
    valor === "BAIXA"
  ) {
    return "Ajuste / baixa";
  }

  return "-";
}

function formatarData(
  valor?: string
) {
  if (!valor) {
    return "-";
  }

  return new Intl.DateTimeFormat(
    "pt-BR",
    {
      dateStyle: "short",
      timeStyle: "short",
    }
  ).format(
    new Date(valor)
  );
}

