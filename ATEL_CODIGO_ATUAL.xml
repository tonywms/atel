      </span>

      <b
        style={{
          fontSize: 14,
        }}
      >
        {v}
      </b>
    </div>
  );
}

/* =========================================================
   CAMPO
========================================================= */

function Campo({
  t,
}: {
  t: string;
}) {
  return (
    <div
      style={{
        marginTop: 13,

        marginBottom: 5,

        fontSize: 9,

        fontWeight: 900,
      }}
