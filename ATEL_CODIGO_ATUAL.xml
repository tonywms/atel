              />
            </div>
          </section>

          <section
            style={{
              ...cardStyle,
              marginTop: 12,
            }}
          >
            <div
              style={
                tituloStyle
              }
            >
              Destino

              <span
                style={
                  iconeStyle
                }
              >
                ↗
              </span>
            </div>

            <div
              style={{
