/* =========================================================
   TIPO
========================================================= */

function TipoBadge({
  tipo,
}: {
  tipo: string;
}) {
  let background = "#fff0bf";
  let color = "#946200";

  if (tipo === "RECUSA_TOTAL") {
    background = "#fee4e2";
    color = "#b42318";
  } else if (tipo === "TROCA") {
    background = "#dff4fb";
    color = "#087ca4";
  } else if (tipo === "CANCELAMENTO") {
    background = "#edf0f2";
    color = "#667085";
  }

  return (
    <span
      style={{
        display: "inline-flex",
        alignItems: "center",
        justifyContent: "center",
        minHeight: 23,
        padding: "0 9px",
        borderRadius: 13,
        fontSize: 9,
        fontWeight: 900,
        whiteSpace: "nowrap",
        background,
        color,
      }}
    >
      {tipoNome[tipo] ?? tipo}
    </span>
  );
}

/* =========================================================
   STATUS
========================================================= */

function StatusBadge({
  status,
}: {
  status: StatusRetorno;
}) {
  let background = "#fff0bf";
  let color = "#946200";

  if (
    [
      "EM_TRANSITO_CD",
      "AGUARDANDO_CONFERENCIA",
      "EM_CONFERENCIA",
    ].includes(status)
  ) {
    background = "#dff4fb";
    color = "#087ca4";
  }

  if (
    ["RECEBIDO", "FINALIZADO"].includes(status)
  ) {
    background = "#dcf4e8";
    color = "#067647";
  }

  return (
    <span
      style={{
        display: "inline-flex",
        alignItems: "center",
        justifyContent: "center",
        minHeight: 23,
        padding: "0 10px",
        borderRadius: 13,
        fontSize: 9,
        fontWeight: 900,
        whiteSpace: "nowrap",
        background,
        color,
      }}
    >
      {statusNome[status]}
    </span>
  );
}

/* =========================================================
   TIMELINE
========================================================= */

function TimelineStep({
  numero,
  titulo,
  subtitulo,
  estado,
}: {
  numero: string;
  titulo: string;
  subtitulo: string;
  estado: "concluido" | "atual" | "pendente";
}) {
  const concluido = estado === "concluido";
  const atual = estado === "atual";

  const background = concluido
    ? "#27a36a"
    : atual
    ? "#1593b7"
    : "#d5dde1";

  return (
    <div
      style={{
        width: 132,
        display: "flex",
        flexDirection: "column",
        alignItems: "center",
        textAlign: "center",
        flexShrink: 0,
      }}
    >
      <div
        style={{
          width: 32,
          height: 32,
          borderRadius: "50%",
          background,
          color: concluido || atual ? "#fff" : "#8a959e",
          display: "flex",
          alignItems: "center",
          justifyContent: "center",
          fontSize: 11,
          fontWeight: 900,
          boxShadow: atual
            ? "0 0 0 4px #e2f5fb"
            : concluido
            ? "0 0 0 3px #e8f7ef"
            : "none",
        }}
      >
        {numero}
      </div>

      <div
        style={{
          marginTop: 7,
          color: concluido
            ? "#067647"
            : atual
            ? "#087ca4"
            : "#8a959e",
          fontSize: 10,
          fontWeight: 900,
          whiteSpace: "nowrap",
        }}
      >
        {titulo}
      </div>

      <div
        style={{
          marginTop: 3,
          color: atual ? "#475467" : "#98a2b3",
          fontSize: 8,
          fontWeight: atual ? 700 : 500,
          lineHeight: 1.25,
          minHeight: 20,
        }}
      >
        {subtitulo}
      </div>

      {atual && (
        <div
          style={{
            marginTop: 5,
            padding: "3px 7px",
            borderRadius: 10,
            background: "#e2f5fb",
            color: "#087ca4",
            fontSize: 7,
            fontWeight: 900,
          }}
        >
          ETAPA ATUAL
        </div>
      )}
    </div>
  );
}

function TimelineLine({
  ativo,
}: {
  ativo: boolean;
}) {
  return (
    <div
      style={{
        height: 2,
        flex: 1,
        minWidth: 35,
        marginTop: 15,
        background: ativo ? "#27a36a" : "#d5dde1",
      }}
    />
  );
}

/* =========================================================
   STATUS / ETAPA
========================================================= */

function nivelStatus(
  status: StatusRetorno
) {
  switch (status) {
    case "AGUARDANDO_RETORNO":
    case "COM_TECNICO":
      return 2;

    case "EM_TRANSITO_CD":
      return 3;

    case "AGUARDANDO_CONFERENCIA":
    case "EM_CONFERENCIA":
      return 4;

    case "RECEBIDO":
    case "FINALIZADO":
      return 5;

    default:
      return 2;
  }
}

function textoEtapaAtual(
  status: StatusRetorno
) {
  switch (status) {
    case "AGUARDANDO_RETORNO":
    case "COM_TECNICO":
      return "Aguardando envio ao CD";

    case "EM_TRANSITO_CD":
      return "Material em trânsito para o CD";

    case "AGUARDANDO_CONFERENCIA":
      return "Aguardando recebimento no CD";

    case "EM_CONFERENCIA":
      return "Conferência do retorno em andamento";

    case "RECEBIDO":
    case "FINALIZADO":
      return "Retorno finalizado";

    default:
      return statusNome[status];
  }
}

function descricaoEtapaAtual(
  retorno: RetornoDevolucao
) {
  switch (retorno.status) {
    case "AGUARDANDO_RETORNO":
    case "COM_TECNICO":
      return `${retorno.codigo} permanece sob custódia de ${retorno.tecnico}. Este retorno foi originado pela ${retorno.documentoOrigem}. Confirme o envio somente quando o material for efetivamente despachado para ${retorno.destinoFisico}.`;

    case "EM_TRANSITO_CD":
      return `${retorno.codigo}, originado pela ${retorno.documentoOrigem}, está retornando para ${retorno.destinoFisico}. O próximo passo é o recebimento físico pelo coletor.`;

    case "AGUARDANDO_CONFERENCIA":
      return `${retorno.codigo} chegou ao CD e aguarda leitura e conferência física pelo coletor.`;

    case "EM_CONFERENCIA":
      return `O CD está conferindo quantidade, serial e condição dos materiais do ${retorno.codigo}.`;

    case "RECEBIDO":
    case "FINALIZADO":
      return `${retorno.codigo} foi recebido e o destino do estoque foi definido conforme a conferência.`;

    default:
      return "";
  }
}
