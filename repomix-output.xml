                {/* VOLUME ABERTO */}

                {volumeAtual && (
                  <>

                    {!todosVolumados && (
                      <button
                        type="button"
                        onClick={
                          adicionarTodosAoVolume
                        }
                        style={{
                          width:
                            "100%",
                          height:
                            40,
                          marginTop:
                            7,
                          border:
                            "1px solid #168bb2",
                          borderRadius:
                            6,
                          background:
                            "#fff",
                          color:
                            "#087da7",
                          fontSize:
                            10,
                          fontWeight:
                            800,
                          cursor:
                            "pointer",
                        }}
                      >
                        ADICIONAR TODOS OS
                        SALDOS
                      </button>
                    )}

                    <button
                      type="button"
                      className="collector-confirm-item"
                      style={{
                        width:
                          "100%",
                        minHeight:
                          44,
                        marginTop:
                          7,
                      }}
                      onClick={
                        concluirVolume
                      }
                    >
                      FECHAR{" "}
                      {
                        volumeAtual.codigo
                      }
                    </button>

                  </>
                )}

                {mensagem && (
                  <div
                    className="collector-message"
                    style={{
                      marginTop: 10,
                    }}
                  >
                    {mensagem}
                  </div>
                )}

              </section>

            </div>

            {/* =============================================
                RODAPÉ VOLUME
            ============================================= */}

            <div
              style={{
                padding:
                  "10px 12px",
                background:
                  "#f4f4f4",
              }}
            >

              <button
                type="button"
                className="collector-next"
                style={{
                  width: "100%",
                  minHeight: 48,
                  opacity:
                    todosConferidos &&
                    todosVolumados &&
                    volumesFechados
                      ? 1
                      : 0.4,
                }}
                disabled={
                  !todosConferidos ||
                  !todosVolumados ||
                  !volumesFechados ||
                  finalizando
                }
                onClick={
                  concluirConferencia
                }
              >
                {finalizando
                  ? "FINALIZANDO..."
                  : "FINALIZAR CONFERÊNCIA"}
              </button>

            </div>

          </>
        )}

      </div>
    </div>
  );
}
